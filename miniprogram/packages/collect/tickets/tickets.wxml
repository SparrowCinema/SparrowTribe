<page-meta page-style="{{ps}}" />
<wxs src="../../../utils/l.wxs" module="L" />
<view class="wrap album tk-page">
  <view class="tk-head">
    <text class="tk-heading">{{L.t(i,mode==='pending'?'待制作的票根':mode==='search'?'制作票根':'我的典藏票根册')}}</text>
    <text wx:if="{{mode==='album'}}" class="tk-link" bindtap="start" role="button">＋ {{L.t(i,'制作票根')}}</text>
    <text wx:else class="tk-link" bindtap="backAlbum" role="button">‹ {{L.t(i,'返回收藏册')}}</text>
  </view>

  <block wx:if="{{mode==='album'}}">
    <block wx:if="{{all}}">
      <view class="wall-filters" aria-label="{{L.t(i,'票根筛选')}}">
        <view class="wall-filter {{activeN||text?'active':''}}" bindtap="toggleFacets" role="button"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'筛选')}}</text><text class="wall-value">{{filterLabel}}</text></view><text class="wall-chevron">⌄</text></view>
        <picker class="wall-picker" range="{{yearLabels}}" value="{{yearIndex}}" bindchange="pickYearIdx"><view class="wall-filter {{yearIndex?'active':''}}"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'年份')}}</text><text class="wall-value">{{yearLabels[yearIndex]}}</text></view><text class="wall-chevron">⌄</text></view></picker>
        <picker class="wall-picker" range="{{densLabels}}" value="{{densIndex}}" bindchange="pickDens"><view class="wall-filter"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'显示')}}</text><text class="wall-value">{{densLabels[densIndex]}}</text></view><text class="wall-chevron">⌄</text></view></picker>
        <picker class="wall-picker" range="{{artStyleLabels}}" value="{{artStyleIndex}}" bindchange="pickArtStyle"><view class="wall-filter"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'手绘风格')}}</text><text class="wall-value">{{artStyleLabels[artStyleIndex]}}</text></view><text class="wall-chevron">⌄</text></view></picker>
      </view>
      <view class="wall-toolbar">
        <text class="wall-count">{{total===all?total+' '+L.t(i,'张票根'):total+' / '+all+' '+L.t(i,'张票根')}}{{i.__en?', ':'，'}}{{L.t(i,'按观影日期排列')}}</text>
        <view class="wall-score {{!front?'on':''}}" bindtap="flipWall" role="checkbox" aria-checked="{{!front}}"><text class="wall-check">{{front?'':'✓'}}</text>{{L.t(i,'看背面')}}</view>
        <button class="wall-export" bindtap="toggleExport">{{L.t(i,'导出票根墙')}}</button>
      </view>
    </block>
    <view wx:if="{{sum.pending}}" class="tk-todo">
      <text><text class="tk-b">{{sum.pending}}</text> {{L.t(i,'部电影还没做成票根')}}</text>
      <view class="tk-todo-a"><text class="tk-link" bindtap="makeAll" role="button">{{L.t(i,'一键生成')}}</text><text class="tk-dot">·</text><text class="tk-link" bindtap="openPending" role="button">{{L.t(i,'逐张挑选')}} ›</text></view>
    </view>
    <view wx:if="{{chips.length}}" class="tk-chips"><view wx:for="{{chips}}" wx:key="v" class="tk-chip" data-k="{{item.k}}" data-v="{{item.v}}" bindtap="toggleFacet">{{item.v}} ×</view><text class="tk-link" bindtap="clearFacets">{{L.t(i,'清除筛选')}}</text></view>

    <view wx:if="{{!all}}" class="wall-empty"><text class="tk-heading">{{L.t(i,'还没有收藏票根')}}</text><text>{{L.t(i,'在影片页点「看过」盖章后，每部电影都可以做成一张票根；也可以直接搜索影片制作（会同时盖章）。')}}</text><view class="btn" bindtap="{{sum.pending?'makeAll':'start'}}">{{L.t(i,sum.pending?'一键生成':'制作票根')}}</view></view>
    <view wx:elif="{{!groups.length}}" class="wall-empty"><text>{{L.t(i,'所选条件下暂无票根')}}</text><view class="btn ghost" bindtap="clearAll">{{L.t(i,'清除筛选')}}</view></view>
    <view wx:else class="tk-list tk-d-{{density}}">
      <view wx:for="{{groups}}" wx:for-item="g" wx:for-index="gi" wx:key="id" class="tk-month">
        <view class="tk-mh"><text>{{g.title}}</text><text class="tk-mn">{{g.n}} {{L.t(i,'张票根')}}</text></view>
        <view class="tk-grid">
          <block wx:if="{{density==='spine'}}">
            <view wx:for="{{g.items}}" wx:key="k" class="tk-spine {{item.p?'picked':''}}" data-k="{{item.k}}" data-gi="{{gi}}" data-ii="{{index}}" bindtap="tapTicket" role="button" aria-label="{{item.t}}">
              <view class="tk-bar" style="background:{{item.sa}}"></view>
              <view class="tk-sc"><text class="tk-st">{{item.t}}</text><text class="tk-sm">{{item.m}}</text></view>
              <text class="tk-sd">{{item.d}}</text>
            </view>
          </block>
          <block wx:else>
            <view wx:for="{{g.items}}" wx:key="k" class="tk-tile {{item.p?'picked':''}}" data-k="{{item.k}}" data-gi="{{gi}}" data-ii="{{index}}" bindtap="tapTicket" role="button" aria-label="{{item.t}}">
              <image wx:if="{{item.img}}" class="tk-img" src="{{item.img}}" mode="widthFix" />
              <view wx:else class="tk-img tk-ph" style="background:{{item.sb}};border-color:{{item.sa}}"><text style="color:{{item.sa}}">{{item.t}}</text></view>
              <text wx:if="{{density==='l'}}" class="tk-cap">{{item.t}}</text>
            </view>
          </block>
        </view>
      </view>
      <view wx:if="{{more}}" class="wall-hint tk-more">{{L.t(i,'继续下滑加载更多')}} · {{shown}} / {{total}}</view>
    </view>
    <view wx:if="{{pick}}" class="tk-pickbar"><text>{{L.t(i,'已选')}} <text class="tk-b">{{pickN}}</text> / 24</text><text class="tk-link" bindtap="pickCancel">{{L.t(i,'取消')}}</text><button class="wall-export" disabled="{{!pickN || loading}}" bindtap="pickExport">{{L.t(i,'导出精选墙')}}</button></view>

    <view wx:if="{{facetsOpen}}" class="selector-mask" catchtap="toggleFacets" catchtouchmove="stopMove"><view class="selector-panel" catchtap="stopMove">
      <view class="selector-head"><text>{{L.t(i,'筛选票根')}}</text><view class="selector-close" bindtap="toggleFacets" role="button" aria-label="{{L.t(i,'关闭筛选')}}">×</view></view>
      <input class="selector-search" placeholder="{{L.t(i,'搜片名、导演、影院、专题')}}" value="{{text}}" bindinput="inputQuery" />
      <scroll-view scroll-y class="selector-results">
        <view wx:for="{{facets}}" wx:for-item="fc" wx:key="k" class="tk-facet"><text class="tk-fh">{{fc.label}}</text>
          <view class="tk-fwrap"><view wx:for="{{fc.items}}" wx:key="v" class="tk-chip {{item.on?'on':''}}" data-k="{{fc.k}}" data-v="{{item.v}}" bindtap="toggleFacet">{{item.v}} <text class="tk-n">{{item.c}}</text></view></view></view>
        <view wx:if="{{!facets.length}}" class="selector-empty">{{L.t(i,'票根还不多，暂时没有可筛选的项目')}}</view>
      </scroll-view>
      <view class="selector-foot"><text bindtap="clearFacets">{{L.t(i,'清除筛选')}}</text><view class="selector-done" bindtap="toggleFacets">{{L.t(i,'显示')}} {{total}} {{L.t(i,'张票根')}}</view></view>
    </view></view>

    <view wx:if="{{exportOpen}}" class="selector-mask" catchtap="toggleExport" catchtouchmove="stopMove"><view class="selector-panel" catchtap="stopMove">
      <view class="selector-head"><text>{{L.t(i,'导出票根墙')}}</text><view class="selector-close" bindtap="toggleExport" role="button" aria-label="{{L.t(i,'收起')}}">×</view></view>
      <view class="selector-option {{ex.kind==='current'?'selected':''}}" data-kind="current" bindtap="exKindTap" role="radio" aria-checked="{{ex.kind==='current'}}"><view class="selector-copy"><text>{{L.t(i,'当前结果')}}</text><text class="small muted">{{total}} {{L.t(i,'张票根')}}</text></view><text class="selector-check {{ex.kind==='current'?'on':''}}">{{ex.kind==='current'?'✓':''}}</text></view>
      <picker wx:if="{{ex.years.length}}" range="{{ex.years}}" value="{{ex.y}}" bindchange="exYear"><view class="selector-option {{ex.kind==='year'?'selected':''}}" role="radio"><view class="selector-copy"><text>{{L.t(i,'年度票根墙')}}</text><text class="small muted">{{ex.years[ex.y]}} ⌄</text></view><text class="selector-check {{ex.kind==='year'?'on':''}}">{{ex.kind==='year'?'✓':''}}</text></view></picker>
      <picker wx:if="{{ex.progs.length}}" range="{{ex.progs}}" value="{{ex.p}}" bindchange="exProg"><view class="selector-option {{ex.kind==='prog'?'selected':''}}" role="radio"><view class="selector-copy"><text>{{L.t(i,'专题票根墙')}}</text><text class="small muted">{{ex.progs[ex.p]}} ⌄</text></view><text class="selector-check {{ex.kind==='prog'?'on':''}}">{{ex.kind==='prog'?'✓':''}}</text></view></picker>
      <view class="selector-option {{ex.kind==='pick'?'selected':''}}" data-kind="pick" bindtap="exKindTap" role="radio"><view class="selector-copy"><text>{{L.t(i,'精选票根墙')}}</text><text class="small muted">{{L.t(i,'自己挑')}} ≤24 {{L.t(i,'张票根')}}</text></view><text class="selector-check {{ex.kind==='pick'?'on':''}}">{{ex.kind==='pick'?'✓':''}}</text></view>
      <picker wx:if="{{ex.parts.length && ex.kind!=='pick'}}" range="{{ex.parts}}" value="{{ex.part}}" bindchange="exPart"><view class="selector-option"><view class="selector-copy"><text>{{L.t(i,'分成')}} {{ex.parts.length}} {{L.t(i,'张图导出')}}</text><text class="small muted">{{ex.parts[ex.part]}} ⌄</text></view></view></picker>
      <view class="selector-foot"><text>{{L.t(i,front?'正面':'背面')}}</text><view class="selector-done {{loading || (ex.kind!=='pick' && !ex.n)?'off':''}}" bindtap="exGo">{{L.t(i,ex.kind==='pick'?'开始挑选':'生成图片')}}</view></view>
    </view></view>
  </block>

  <block wx:elif="{{mode==='pending'}}">
    <text class="wall-hint al-block">{{L.t(i,'每一次观影一张票根，重看同一部电影会多开一个盲盒。一键生成会把待制作的观影全部开成盲盒票根。')}}</text>
    <button wx:if="{{sum.pending}}" class="wall-export tk-make-all" bindtap="makeAll">{{L.t(i,'一键生成全部')}} {{sum.pending}} {{L.t(i,'张票根')}}</button>
    <text wx:else class="al-muted al-block">{{L.t(i,'所有观影都已经做成票根了。')}}</text>
    <view class="al-plist"><view wx:for="{{pending}}" wx:key="k" class="al-pend" data-k="{{item.k}}" bindtap="openPendingItem" aria-role="button">
      <image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFill" lazy-load /><view wx:else class="al-pimg"></view>
      <view class="al-pc"><text class="al-pt">{{item.t}}</text><text class="al-pm">{{item.m}}</text></view><text class="al-go">{{L.t(i,'制作')}} ›</text></view></view>
    <button wx:if="{{pendingMore>0}}" class="al-alt" bindtap="morePending">{{L.t(i,'显示更多')}}（{{pendingMore}}）</button>
  </block>

  <block wx:elif="{{mode==='search'}}">
    <view class="al-empty"><text>{{L.t(i,'搜索护照片库')}}</text><input type="text" value="{{query}}" bindinput="inputSearch" placeholder="{{L.t(i,'输入电影片名开始搜索。')}}" />
      <view wx:if="{{results.length}}" class="al-results"><view wx:for="{{results}}" wx:key="id" class="al-result" bindtap="openFilm" data-id="{{item.id}}" aria-role="button">
        <image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFill" lazy-load /><text>{{item.title}}</text></view></view>
      <text wx:elif="{{query}}">{{L.t(i,'没有匹配的影片')}}</text>
    </view>
  </block>

</view>
<canvas type="2d" id="ticket-export-canvas" class="al-export-canvas" />
<canvas type="2d" id="ticket-worker" class="al-export-canvas" />
