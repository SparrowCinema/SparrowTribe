<page-meta page-style="{{ps}}" />
<wxs src="../../../utils/l.wxs" module="L" />
<view class="wrap ch-wrap {{full ? 'ch-full' : ''}}">
  <block wx:if="{{!full}}">
    <view class="ch-head">
      <text class="ch-k mono">CHECK-IN HOST · MINI PROGRAM</text>
      <text class="h1 ch-h1">{{L.t(i,'现场认证 · 主办方')}}</text>
      <text class="ch-sub">{{L.t(i,'生成动态微信小程序码，观众用微信「扫一扫」直接进小程序完成现场认证。')}}</text>
    </view>

    <view class="card ch-form">
      <view class="ch-field">
        <view class="ch-flab">
          <text>{{L.t(i,'主办密钥')}}</text>
          <view class="ch-fops">
            <text class="ch-clr" bindtap="pastePin">{{L.t(i,'粘贴')}}</text>
            <text wx:if="{{pin}}" class="ch-clr" bindtap="toggleHidePin">{{hidePin ? L.t(i,'显示') : L.t(i,'隐藏')}}</text>
            <text wx:if="{{pin}}" class="ch-clr" bindtap="clearPin">{{L.t(i,'清除')}}</text>
          </view>
        </view>
        <input class="ch-inp" type="text" password="{{hidePin}}" value="{{pin}}" placeholder="{{L.t(i,'输入或粘贴主办密钥')}}" bindinput="onPinInput" bindblur="onPinCommit" bindconfirm="onPinCommit" />
      </view>

      <view class="ch-field">
        <view class="ch-flab">
          <text>{{L.t(i,'放映场次')}}</text>
          <text class="ch-clr" bindtap="toggleShowAll">{{showAll ? L.t(i,'只看近 14 小时') : L.t(i,'显示全部待映')}}</text>
        </view>
        <picker wx:if="{{labels.length}}" mode="selector" range="{{labels}}" value="{{pickIdx >= 0 ? pickIdx : 0}}" bindchange="pickShow">
          <view class="ch-pick {{cur ? '' : 'ph'}}">
            <text class="ch-pick-t">{{cur ? cur.shortLine : L.t(i,'选择一场放映')}}</text>
            <text class="ch-pick-a">▾</text>
          </view>
        </picker>
        <text wx:else class="ch-empty">{{showAll ? L.t(i,'暂无待映场次。') : L.t(i,'前后 14 小时内没有场次，可点右上角切换「显示全部待映」。')}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{err}}" class="card ch-err-card">
    <text class="ch-err-t">{{err}}</text>
    <view class="btn ghost ch-smbtn" bindtap="tapRefresh">{{L.t(i,'重试')}}</view>
  </view>

  <view wx:if="{{cur && pin}}" class="card ch-stage {{full ? 'ch-stage-full' : ''}}">
    <view wx:if="{{env !== 'release'}}" class="ch-env mono">{{env === 'trial' ? L.t(i,'体验版小程序码') : L.t(i,'开发版小程序码')}}</view>
    <view class="ch-qr-box">
      <image wx:if="{{qr}}" class="ch-qr" src="{{qr}}" mode="aspectFit" />
      <text wx:else class="ch-qr-wait">{{loading ? L.t(i,'正在生成小程序签到码…') : L.t(i,'等待生成签到码')}}</text>
    </view>
    <view class="ch-title">{{cur.cn}}<text wx:if="{{cur.version}}" class="ed">{{cur.version}}</text></view>
    <text class="ch-meta mono">{{cur.time}}</text>
    <text class="ch-meta">{{cur.place}}</text>
    <text class="ch-tip">{{L.t(i,'微信「扫一扫」直接进入小程序完成现场认证')}}</text>
    <view class="ch-stat">
      <text>{{L.t(i,'已签到')}} </text>
      <text class="ch-num mono">{{count}}</text>
      <text>{{i.__en ? '' : ' 人'}} · {{L.t(i,'签到码每分钟更新')}}</text>
    </view>
    <text wx:if="{{updated}}" class="ch-upd mono">{{L.t(i,'更新于')}} {{updated}}</text>
    <view class="ch-acts">
      <view class="btn ch-act" bindtap="toggleFull">{{full ? L.t(i,'退出全屏') : L.t(i,'全屏投屏')}}</view>
      <view class="btn ghost ch-act" bindtap="tapRefresh">{{L.t(i,'立即刷新')}}</view>
    </view>
  </view>

  <view wx:if="{{!full && cur && pin && (agReady || agLoading || agErr)}}" class="card ch-ag">
    <view class="ch-ag-head">
      <text class="ch-ag-h">{{L.t(i,'映后嘉宾签名')}}</text>
      <text class="ch-ag-sub">{{L.t(i,'只有在这一场现场认证过的典藏票根才会出现嘉宾签名。每场最多 4 位。')}}</text>
    </view>

    <view wx:if="{{agErr}}" class="ch-ag-err">
      <text class="ch-ag-err-t">{{agErr}}</text>
      <view class="btn ghost ch-smbtn" bindtap="retryAutographs">{{L.t(i,'重试')}}</view>
    </view>
    <text wx:elif="{{agLoading && !agReady}}" class="ch-ag-wait">{{L.t(i,'正在读取本场主创签名…')}}</text>

    <block wx:if="{{agReady}}">
      <view wx:if="{{agList.length}}" class="ch-ag-list">
        <view wx:for="{{agList}}" wx:key="i" class="ch-ag-item">
          <image wx:if="{{item.img}}" class="ch-ag-img" src="{{item.img}}" mode="aspectFit" />
          <view class="ch-ag-meta">
            <text class="ch-ag-who">{{item.label}}</text>
            <text class="ch-ag-del" data-idx="{{item.i}}" bindtap="agDelete">{{L.t(i,'删除')}}</text>
          </view>
        </view>
      </view>

      <text wx:if="{{agFree < 0}}" class="ch-ag-full">{{L.t(i,'已满 4 位嘉宾。')}}</text>
      <block wx:else>
        <view class="ch-ag-inputs">
          <view class="ch-field">
            <text class="ch-flab">{{L.t(i,'嘉宾姓名')}}</text>
            <input class="ch-inp" maxlength="24" value="{{agName}}" placeholder="{{L.t(i,'填写嘉宾姓名')}}" bindinput="onAgName" />
          </view>
          <view class="ch-field">
            <text class="ch-flab">{{L.t(i,'身份')}}</text>
            <input class="ch-inp" maxlength="12" value="{{agRole}}" placeholder="{{L.t(i,'如：导演')}}" bindinput="onAgRole" />
          </view>
        </view>

        <view class="ch-ag-pad-wrap">
          <canvas type="2d" id="ch-ag-pad" class="ch-ag-pad" disable-scroll="true" bindtouchstart="agStart" bindtouchmove="agMove" bindtouchend="agEnd" bindtouchcancel="agEnd" />
          <text wx:if="{{!agHasInk}}" class="ch-ag-hint">{{L.t(i,'请嘉宾在这里签名')}}</text>
        </view>

        <view class="ch-ag-up">
          <view class="btn ghost ch-ag-upbtn" bindtap="agPickPhoto">{{L.t(i,'上传签名照片')}}</view>
          <view wx:if="{{agHasPhoto}}" class="ch-ag-shade">
            <text class="ch-ag-shlab">{{L.t(i,'深浅')}}</text>
            <slider class="ch-ag-slider" min="-60" max="60" step="5" value="{{agShade}}" block-size="18" activeColor="#8e2a22" bindchanging="agShadeChange" bindchange="agShadeChange" />
          </view>
          <text class="ch-ag-note">{{L.t(i,'请只上传嘉宾本人为这一场签的签名，并事先告知会用于观众的电子票根。照片只在本机识别，不会上传，只保存描出的笔画。')}}</text>
        </view>

        <view class="ch-acts">
          <view class="btn ghost ch-ag-sm" bindtap="agUndo">{{L.t(i,'撤销')}}</view>
          <view class="btn ghost ch-ag-sm" bindtap="agClear">{{L.t(i,'清除')}}</view>
          <view class="btn ch-act {{agSaving?'ch-dis':''}}" bindtap="agSave">{{agSaving ? L.t(i,'保存中…') : L.t(i,'保存签名')}}</view>
        </view>
      </block>
    </block>
  </view>
</view>
<canvas type="2d" id="ch-ag-work" class="ch-hidden" />
