<page-meta page-style="{{ps}}" />
<wxs src="../../../utils/l.wxs" module="L" />
<wxs src="./turn.wxs" module="T" />
<view wx:if="{{ok}}" class="wrap te-page">
  <view class="te-stage">
    <!-- 360° 转动：左右随便转、上下最多 65°，松手转回最近的正面或背面，轻点翻面（turn.wxs 在视图层跟手） -->
    <view id="te-card" class="te-card3d {{revealing?'te-reveal':''}}" data-shine="{{shine}}" data-fx="{{fx}}" turn="{{turnReq}}" change:turn="{{T.request}}" tilt="{{tiltReq}}" change:tilt="{{T.tilt}}"
      bindtouchstart="{{T.start}}" catchtouchmove="{{T.move}}" bindtouchend="{{T.end}}" bindtouchcancel="{{T.end}}"
      aria-role="button" aria-label="{{L.t(i,'翻面')}}">
      <view class="te-rot" style="--edge:{{edge}}">
        <view class="te-side te-front">
          <image wx:if="{{frontImg}}" class="te-face" src="{{frontImg}}" mode="scaleToFill" />
          <view wx:else class="te-face te-wait"><text>{{L.t(i,'票根绘制中…')}}</text></view>
          <view class="te-glow"></view>
          <view wx:for="{{layersF}}" wx:key="i" class="te-fx fx-{{item.fx}}" data-fx="{{item.fx}}" data-k="{{item.k}}" style="-webkit-mask-image:url({{item.m}});mask-image:url({{item.m}})"></view>
        </view>
        <view class="te-side te-back">
          <image wx:if="{{backImg}}" class="te-face" src="{{backImg}}" mode="scaleToFill" />
          <view wx:else class="te-face te-wait"><text>{{L.t(i,'票根绘制中…')}}</text></view>
          <view class="te-glow"></view>
          <view wx:for="{{layersB}}" wx:key="i" class="te-fx fx-{{item.fx}}" data-fx="{{item.fx}}" data-k="{{item.k}}" style="-webkit-mask-image:url({{item.m}});mask-image:url({{item.m}})"></view>
        </view>
        <view class="te-edge te-l1"></view><view class="te-edge te-l2"></view>
        <view class="te-edge te-r1"></view><view class="te-edge te-r2"></view>
      </view>
    </view>
    <view wx:if="{{arts.length}}" class="te-art">
      <text class="te-art-k">{{L.t(i,'裁切')}}</text>
      <slider class="te-slider" min="0" max="100" value="{{draft.crop}}" block-size="18" activeColor="#8e2a22" backgroundColor="#e6dcc7" bindchanging="changeField" bindchange="changeField" data-field="crop" />
      <view class="te-art-save {{artDirty?'':'off'}}" hover-class="{{artDirty?'te-hv':'none'}}" bindtap="saveHere" role="button" aria-disabled="{{!artDirty}}">{{L.t(i,'保存')}}</view>
    </view>
    <view class="te-tools">
      <!-- 正面 / 背面：轻点票根翻面、拖动 360° 转动已经够用，这里换成票面图像（2026-11-23） -->
      <picker wx:if="{{arts.length>1}}" mode="selector" range="{{arts}}" value="{{artIndex}}" bindchange="chooseArt">
        <view class="te-style" hover-class="te-hv" role="button">{{L.t(i,'票面图像')}}<text class="te-style-chevron" aria-hidden="true">⌄</text></view>
      </picker>
      <view wx:elif="{{arts.length}}" class="te-style" hover-class="te-hv" role="button" bindtap="artOnly">{{L.t(i,'票面图像')}}<text class="te-style-chevron" aria-hidden="true">⌄</text></view>
      <picker mode="selector" range="{{artStyleLabels}}" value="{{artStyleIndex}}" bindchange="pickArtStyle">
        <view class="te-style" hover-class="te-hv" role="button">{{L.t(i,'手绘风格')}}<text class="te-style-chevron" aria-hidden="true">⌄</text></view>
      </picker>
    </view>
    <view wx:if="{{craftChips.length}}" class="te-craft">
      <view class="te-craft-chips">
        <text wx:for="{{craftChips}}" wx:key="t" class="te-craft-chip k-{{item.k}}">{{item.t}}</text>
      </view>
      <text class="te-craft-tip">{{L.t(i,'转动或晃动票根可看隐形工艺与烫印流光')}}</text>
    </view>
    <text wx:if="{{custom}}" class="te-reset" bindtap="reset" role="button">{{L.t(i,'恢复盲盒款')}}</text>
  </view>

  <view class="te-heading">
    <view class="te-title"><text class="te-name">{{draft.title}}</text><text wx:if="{{draft.programme}}" class="te-sub">{{draft.programme}}</text></view>
    <view class="te-actions">
      <button class="te-action te-action-export" hover-class="te-hv" bindtap="exportSingle" disabled="{{loading}}" aria-label="{{L.t(i,'导出这张票根')}}">{{L.t(i,'导出')}}</button>
      <button wx:if="{{existing}}" class="te-action te-action-remove" hover-class="te-hv" bindtap="remove">{{L.t(i,'移出收藏册')}}</button>
    </view>
  </view>

  <view class="te-sec-row">
    <text class="te-sec">{{L.t(i,'放映信息')}}</text>
    <view class="te-ocr-btns">
      <view class="te-ocr-btn {{ocrBusy?'busy':''}}" hover-class="te-hv" data-mode="wx" bindtap="scanTicket" role="button">{{ocrBusy && ocrMode!=='ai' ? L.t(i,'识票中…') : L.t(i,'拍照识票')}}</view>
      <view class="te-ocr-btn te-ocr-ai {{ocrBusy?'busy':''}}" hover-class="te-hv" data-mode="ai" bindtap="scanTicket" role="button">{{ocrBusy && ocrMode==='ai' ? L.t(i,'识票中…') : L.t(i,'AI 识票')}}</view>
    </view>
  </view>
  <view wx:if="{{ocrMsg}}" class="te-ocr-status {{ocrTone}}">
    <text>{{ocrMsg}}</text>
    <text wx:if="{{ocrCanRetryAi && !ocrBusy}}" class="te-ocr-retry" bindtap="retryAiScan" role="button">{{L.t(i,'用 AI 重新识别')}}</text>
  </view>
  <view class="te-card">
    <picker wx:if="{{shows.length}}" mode="selector" range="{{shows}}" value="{{showIdx<0?0:showIdx}}" bindchange="chooseShow"><view class="te-row te-first"><text class="te-k">{{L.t(i,'场次')}}</text><view class="te-v"><text class="{{showIdx<0?'te-ph':''}}">{{showIdx<0?L.t(i,'选择场次'):shows[showIdx]}}</text><text class="te-go">›</text></view></view></picker>
    <view wx:if="{{linked}}" class="te-row {{shows.length?'':'te-first'}}"><text class="te-k">{{L.t(i,'观影日期')}}</text><view class="te-v"><text class="te-mono">{{draft.date}}</text><text class="te-note">{{L.t(i,'来自观影记录')}}</text></view></view>
    <picker wx:else mode="date" value="{{draft.date}}" data-field="date" bindchange="changeField"><view class="te-row {{shows.length?'':'te-first'}}"><text class="te-k">{{L.t(i,'观影日期')}}</text><view class="te-v"><text class="te-mono">{{draft.date || L.t(i,'选择日期')}}</text><text class="te-go">›</text></view></view></picker>
    <picker mode="time" value="{{draft.time}}" data-field="time" bindchange="changeField"><view class="te-row"><text class="te-k">{{L.t(i,'开场时间')}}</text><view class="te-v"><text class="te-mono {{draft.time?'':'te-ph'}}">{{draft.time || L.t(i,'选择时间')}}</text><text class="te-go">›</text></view></view></picker>
    <view class="te-row"><text class="te-k">{{L.t(i,'影院')}}</text><input class="te-in" value="{{draft.venue}}" placeholder="{{L.t(i,'影院名称')}}" placeholder-class="te-ph" data-field="venue" bindinput="changeField" /></view>
    <view class="te-row"><text class="te-k">{{L.t(i,'影厅')}}</text><input class="te-in" value="{{draft.hall}}" placeholder="{{L.t(i,'如 1号厅')}}" placeholder-class="te-ph" data-field="hall" bindinput="changeField" /></view>
    <view class="te-row"><text class="te-k">{{L.t(i,'座位')}}</text><input class="te-in" value="{{draft.seat}}" placeholder="{{L.t(i,'选填，如 5排8座')}}" placeholder-class="te-ph" data-field="seat" bindinput="changeField" /></view>
    <view class="te-row"><text class="te-k">{{L.t(i,'放映版本')}}</text><input class="te-in" value="{{draft.format}}" placeholder="{{L.t(i,'如 4K修复')}}" placeholder-class="te-ph" data-field="format" bindinput="changeField" /></view>
  </view>

  <view class="te-acts">
    <view class="te-save" hover-class="te-hv" bindtap="store" role="button">{{L.t(i,existing?'保存修改':'加入收藏册')}}</view>
  </view>
</view>
<canvas type="2d" id="te-worker" class="te-hidden" />
<canvas type="2d" id="te-export" class="te-hidden" />
