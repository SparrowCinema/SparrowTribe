// 票根 360° 转动（WXS 在视图层直接改样式，手指每一帧都不经过 setData，所以跟手不卡）
// 左右随便转；上下最多倾斜 65°；松手按甩动速度带一点惯性，再慢慢转回最近的正面或背面；轻点翻面。
// 高光跟着角度走：正对时不亮，越斜反光越往一边移；只在拖动时出现，停下淡出。
// 2026-11-22 起另有工艺反光层 .te-fx（镭射流动、金属光带、闪粉、立体光油……），只在工艺遮罩范围里显示。
// 与网页 js/tickets.js 的 ticketTurner 规则一致，改这里记得同步那边。
var REST_X = -2, REST_Y = -4, DEG_X = 0.45, DEG_Y = 0.35, TILT = 65;
var EASE = 'cubic-bezier(.18,.8,.25,1)';

function now() { return getDate().getTime(); }
function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
function state(ins) {
  var s = ins.getState();
  if (s.ry === undefined) { s.ry = REST_Y; s.rx = REST_X; s.kind = 'metal'; s.fx = 'none'; }
  return s;
}
function faceIndex(ry) { return Math.round((ry - REST_Y) / 180); }
function sideOf(ry) { var k = faceIndex(ry) % 2; return (k + 2) % 2 ? 'back' : 'front'; }

function glow(rx, ry, kind) {
  var rel = (ry - REST_Y - faceIndex(ry) * 180) * Math.PI / 180, tilt = (rx - REST_X) * Math.PI / 180;
  var at = 'circle at ' + Math.round(50 + Math.sin(rel) * 90) + '% ' + Math.round(32 - Math.sin(tilt) * 90) + '%';
  if (kind === 'spectrum') return 'radial-gradient(' + at + ',rgba(255,255,255,.11),rgba(255,170,235,.06) 24%,rgba(130,225,255,.04) 40%,rgba(255,240,170,.02) 54%,rgba(255,255,255,0) 66%)';
  if (kind === 'soft') return 'radial-gradient(' + at + ',rgba(255,255,255,.035),rgba(255,255,255,0) 55%)';
  return 'radial-gradient(' + at + ',rgba(255,255,255,.09),rgba(255,255,255,0) 50%)';
}

// 工艺反光（与网页 js/tickets.js 的 ticketFxStyle 一致）：只在工艺遮罩范围里，按角度移动背景；越斜越明显，松手淡出
function pct(v) { return Math.round(v) + '%'; }
function fxStyle(fx, a, b, lit) {
  var o = lit ? Math.min(1, Math.abs(a) * 3 + Math.abs(b) * 2) : 0, pos = '50% 50%', peak = 0;
  if (fx === 'holo') { pos = pct(50 + a * 60) + ' ' + pct(50 + b * 60); peak = 0.6; }
  else if (fx === 'holo-aurora') { pos = pct(50 + a * 65) + ' ' + pct(50 + b * 55); peak = 0.64; }
  else if (fx === 'holo-prism') { pos = pct(50 + a * 70) + ' ' + pct(50 + b * 60); peak = 0.7; }
  else if (fx === 'holo-solar') { pos = pct(50 + a * 60) + ' ' + pct(50 + b * 55); peak = 0.66; }
  else if (fx === 'holo-opal') { pos = pct(50 + a * 55) + ' ' + pct(50 + b * 65); peak = 0.62; }
  else if (fx === 'holo-cobalt') { pos = pct(50 + a * 65) + ' ' + pct(50 + b * 55); peak = 0.66; }
  else if (fx === 'holo-unique') { pos = pct(50 + a * 72) + ' ' + pct(50 + b * 64); peak = 0.72; }
  else if (fx === 'cast') { pos = pct(50 - a * 45) + ' ' + pct(50 - b * 45) + ', ' + pct(50 + a * 60) + ' ' + pct(50 + b * 60); peak = 0.75; }
  else if (fx === 'crystal') { pos = pct(50 + a * 70) + ' ' + pct(50 + b * 50) + ', ' + pct(50 - a * 60) + ' 0%'; peak = 0.75; }
  else if (fx === 'sweep') { pos = pct(50 - a * 60) + ' 0%'; peak = 0.9; }
  else if (fx === 'glitter') { pos = pct(50 - a * 60) + ' 0%, ' + pct(50 + a * 50) + ' 0%'; peak = 0.95; }
  else if (fx === 'gloss') { pos = pct(50 - a * 90) + ' ' + pct(50 + b * 90); peak = 0.75; }
  else if (fx === 'sense') { pos = pct(50 - a * 90) + ' ' + pct(50 + b * 90) + ', ' + pct(50 - a * 60) + ' 0%'; peak = 0.9; }
  else if (fx === 'blind') { pos = pct(50 - a * 75) + ' 0%'; peak = 0.72; }
  // 海报 / 背面的隐形工艺：静止时完全看不见，转动时浮现；2026-11-22 再调强并改用 hard-light（亮处、暗处都看得出）
  else if (fx === 'a-gloss') { pos = pct(50 - a * 90) + ' ' + pct(50 + b * 90); peak = 0.78; }
  else if (fx === 'a-rim') { pos = pct(50 - a * 90) + ' ' + pct(50 + b * 90); peak = 0.85; }
  else if (fx === 'a-holo') { pos = pct(50 + a * 60) + ' ' + pct(50 + b * 60); peak = 0.62; }
  else if (fx === 'a-pearl') { pos = pct(50 + a * 70) + ' ' + pct(50 + b * 70); peak = 0.7; }
  else if (fx === 'a-guilloche') { pos = pct(50 - a * 60) + ' 0%'; peak = 0.8; }
  else if (fx === 'a-rainbow') { pos = pct(50 + a * 80) + ' ' + pct(50 + b * 80); peak = 0.55; }
  else if (fx === 'a-cateye') { pos = pct(50 - a * 110) + ' 0%'; peak = 0.85; }
  else if (fx === 'a-matte') { pos = pct(50 - a * 90) + ' ' + pct(50 + b * 90); peak = 0.72; }
  return { pos: pos, o: Math.round(o * peak * 1000) / 1000 };
}

function paint(owner, s, ms, lit) {
  var rot = owner.selectComponent('.te-rot');
  if (!rot) return;
  rot.setStyle({
    transform: 'rotateX(' + s.rx + 'deg) rotateY(' + s.ry + 'deg)',
    transition: ms ? 'transform ' + ms + 'ms ' + EASE : 'none'
  });
  var style = {
    background: glow(s.rx, s.ry, s.kind),
    opacity: lit ? 1 : 0,
    transition: lit ? 'opacity 0.12s' : 'opacity ' + (ms || 350) + 'ms ease-out'
  };
  var glows = owner.selectAllComponents('.te-glow');
  for (var i = 0; i < glows.length; i++) glows[i].setStyle(style);
  var rel = (s.ry - REST_Y - faceIndex(s.ry) * 180) * Math.PI / 180, tilt = (s.rx - REST_X) * Math.PI / 180;
  // 每层用自己的工艺（data-fx）和强度（data-k）：底箔反光、烫印增效、海报画面增效
  var layers = owner.selectAllComponents('.te-fx');
  for (var j = 0; j < layers.length; j++) {
    var ds = layers[j].getDataset(), fx = fxStyle(ds.fx || s.fx, Math.sin(rel), Math.sin(tilt), lit);
    layers[j].setStyle({
      'background-position': fx.pos, opacity: Math.round(fx.o * (ds.k ? +ds.k : 1) * 1000) / 1000,
      transition: lit ? 'opacity 0.12s' : 'opacity ' + Math.max(ms || 0, 350) + 'ms ease-out'
    });
  }
}

function settle(owner, s, target) {
  var ms = Math.round(Math.min(900, 380 + Math.abs(target - s.ry) * 1.6));
  s.until = now() + ms + 60;
  s.ry = target; s.rx = REST_X;
  paint(owner, s, ms, false);
  owner.callMethod('turned', { front: sideOf(target) === 'front' });
}

function start(e, owner) {
  var t = e.touches && e.touches[0];
  if (!t) return;
  var s = state(e.instance), at = now();
  var ds = e.instance.getDataset();
  s.kind = ds.shine || s.kind; s.fx = ds.fx || s.fx;
  s.x0 = t.clientX; s.y0 = t.clientY; s.ry0 = s.ry; s.rx0 = s.rx; s.moved = false;
  s.samples = [{ t: at, ry: s.ry }];
}

function move(e, owner) {
  var t = e.touches && e.touches[0], s = state(e.instance);
  if (!t || s.x0 === undefined) return false;
  var dx = t.clientX - s.x0, dy = t.clientY - s.y0;
  if (!s.moved && Math.abs(dx) + Math.abs(dy) < 6) return false;
  s.moved = true;
  s.ry = s.ry0 + dx * DEG_X;
  s.rx = clamp(s.rx0 - dy * DEG_Y, -TILT, TILT);
  var at = now();
  s.samples.push({ t: at, ry: s.ry });
  while (s.samples.length > 2 && at - s.samples[0].t > 100) s.samples.shift();
  paint(owner, s, 0, true);
  return false;
}

function end(e, owner) {
  var s = state(e.instance);
  if (s.x0 === undefined) return;
  s.x0 = undefined;
  if (!s.moved) { settle(owner, s, (faceIndex(s.ry) + 1) * 180 + REST_Y); return; }
  var a = s.samples[0], b = s.samples[s.samples.length - 1], dt = b.t - a.t;
  var v = dt > 0 && now() - b.t < 80 ? (b.ry - a.ry) / dt : 0;
  var projected = s.ry + clamp(v * 250, -360, 360);
  settle(owner, s, faceIndex(projected) * 180 + REST_Y);
}

// 页面用 turnReq={side,n,kind} 请求转到某一面（正面 / 背面按钮、改裁切时回到正面）
function request(value, old, owner, ins) {
  if (!value) return;
  var s = state(ins);
  if (value.kind) s.kind = value.kind;
  if (value.fx) s.fx = value.fx;
  if (!value.n) { paint(owner, s, 0, false); return; }
  // 拆盲盒：先无动画地停在指定一面（背面），之后页面再请求转到正面
  if (value.snap) {
    s.ry = (value.side === 'back' ? 180 : 0) + REST_Y; s.rx = REST_X;
    paint(owner, s, 0, false);
    owner.callMethod('turned', { front: value.side !== 'back' });
    return;
  }
  if (sideOf(s.ry) === value.side) return;
  settle(owner, s, (faceIndex(s.ry) + 1) * 180 + REST_Y);
}

// 手机轻微倾斜时的陀螺仪微光（不抢手势、不影响翻面）
function tilt(value, old, owner, ins) {
  if (!value || !value.n) return;
  var s = state(ins);
  if (s.x0 !== undefined || (s.until && now() < s.until)) return;
  var base = faceIndex(s.ry) * 180 + REST_Y;
  s.ry = base + clamp(value.dy || 0, -10, 10);
  s.rx = REST_X + clamp(value.dx || 0, -8, 8);
  paint(owner, s, 110, !!value.lit);
}

module.exports = { start: start, move: move, end: end, request: request, tilt: tilt, sideOf: sideOf, glow: glow, fxStyle: fxStyle };
