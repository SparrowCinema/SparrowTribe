<page-meta page-style="{{ps}}" />
<wxs src="../../../utils/l.wxs" module="L" />
<wxs src="./ring.wxs" module="R" />
<view class="wrap wall-page">
 <view class="wall-heading">{{L.t(i,'我的影院观影海报墙')}}</view>
 <view class="wall-filters" aria-label="{{L.t(i,'海报墙筛选')}}">
  <view class="wall-filter {{programme!=='all'?'active':''}}" bindtap="openSelector" role="button" aria-label="{{L.t(i,'专题')}} · {{programmeLabel}}"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'专题')}}</text><text class="wall-value">{{programmeLabel}}</text></view><text class="wall-chevron">⌄</text></view>
  <picker class="wall-picker" range="{{modes}}" value="{{modeIndex}}" bindchange="setMode"><view class="wall-filter"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'海报墙')}}</text><text class="wall-value">{{modes[modeIndex]}}</text></view><text class="wall-chevron">⌄</text></view></picker>
  <picker class="wall-picker" range="{{periodLabels}}" value="{{periodIndex}}" bindchange="setPeriod" disabled="{{!periods.length}}"><view class="wall-filter"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'观影时间')}}</text><text class="wall-value">{{periodLabel || '—'}}</text></view><text class="wall-chevron">⌄</text></view></picker>
 </view>
 <view class="wall-toolbar"><text class="wall-count">{{L.n(i,items.length,'f')}}{{i.__en?', ':'，'}}{{L.t(i,'按最近观影排列')}}</text><view class="wall-score {{showScore?'on':''}}" bindtap="toggleScore" role="checkbox" aria-checked="{{showScore}}"><text class="wall-check">{{showScore?'✓':''}}</text>{{L.t(i,'导出时显示评分')}}</view><button class="wall-export" disabled="{{!items.length}}" bindtap="exportWall">{{L.t(i,'导出海报墙')}}</button></view>
 <view wx:if="{{items.length}}" class="pw-viewbar"><view class="pw-view-seg" role="radiogroup" aria-label="{{L.t(i,'海报墙视图')}}"><view class="pw-view-b {{view==='grid'?'on':''}}" data-v="grid" bindtap="setView" role="radio" aria-checked="{{view==='grid'}}">{{L.t(i,'网格')}}</view><view class="pw-view-b {{view==='ring'?'on':''}}" data-v="ring" bindtap="setView" role="radio" aria-checked="{{view==='ring'}}">{{L.t(i,'放映')}}</view></view></view>
 <!-- 「放映」视图：ring.wxs 在视图层跟手；近看＝档案，拉远＝放映环 -->
 <view wx:if="{{items.length && view==='ring' && ring}}" class="pr {{ring.far?'far':''}}">
  <view class="pr-info" wx:if="{{ring.info}}"><text class="pr-k">MY FILM ARCHIVE · {{L.t(i,'观影档案')}}</text><view class="pr-t">{{ring.info.title}}<text wx:if="{{ring.info.version}}" class="pr-ver">{{ring.info.version}}</text></view><text wx:if="{{ring.info.en}}" class="pr-o">{{ring.info.en}}</text>
   <view class="pr-dl"><view wx:for="{{ring.info.rows}}" wx:key="k" class="pr-row"><text class="pr-dt">{{item.k}}</text><text class="pr-dd">{{item.v}}</text></view></view>
   <view class="pr-me"><view class="wall-stars pr-stars"><view wx:for="{{ring.info.stars}}" wx:for-item="st" wx:key="index" class="ws"><text>★</text><view class="ws1" style="width:{{st}}%"><text>★</text></view></view></view><text wx:if="{{ring.info.r}}" class="pr-score">{{ring.info.r}}</text><text class="pr-of">{{ring.info.r?'/10':L.t(i,'未评分')}}</text></view>
   <text class="pr-seen">{{ring.info.seen}}</text></view>
  <view class="pr-stage" bindtouchstart="{{R.start}}" bindtouchmove="{{R.move}}" bindtouchend="{{R.end}}" bindtouchcancel="{{R.end}}" change:cfg="{{R.cfg}}" cfg="{{ringCfg}}" change:cmd="{{R.cmd}}" cmd="{{ringCmd}}">
   <view class="pr-world"><view wx:for="{{ring.slots}}" wx:key="index" class="pr-face" data-slot="{{index}}"><view class="pr-ph">{{item.title}}</view><image wx:if="{{item.poster}}" class="pr-img" src="{{item.poster}}" mode="aspectFill" data-slot="{{index}}" binderror="ringImgError" /><view class="pr-shade"></view></view></view>
  </view>
  <view class="pr-ctrl"><view class="pr-btn" data-a="prev" bindtap="ringBtn" role="button" aria-label="{{L.t(i,'上一部')}}">‹</view><text class="pr-pos">{{ring.pos}}</text><view class="pr-btn" data-a="next" bindtap="ringBtn" role="button" aria-label="{{L.t(i,'下一部')}}">›</view><view class="pr-zoom" data-a="zoom" bindtap="ringBtn" role="button">{{L.t(i,ring.far?'近看':'全景')}}</view></view>
  <view class="wall-hint pr-tip">{{L.t(i,ring.far?'点任意一张拉近查看':'左右拖动转动，点正面的海报查看影片')}}</view>
 </view>
 <block wx:if="{{items.length && view==='grid'}}"><view class="wall-hint">{{L.t(i,'点击海报查看影片，向下浏览更多。')}}</view>
 <view class="wall-grid" style="--cols:{{cols}}"><view wx:for="{{items}}" wx:key="id" class="wall-film" data-id="{{item.id}}" bindtap="openFilm" role="button" aria-label="{{item.title}} · {{L.t(i,'我的评分')}} {{item.score}}"><view class="wall-poster"><view class="wall-placeholder">{{item.title}}</view><image wx:if="{{item.poster}}" class="wall-image" src="{{item.poster}}" mode="aspectFill" lazy-load data-index="{{index}}" binderror="posterError" /></view><view class="wall-stars" role="img" aria-label="{{item.score}}"><view wx:for="{{item.stars}}" wx:for-item="st" wx:key="index" class="ws"><text>★</text><view class="ws1" style="width:{{st}}%"><text>★</text></view></view></view></view></view></block>
 <view wx:if="{{!items.length}}" class="wall-empty"><text class="wall-heading">{{L.t(i,programme==='all'?'海报墙还没有影片':'所选条件下暂无影片')}}</text><text>{{L.t(i,programme==='all'?'在影片页标记看过，海报和评分就会收进这里。':'试试其他专题或观影时间。')}}</text><view class="btn" bindtap="toFilms">{{L.t(i,'去选电影')}}</view></view>
 <view wx:if="{{selectorType}}" class="selector-mask" catchtap="closeSelector" catchtouchmove="stopMove"><view class="selector-panel" catchtap="stopMove"><view class="selector-head"><text>{{L.t(i,'选择专题')}}</text><view class="selector-close" bindtap="closeSelector" role="button" aria-label="{{L.t(i,'关闭筛选')}}">×</view></view><input class="selector-search" placeholder="{{L.t(i,'搜索专题')}}" value="{{selectorQuery}}" bindinput="searchSelector" /><scroll-view scroll-y class="selector-results"><view wx:for="{{selectorRows}}" wx:key="id" class="selector-option {{item.selected?'selected':''}}" data-id="{{item.id}}" bindtap="chooseProgramme" role="radio" aria-checked="{{item.selected}}"><view class="selector-copy"><text>{{item.name}}</text><text class="small muted">{{L.n(i,item.n,'f')}}</text></view><text class="selector-check {{item.selected?'on':''}}">{{item.selected?'✓':''}}</text></view><view wx:if="{{!selectorRows.length}}" class="selector-empty">{{L.t(i,'没有匹配的结果')}}</view></scroll-view></view></view>
</view>

<canvas type="2d" id="poster-wall-canvas" class="wall-canvas" />
