function cfg(value, old, owner, ins) {
  if (!value || !value.M) return;
  var s = st(ins);
  layout(owner, ins, s, value);
  apply(owner, s);
  owner.callMethod('ringFront', { p: s.front });
}
function cmd(value, old, owner, ins) {
