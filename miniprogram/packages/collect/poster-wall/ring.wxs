  var s = st(ins); if (!s.M) return;
  if (value.a === 'prev') stepBy(owner, ins, s, -1);
  else if (value.a === 'next') stepBy(owner, ins, s, 1);
  else if (value.a === 'zoom') zoom(owner, ins, s, s.tT < 0.5);
