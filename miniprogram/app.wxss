/* 单位：1 个 --r 相当于 1rpx。屏宽 ≤600px 时与 rpx 完全一致；折叠屏内屏 / iPad（>600px）固定按 414px 宽的手机比例，字号不再随屏宽放大。
   所有尺寸都写成 calc(N * var(--r))，不依赖 app.json 里的大屏设置（部分机型和模拟器不生效）。 */
page { --r: calc(100vw / 750); }
@media (min-width: 600px) { page { --r: 0.552px; } }
/* 色彩取自风格万相海报：海青、沙色、赭石、酒红 */
page {
  --bg: #efe6d4; --surface: #f8f2e6; --line: #d8cbb1; --line-soft: #e6dcc7;
  --fg: #2b2117; --muted: #7a6a55; --accent: #8e2a22; --teal: #2f6f6c; --ochre: #b26a1f; --chip: #e5d8bf;
  --float: rgba(248, 242, 230, .94); --bad-bg: #f3dcd6; --bad-fg: #c4372d; --ic-filter: none; --ic-bg: var(--bg);
  --barS: 36%; --barL: 85%; --lineL: 68%; --inkL: 22%;
  background: var(--bg); color: var(--fg);
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: calc(17.5 * var(--r)); line-height: 1.6;
}
.wrap { padding: 0 calc(32 * var(--r)) calc(48 * var(--r)); }
.mono { font-family: Menlo, "SF Mono", "Courier New", monospace; font-variant-numeric: tabular-nums; }
.h2 { font-size: calc(22.6 * var(--r)); font-weight: 900; margin: calc(32 * var(--r)) 0 calc(4 * var(--r)); }
.sub { font-size: calc(16 * var(--r)); color: var(--muted); margin-bottom: calc(24 * var(--r)); }
.blockh { display: flex; align-items: baseline; gap: calc(14 * var(--r)); font-size: calc(19.3 * var(--r)); font-weight: 900; margin: calc(48 * var(--r)) 0 calc(18 * var(--r)); }
.blockh .en { font-size: calc(16 * var(--r)); font-weight: 400; color: var(--muted); letter-spacing: calc(4 * var(--r)); }
.chips { display: flex; flex-wrap: nowrap; gap: calc(12 * var(--r)); white-space: nowrap; margin-bottom: calc(16 * var(--r)); }
.chip { display: inline-block; font-size: calc(16 * var(--r)); padding: calc(8 * var(--r)) calc(24 * var(--r)); border-radius: calc(99 * var(--r)); background: var(--chip); color: var(--fg); }
.chip.on { background: var(--fg); color: var(--bg); }
.ed { display: inline-block; font-family: Menlo, monospace; font-size: calc(16 * var(--r)); font-weight: 700; padding: 0 calc(10 * var(--r)); border-radius: calc(8 * var(--r)); border: calc(2 * var(--r)) solid var(--accent); color: var(--accent); line-height: 1.6; vertical-align: calc(4 * var(--r)); margin-left: calc(8 * var(--r)); }
.btn { display: inline-flex; align-items: center; justify-content: center; height: calc(72 * var(--r)); padding: 0 calc(28 * var(--r)); border-radius: calc(16 * var(--r)); font-size: calc(17.0 * var(--r)); font-weight: 700; background: var(--accent); color: #fffaf0; }
.btn.ghost { background: var(--surface); color: var(--fg); border: calc(2 * var(--r)) solid var(--line); }
.btn.on { background: transparent; color: var(--fg); border: calc(2 * var(--r)) solid var(--line); }
button.btn { margin: 0; line-height: calc(72 * var(--r)); }
button.btn::after { border: none; }
.card { background: var(--surface); border: calc(2 * var(--r)) solid var(--line-soft); border-radius: calc(24 * var(--r)); }
.muted { color: var(--muted); }
.note { font-size: calc(16 * var(--r)); color: var(--muted); line-height: 1.7; margin-top: calc(24 * var(--r)); }
/* 底部制作设计 */
.makers { margin-top: calc(64 * var(--r)); padding-top: calc(36 * var(--r)); border-top: calc(2 * var(--r)) solid var(--line-soft); display: flex; flex-direction: column; align-items: center; gap: calc(16 * var(--r)); }
.makers .k { font-family: Menlo, monospace; font-size: calc(16 * var(--r)); letter-spacing: calc(6 * var(--r)); color: var(--muted); }
.makers .row { display: flex; align-items: center; gap: calc(24 * var(--r)); }
.makers image { width: calc(110 * var(--r)); height: calc(110 * var(--r)); }
.makers .x { color: var(--muted); font-size: calc(16 * var(--r)); }
.makers .d { font-size: calc(16 * var(--r)); letter-spacing: calc(8 * var(--r)); color: var(--muted); }

/* 回到顶部 */
.to-top { box-sizing: border-box; flex: none; min-width: calc(88 * var(--r)); min-height: calc(88 * var(--r)); padding: 0; position: fixed; right: calc(32 * var(--r)); bottom: calc(40 * var(--r)); z-index: 50; width: calc(88 * var(--r)); height: calc(88 * var(--r)); border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--float); border: calc(2 * var(--r)) solid var(--line); box-shadow: 0 calc(16 * var(--r)) calc(40 * var(--r)) calc(-16 * var(--r)) rgba(40, 25, 10, .5); opacity: 0; transform: translateY(calc(20 * var(--r))) scale(.9); pointer-events: none; transition: opacity .22s, transform .22s; }
.to-top.show { opacity: 1; transform: none; pointer-events: auto; }
.to-top-hv { transform: scale(.92); }
.tt-arr { width: calc(22 * var(--r)); height: calc(22 * var(--r)); margin-top: calc(8 * var(--r)); border-left: calc(5 * var(--r)) solid var(--fg); border-top: calc(5 * var(--r)) solid var(--fg); transform: rotate(45deg); }

/* 顶部品牌栏 + 中英文切换：四个底栏页共用 */
.brandbar { display: flex; align-items: center; gap: calc(12 * var(--r)); padding: calc(16 * var(--r)) calc(32 * var(--r)); background: var(--surface); border-bottom: calc(2 * var(--r)) solid var(--line); }
.brandbar .sq { width: calc(76 * var(--r)); height: calc(76 * var(--r)); }
.brandbar .x { color: var(--muted); font-size: calc(16 * var(--r)); }
.brandbar .bb-sp { flex: 1; }
.brandbar .tag { font-size: calc(16 * var(--r)); letter-spacing: calc(6 * var(--r)); color: var(--muted); text-align: right; padding-left: calc(20 * var(--r)); border-left: calc(2 * var(--r)) solid var(--line); line-height: 1.3; }
.lang { display: flex; align-items: center; border: calc(2 * var(--r)) solid var(--line); border-radius: calc(999 * var(--r)); background: var(--surface, #f8f2e6); padding: calc(4 * var(--r)); margin-right: calc(16 * var(--r)); }
.lang text { font-size: calc(16 * var(--r)); font-weight: 600; padding: calc(10 * var(--r)) calc(18 * var(--r)); border-radius: calc(999 * var(--r)); color: var(--muted); font-family: ui-monospace, Menlo, monospace; }
.lang text.on { background: var(--accent); color: #fffaf0; }

/* 标题字体：与网页一致的宋体系衬线（iOS 宋体-简、安卓思源宋体等），正文仍用无衬线 */
page { --f-display: "Songti SC", "Noto Serif SC", "Source Han Serif SC", "STSongti-SC-Black", "Noto Serif CJK SC", serif; }
.h1, .h2, .blockh, .today-h .b, .pn, .ct, .bh, .stt, .pc-name, .gh, .past-t, .gone-t, .bt, .mr-t, .me-t, .fi-stats .fn, .care-h { font-family: var(--f-display); }

/* 大标题用宋体黑体字重（iOS/macOS 的 STSongti-SC-Black），否则细宋体显得单薄 */
.h1, .h2, .today-h .b, .blockh, .me-t { font-family: "STSongti-SC-Black", "Songti SC", "Noto Serif SC", "Source Han Serif SC", "Noto Serif CJK SC", serif; font-weight: 900; }

/* 外观：输入框文字随主题（微信在暗色下会改原生控件默认色） */
input, textarea { color: var(--fg); }
