.row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 2rpx solid var(--line-soft); }
.pst { flex: none; width: 116rpx; height: 174rpx; border-radius: 8rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.12); }
.ph { display: flex; align-items: center; justify-content: center; color: #fffaf0; font-size: 40rpx; font-weight: 900; }
.info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.t { font-size: 32rpx; font-weight: 700; line-height: 1.35; }
.o { font-size: 22rpx; color: var(--muted); font-style: italic; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.d { font-size: 22rpx; color: var(--muted); }
.f { font-size: 20rpx; color: var(--teal); margin-top: 4rpx; }
.sc { flex: none; display: flex; flex-direction: column; align-items: flex-end; }
.sc .n { font-size: 34rpx; font-weight: 700; }
.sc .l { font-size: 20rpx; color: var(--muted); }

.gh { font-size: 32rpx; font-weight: 900; margin: 36rpx 0 8rpx; padding-bottom: 12rpx; border-bottom: 2rpx solid var(--line); }

.gh-kind{display:block;font-size:20rpx;color:var(--muted);letter-spacing:3rpx;margin-bottom:10rpx}.gh-name{display:block;white-space:nowrap;font-size:40rpx}

/* 分组折叠 */
.sec { border-top: 2rpx solid var(--line); margin-top: 36rpx; }
.gh2, .pc-h { display: flex; align-items: center; gap: 18rpx; padding: 26rpx 0 18rpx; }
.ghm { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.gh2 .gh-name { white-space: normal; font-size: 40rpx; font-weight: 900; }
.gh-meta { font-size: 20rpx; color: var(--muted); letter-spacing: 2rpx; margin-top: 8rpx; }
.fold { flex: none; width: 60rpx; height: 60rpx; border-radius: 50%; border: 2rpx solid var(--line); background: var(--surface); display: flex; align-items: center; justify-content: center; transition: transform .25s; }
.fold .chev { font-size: 34rpx; line-height: 1; margin-top: -10rpx; color: var(--fg); transition: transform .25s; }
.fold.shut { background: var(--fg); border-color: var(--fg); }
.fold.shut .chev { color: var(--bg); transform: rotate(-90deg); margin-top: 0; margin-left: -8rpx; }
.stk { display: flex; align-items: center; flex: none; }
.sp { width: 38rpx; height: 54rpx; border-radius: 8rpx; margin-left: -16rpx; border: 4rpx solid var(--bg); box-shadow: 0 2rpx 6rpx rgba(40,25,10,.18); }
.stk .sp:first-child { margin-left: 0; }
.sph { display: flex; align-items: center; justify-content: center; color: #fffaf0; font-size: 20rpx; font-weight: 900; }
.gone { display: inline-flex; align-items: center; gap: 10rpx; margin: 18rpx 0 8rpx; padding: 12rpx 24rpx; border: 2rpx dashed var(--line); border-radius: 99rpx; font-size: 24rpx; color: var(--muted); }
.gone.on { border-style: solid; color: var(--fg); }
.gone .gn { font-weight: 700; color: var(--fg); }
.gone-list { opacity: .85; }
.pasth { display: flex; align-items: baseline; justify-content: space-between; margin-top: 64rpx; padding-top: 28rpx; border-top: 4rpx solid var(--fg); }
.pasth .pt { font-size: 36rpx; font-weight: 900; } .pasth .ps { font-size: 22rpx; color: var(--muted); }
.pcard { margin-top: 20rpx; border: 2rpx solid var(--line); border-radius: 24rpx; background: var(--surface); padding: 0 24rpx; }
.pcard .pc-h { padding: 22rpx 0; }
.pc-name { font-size: 32rpx; font-weight: 900; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pc-b { border-top: 2rpx solid var(--line); }

.fi-stats { display: flex; gap: 40rpx; margin: 8rpx 0 14rpx; } .fi-stats .fn { font-size: 44rpx; font-weight: 600; margin-right: 10rpx; } .fi-stats .fl { font-size: 22rpx; color: var(--muted); }
.selector-mask{position:fixed;inset:0;z-index:1000;background:rgba(25,20,15,.23);display:flex;align-items:center;justify-content:center}.selector-panel{width:calc(100% - 48rpx);max-height:68vh;box-sizing:border-box;border:1rpx solid var(--line);border-radius:32rpx;background:var(--surface);padding:30rpx 16rpx 16rpx;box-shadow:0 30rpx 100rpx #0002}.selector-head{display:flex;align-items:center;justify-content:space-between;padding:0 16rpx 22rpx;font-size:36rpx;font-weight:700}.selector-close{width:56rpx;height:56rpx;line-height:50rpx;text-align:center;border-radius:50%;background:var(--bg);font-size:42rpx;color:var(--muted);font-weight:400}.selector-search{font-size:28rpx;margin:0 16rpx 20rpx;padding:20rpx 24rpx;border:1rpx solid var(--line);border-radius:16rpx;background:var(--bg)}.selector-results{height:44vh;max-height:44vh}.selector-option{display:flex;gap:20rpx;align-items:center;min-height:88rpx;box-sizing:border-box;padding:20rpx 24rpx;border-radius:16rpx}.selector-option.selected{background:#2f6f6c12}.selector-copy{flex:1;min-width:0;font-size:26rpx;line-height:1.5}.selector-copy text{display:block}.selector-copy .small{font-size:22rpx;margin-top:5rpx}.selector-check{width:32rpx;color:var(--teal);flex-shrink:0}.selector-empty{padding:44rpx 20rpx;text-align:center;color:var(--muted);font-size:26rpx}
.library-search{display:flex;align-items:center;gap:16rpx;border:1rpx solid var(--line);border-radius:20rpx;background:var(--surface);padding:18rpx 24rpx;margin-bottom:16rpx}.library-search>text{font-size:38rpx;color:var(--muted)}.library-search input{flex:1;min-width:0;font-size:28rpx}.library-filterbar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1rpx solid var(--line);background:var(--surface);border-radius:22rpx;overflow:hidden;margin-bottom:28rpx}.library-filter{min-width:0;padding:22rpx}.library-filter+.library-filter{border-left:1rpx solid var(--line)}.library-filter:nth-child(3n+1){border-left:0}.library-filter:nth-child(n+4){border-top:1rpx solid var(--line)}.library-filter.active{box-shadow:inset 0 -3rpx var(--accent)}.filter-label{display:block;font-size:20rpx;color:var(--muted);margin-bottom:8rpx}.filter-value{display:flex;justify-content:space-between;gap:14rpx;font-weight:600;font-size:26rpx}.filter-value>text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}.library-reset{text-align:right;color:var(--muted);font-size:22rpx;margin:-16rpx 0 20rpx}.film-statuses{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:8rpx}.film-statuses>text{font-size:18rpx;line-height:1.5;padding:2rpx 8rpx;border:1rpx solid var(--line);border-radius:4rpx;color:var(--teal)}.film-statuses>.event{color:#806027;border-color:#cdbb8a}.library-empty{text-align:center;color:var(--muted);padding:60rpx 20rpx;line-height:1.8;font-size:24rpx}.library-empty text{display:block}.library-empty .b{font-size:30rpx;margin-bottom:12rpx;color:var(--fg)}

.schedule-filter .filter-label{font-size:23rpx}.filter-value{font-size:27rpx}.selector-option .b{font-size:30rpx}.selector-option .small{font-size:25rpx}

/* 多选弹层：勾选框 + 完成按钮 */
.selector-check.box{width:40rpx;height:40rpx;box-sizing:border-box;border:3rpx solid var(--line);border-radius:10rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;line-height:1;color:#fffaf0;flex:none}
.selector-check.box.on{background:var(--accent);border-color:var(--accent)}
.selector-foot{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:18rpx 16rpx 6rpx;border-top:1rpx solid var(--line-soft);margin-top:8rpx}
.selector-foot text{font-size:23rpx;color:var(--muted)}
.selector-done{min-width:200rpx;height:76rpx;border-radius:99rpx;background:var(--accent);color:#fffaf0;font-size:28rpx;font-weight:700;display:flex;align-items:center;justify-content:center}
