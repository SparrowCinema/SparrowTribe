.row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 2rpx solid var(--line-soft); }
.pst { flex: none; width: 116rpx; height: 174rpx; border-radius: 8rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.12); }
.ph { display: flex; align-items: center; justify-content: center; color: #fffaf0; font-size: 40rpx; font-weight: 900; }
.info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.t { font-size: 32rpx; font-weight: 700; line-height: 1.35; }
.o { font-size: 22rpx; color: var(--muted); font-style: italic; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.d { font-size: 22rpx; color: var(--muted); }
.f { font-size: 20rpx; color: var(--teal); margin-top: 4rpx; }
.sc { flex: none; display: flex; flex-direction: column; align-items: flex-end; }
.sc .n { font-size: 34rpx; font-weight: 700; }
.sc .l { font-size: 20rpx; color: var(--muted); }

.gh { font-size: 32rpx; font-weight: 900; margin: 36rpx 0 8rpx; padding-bottom: 12rpx; border-bottom: 2rpx solid var(--line); }
