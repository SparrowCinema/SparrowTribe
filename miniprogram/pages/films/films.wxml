<wxs src="../../utils/l.wxs" module="L" />
<view class="wrap">
  <view class="h2">{{L.t(i,'片目')}}</view>
  <view class="fi-stats"><view><text class="fn mono">{{stat.total}}</text><text class="fl">{{L.t(i,'部影片')}}</text></view><view><text class="fn mono">{{stat.progs}}</text><text class="fl">{{L.t(i,'个专题')}}</text></view><view><text class="fn mono">{{stat.live}}</text><text class="fl">{{L.t(i,'部待映')}}</text></view></view>
  <view class="sub">{{L.t(i,'按专题分组，每个专题可收起；已放映的收进专题内，专题结束后归入「往期专题」。右侧为豆瓣评分。')}}</view>
  <view class="library-search"><text>⌕</text><input type="text" confirm-type="search" placeholder="{{L.t(i,'搜索片名、导演、演员')}}" value="{{q}}" bindinput="search" /></view>
  <view class="library-filterbar">
    <view class="library-filter {{pf!=='all'?'active':''}}" data-type="programme" bindtap="openSelector"><text class="filter-label">{{L.t(i,'专题')}}</text><view class="filter-value"><text>{{programmeName}}</text><text>⌄</text></view></view>
    <view class="library-filter {{year!=='all'?'active':''}}" data-type="year" bindtap="openSelector"><text class="filter-label">{{L.t(i,'年份')}}</text><view class="filter-value"><text>{{yearName}}</text><text class="filter-arrow">⌄</text></view></view>
    <view class="library-filter" data-type="city" bindtap="openSelector"><text class="filter-label">{{L.t(i,'城市')}}</text><view class="filter-value"><text>{{cityName}}</text><text class="filter-arrow">⌄</text></view></view>
    <view class="library-filter {{reg!=='all'?'active':''}}" data-type="region" bindtap="openSelector"><text class="filter-label">{{L.t(i,'地区')}}</text><view class="filter-value"><text>{{regName}}</text><text class="filter-arrow">⌄</text></view></view>
    <view class="library-filter {{len!=='all'?'active':''}}" data-type="length" bindtap="openSelector"><text class="filter-label">{{L.t(i,'片长')}}</text><view class="filter-value"><text>{{lenName}}</text><text class="filter-arrow">⌄</text></view></view>
    <view class="library-filter {{mine!=='all'?'active':''}}" data-type="personal" bindtap="openSelector"><text class="filter-label">{{L.t(i,'我的')}}</text><view class="filter-value"><text>{{mineName}}</text><text>⌄</text></view></view>
  </view>
  <view wx:if="{{active}}" class="library-reset" bindtap="resetFilters">{{L.t(i,'重置筛选')}} ↺</view>
  <view wx:if="{{selectorType}}" class="selector-mask" catchtap="closeSelector" catchtouchmove="stopMove">
    <view class="selector-panel" catchtap="stopMove"><view class="selector-head"><text>{{selectorTitle}}</text><view class="selector-close" bindtap="closeSelector">×</view></view>
      <input class="selector-search" placeholder="{{selectorPlaceholder}}" value="{{selectorQuery}}" bindinput="searchSelector" />
      <scroll-view scroll-y class="selector-results"><view wx:for="{{selectorRows}}" wx:key="id" class="selector-option {{item.selected?'selected':''}}" data-id="{{item.id}}" bindtap="chooseFilter"><view class="selector-copy"><text class="b">{{item.name}}</text><text class="small muted">{{item.sub}}</text></view><text class="selector-check box {{item.selected?'on':''}}">{{item.selected?'✓':''}}</text></view><view wx:if="{{!selectorRows.length}}" class="selector-empty">{{L.t(i,'没有匹配的结果')}}</view></scroll-view><view class="selector-foot"><text>{{L.t(i,'可多选')}}</text><view class="selector-done" bindtap="closeSelector">{{L.t(i,'完成')}}</view></view>
    </view>
  </view>
  <view wx:if="{{!n}}" class="library-empty"><text class="b">{{L.t(i,'当前分类暂无影片')}}</text><text>{{mine==='planned'?L.t(i,'在排片表中加入场次，就会出现在这里。'):mine==='watched'?L.t(i,'在影片页点「看过」，开始收集你的电影印章。'):L.t(i,'换个分类，或试试片名、导演、演员。')}}</text></view>
  <view wx:for="{{secs}}" wx:for-item="g" wx:key="id" class="sec">
    <view class="gh2" data-id="{{g.id}}" bindtap="toggleSec">
      <view class="ghm"><text class="gh-kind">{{g.kind}}</text><text class="gh-name">{{g.name}}</text><text class="gh-meta mono">{{L.n(i,g.meta,'f')}}{{g.en ? ' · ' + g.en : ''}}</text></view>
      <view class="stk" wx:if="{{!g.open}}"><block wx:for="{{g.stack}}" wx:for-item="s" wx:key="id"><image wx:if="{{s.poster}}" class="sp" src="{{s.poster}}" mode="aspectFill" lazy-load /><view wx:else class="sp sph" style="background:{{s.color}}">{{s.ch}}</view></block></view>
      <view class="fold {{g.open ? '' : 'shut'}}"><text class="chev">⌄</text></view>
    </view>
    <block wx:if="{{g.open}}">
      <block wx:for="{{g.live}}" wx:key="id">
    <view class="row" data-id="{{item.id}}" bindtap="open">
      <image wx:if="{{item.poster}}" class="pst" src="{{item.poster}}" mode="aspectFill" lazy-load />
      <view wx:else class="pst ph" style="background:{{item.color}}">{{item.cn[0]}}</view>
      <view class="info">
        <view class="t">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></view>
        <text class="o">{{item.en}}</text>
        <text class="d">{{item.dir}} · {{item.c}} · {{item.y}}</text>
        <text wx:if="{{item.next}}" class="f mono">{{L.t(i,'下一场')}} {{item.next}}</text>
        <text wx:elif="{{item.release}}" class="f">{{item.release}}</text>
        <view class="film-statuses"><text wx:if="{{item.planned}}">{{L.t(i,'已排片')}}</text><text wx:if="{{item.watched}}">{{L.t(i,'已看过')}}</text><text wx:if="{{item.event}}" class="event">{{L.t(i,'主创映后')}}</text></view>
      </view>
      <view class="sc"><text class="n mono">{{item.db}}</text><text class="l">{{L.t(i,'豆瓣')}}</text></view>
    </view>
      </block>
      <view wx:if="{{g.gone.length}}" class="gone {{g.goneOpen ? 'on' : ''}}" data-id="{{g.id}}" bindtap="toggleGone"><text>{{L.t(i,'本专题已放映')}}</text><text class="gn mono">{{g.gone.length}}</text><text class="chev2">{{g.goneOpen ? '⌃' : '›'}}</text></view>
      <view wx:if="{{g.goneOpen}}" class="gone-list">
        <block wx:for="{{g.gone}}" wx:key="id">
    <view class="row" data-id="{{item.id}}" bindtap="open">
      <image wx:if="{{item.poster}}" class="pst" src="{{item.poster}}" mode="aspectFill" lazy-load />
      <view wx:else class="pst ph" style="background:{{item.color}}">{{item.cn[0]}}</view>
      <view class="info">
        <view class="t">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></view>
        <text class="o">{{item.en}}</text>
        <text class="d">{{item.dir}} · {{item.c}} · {{item.y}}</text>
        <text wx:if="{{item.next}}" class="f mono">{{L.t(i,'下一场')}} {{item.next}}</text>
        <text wx:elif="{{item.release}}" class="f">{{item.release}}</text>
        <view class="film-statuses"><text wx:if="{{item.planned}}">{{L.t(i,'已排片')}}</text><text wx:if="{{item.watched}}">{{L.t(i,'已看过')}}</text><text wx:if="{{item.event}}" class="event">{{L.t(i,'主创映后')}}</text></view>
      </view>
      <view class="sc"><text class="n mono">{{item.db}}</text><text class="l">{{L.t(i,'豆瓣')}}</text></view>
    </view>
        </block>
      </view>
    </block>
  </view>

  <block wx:if="{{past.length}}">
    <view class="pasth"><text class="pt">{{L.t(i,'往期专题')}}</text><text class="ps">{{L.n(i,pastN,'f')}}</text></view>
    <view wx:for="{{past}}" wx:for-item="g" wx:key="id" class="pcard">
      <view class="pc-h" data-id="{{g.id}}" bindtap="togglePast">
        <view class="ghm"><text class="gh-kind">{{g.kind}}</text><text class="pc-name">{{g.name}}</text><text class="gh-meta mono">{{L.n(i,g.n,'f')}}{{g.period ? ' · ' + g.period : ''}}</text></view>
        <view class="stk"><block wx:for="{{g.stack}}" wx:for-item="s" wx:key="id"><image wx:if="{{s.poster}}" class="sp" src="{{s.poster}}" mode="aspectFill" lazy-load /><view wx:else class="sp sph" style="background:{{s.color}}">{{s.ch}}</view></block></view>
        <view class="fold {{g.open ? '' : 'shut'}}"><text class="chev">⌄</text></view>
      </view>
      <view wx:if="{{g.open}}" class="pc-b">
        <block wx:for="{{g.rows}}" wx:key="id">
    <view class="row" data-id="{{item.id}}" bindtap="open">
      <image wx:if="{{item.poster}}" class="pst" src="{{item.poster}}" mode="aspectFill" lazy-load />
      <view wx:else class="pst ph" style="background:{{item.color}}">{{item.cn[0]}}</view>
      <view class="info">
        <view class="t">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></view>
        <text class="o">{{item.en}}</text>
        <text class="d">{{item.dir}} · {{item.c}} · {{item.y}}</text>
        <text wx:if="{{item.next}}" class="f mono">{{L.t(i,'下一场')}} {{item.next}}</text>
        <text wx:elif="{{item.release}}" class="f">{{item.release}}</text>
        <view class="film-statuses"><text wx:if="{{item.planned}}">{{L.t(i,'已排片')}}</text><text wx:if="{{item.watched}}">{{L.t(i,'已看过')}}</text><text wx:if="{{item.event}}" class="event">{{L.t(i,'主创映后')}}</text></view>
      </view>
      <view class="sc"><text class="n mono">{{item.db}}</text><text class="l">{{L.t(i,'豆瓣')}}</text></view>
    </view>
        </block>
      </view>
    </view>
  </block>
</view>
