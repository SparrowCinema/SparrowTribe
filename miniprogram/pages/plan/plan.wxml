<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view class="wrap">
 <view wx:if="{{planSelectorOpen}}" class="selector-mask" catchtouchmove="noop" catchtap="closePlanSelector"><view class="selector-panel" catchtap="noop"><view class="selector-head"><text>{{L.t(i,'选择专题')}}</text><text bindtap="closePlanSelector">×</text></view><input class="selector-search" placeholder="{{L.t(i,'搜索专题')}}" value="{{planQuery}}" bindinput="searchPlanSelector"/><scroll-view scroll-y class="selector-results"><view wx:for="{{planOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="choosePlanScope" class="selector-option"><view><text class="b">{{item.n}}</text><text class="small">{{item.lab}}</text></view><text class="selector-check box {{item.selected?'on':''}}">{{item.selected?'✓':''}}</text></view><view wx:if="{{!planOptions.length}}" class="small">{{L.t(i,'没有匹配的专题')}}</view></scroll-view><view class="selector-foot"><text>{{L.t(i,'可多选')}}</text><view class="selector-done" bindtap="closePlanSelector">{{L.t(i,'完成')}}</view></view></view></view>
 <view wx:if="{{smartOpen}}" class="selector-mask" catchtouchmove="noop" catchtap="closeSmartPlan">
   <view class="selector-panel smart-panel" catchtap="noop">
     <view class="selector-head"><text>{{L.t(i,'想看一键排片建议')}}</text><text bindtap="closeSmartPlan">×</text></view>
     <view wx:if="{{smartEmpty}}" class="sp-empty">
       <text class="small">{{L.t(i,'你的「想看」清单还是空的。在影片页点「☆ 想看」收藏几部想看的电影，这里就能自动为你避开冲突、排出一份行程建议。')}}</text>
       <view class="btn sp-go" bindtap="toFilms">{{L.t(i,'去片目挑电影')}}</view>
     </view>
     <block wx:else>
       <view class="sp-summary"><text>{{smartSummary}}</text><text class="small">{{L.t(i,'已选排片保持不变，可取消勾选不需要的场次。')}}</text></view>
       <scroll-view scroll-y class="selector-results">
         <view wx:for="{{smartPicks}}" wx:key="key" data-key="{{item.key}}" bindtap="smartToggle" class="selector-option sp-opt">
           <view class="sp-info">
             <text class="b">{{item.title}}<text wx:if="{{item.ver}}" class="pg-ver"> {{item.ver}}</text></text>
             <text class="small">{{item.when}} · {{item.place}}</text>
             <view wx:if="{{item.tags.length}}" class="sp-tags"><text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="txt" class="sp-tag {{tg.warn?'warn':''}}">{{tg.txt}}</text></view>
           </view>
           <text class="selector-check box {{item.selected?'on':''}}">{{item.selected?'✓':''}}</text>
         </view>
         <view wx:if="{{!smartPicks.length}}" class="small sp-none">{{L.t(i,'想看清单里的影片暂时没有可无冲突排入的新场次。')}}</view>
         <view wx:if="{{smartUnsched.length}}" class="sp-unsched">
           <text class="sp-uh">{{L.t(i,'未能排入')}} ({{smartUnsched.length}})</text>
           <view wx:for="{{smartUnsched}}" wx:key="filmId" class="sp-urow"><text class="sp-ut">{{item.title}}</text><text class="small">{{item.reason}}</text></view>
         </view>
       </scroll-view>
       <view class="selector-foot">
         <text>{{L.t(i,'已选')}} {{smartSelCount}} {{L.t(i,'场')}}</text>
         <view class="selector-done {{smartSelCount?'':'off'}}" bindtap="smartApply">{{smartSelCount ? L.t(i,'加入所选') : L.t(i,'关闭')}}</view>
       </view>
     </block>
   </view>
 </view>

  <view id="plan" class="blockh">{{L.t(i,'个人排片')}} <text class="en">MY PLAN</text></view>
  <view wx:if="{{moved.length}}" class="plan-gone plan-moved">
    <text class="pg-h">{{movedHead}}</text>
    <text class="pg-p">{{L.t(i,'主办方调整了这些场次，你的排片已经自动换成新时间。')}}</text>
    <view wx:for="{{moved}}" wx:key="k" class="pg-item">
      <text class="pg-t">{{item.title}}<text wx:if="{{item.ver}}" class="pg-ver"> {{item.ver}}</text></text>
      <text class="pg-was">{{L.t(i,'原定')}} {{item.was}}</text>
      <text class="pg-now">{{L.t(i,'改为')}} {{item.now}}</text>
      <text class="pg-ok" bindtap="movedOk" data-k="{{item.k}}">{{L.t(i,'知道了')}}</text>
    </view>
  </view>
  <view wx:if="{{gone.length}}" class="plan-gone">
    <text class="pg-h">{{goneHead}}</text>
    <text class="pg-p">{{L.t(i,'这些场次在最新排片里已经找不到了，可能改了时间、换了影厅或取消。')}}</text>
    <view wx:for="{{gone}}" wx:key="k" class="pg-item">
      <text class="pg-t">{{item.title}}<text wx:if="{{item.ver}}" class="pg-ver"> {{item.ver}}</text></text>
      <text class="pg-was"><text wx:if="{{item.cancel}}">{{L.t(i,'已取消')}} · </text>{{L.t(i,'原定')}} {{item.was}}</text>
      <view wx:for="{{item.alts}}" wx:for-item="a" wx:key="to" class="pg-alt" hover-class="hv" bindtap="goneSwap" data-k="{{item.k}}" data-to="{{a.to}}"><text>{{a.txt}}</text><text class="pg-plus">＋</text></view>
      <text wx:if="{{!item.alts.length}}" class="pg-none">{{L.t(i,'这部影片暂时没有其他待映场次')}}</text>
      <text class="pg-ok" bindtap="goneOk" data-k="{{item.k}}">{{L.t(i,'知道了')}}</text>
    </view>
  </view>
  <view class="stats card">
    <view><text class="n mono">{{stats.n}}</text><text class="l">{{L.t(i,'场放映')}}</text></view>
    <view><text class="n mono">{{stats.d}}</text><text class="l">{{L.t(i,'天行程')}}</text></view>
    <view><text class="n mono">{{stats.hm}}</text><text class="l">{{L.t(i,'银幕时长')}}</text></view>
    <view class="{{clash?'bad':'good'}}"><text class="n mono">{{clash}}</text><text class="l">{{L.t(i,'时间冲突')}}</text></view>
  </view>

  <view wx:if="{{empty}}" class="empty">
    <text class="plus">＋</text>
    <text class="et">{{L.t(i,'还没有加入场次')}}</text>
    <text class="es">{{L.t(i,'在排片表或影片页点「加入排片」')}}</text>
    <view class="btn" bindtap="toSchedule">{{L.t(i,'去选电影')}}</view>
    <view wx:if="{{wantN}}" class="btn ghost sp-empty-btn" bindtap="openSmartPlan">✦ {{smartBtnTxt}}</view>
  </view>

  <block wx:else>
    <view wx:if="{{progs.length}}" class="pfbox">
      <view class="pf-head"><text class="pf-t">{{L.t(i,'选择专题')}}</text><text class="pf-s">{{L.t(i,'排片与分享只含所选内容')}}</text></view>
      <view class="plan-scope" bindtap="openPlanSelector"><view><text class="small">{{L.t(i,'选择专题')}}</text><text class="b">{{planScopeName}}</text></view><text>⌄</text></view>

    </view>
    <view id="plan-tools" class="tools">
      <view class="btn" hover-class="hv" bindtap="makeImage">{{L.t(i,'生成长图')}}</view>
      <view class="btn ghost" hover-class="hv" bindtap="addAllCalendar">{{L.t(i,'排片表批量导入日历')}}</view>
      <view class="btn ghost sp-tool" hover-class="hv" bindtap="openSmartPlan">✦ {{smartBtnTxt}}</view>
      <button class="btn ghost" open-type="share">{{L.t(i,'分享给朋友')}}</button>
      <view class="btn ghost" bindtap="toSchedule">{{L.t(i,'继续选片')}}</view>
      <view class="clear" bindtap="clear">{{L.t(i,'清空')}}</view>
    </view>
    <view wx:if="{{pfEmpty}}" class="pf-empty card"><text class="b">{{L.t(i,'这个专题还没有加入场次')}}</text><text class="muted small">{{L.t(i,'切换到「全部专题」，或去排片表挑选。')}}</text></view>
    <view wx:if="{{clash}}" class="conflict">
      <text class="b">{{clashTxt}}</text>{{L.t(i,'，已在日程中标红，可一键换场或移出其中一场。')}}
      <view wx:if="{{swaps.length}}" class="ps-wrap">
        <text class="ps-lab">{{L.t(i,'可一键换成无冲突场次')}}</text>
        <view wx:for="{{swaps}}" wx:key="fromKey" class="ps-item">
          <text class="ps-h">{{item.title}} <text class="small">{{L.t(i,'当前')}} {{item.cur}}</text></text>
          <view wx:for="{{item.alts}}" wx:for-item="a" wx:key="to" class="pg-alt ps-alt" hover-class="hv" bindtap="conflictSwap" data-from="{{item.fromKey}}" data-to="{{a.to}}">
            <view class="ps-at"><text>{{a.txt}}</text><text wx:if="{{a.tag}}" class="ps-tag">{{a.tag}}</text></view>
            <text class="pg-plus">⇄</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:for="{{days}}" wx:for-item="day" wx:key="d" class="day">
      <view class="dh"><text class="dd mono">{{day.y}}/{{day.d}}</text><text class="dw">{{day.wk}}</text><text class="dr">{{day.cnt}} · {{day.range}}</text></view>
      <block wx:for="{{day.items}}" wx:key="key">
        <view wx:if="{{item.gap}}" class="gap {{item.gap.cls}}"><text>{{item.gap.txt}}</text><text wx:if="{{item.gap.mapName}}" class="gap-map" data-v="{{item.gap.mapName}}" bindtap="openMap">{{L.t(i,'地图')}} ›</text></view>
        <view class="it">
          <view class="tm mono"><text class="b">{{item.t}}</text><text>{{item.end}}</text></view>
          <view class="pc card" style="--c:{{item.color}}" data-id="{{item.id}}" bindtap="open">
            <image wx:if="{{item.poster}}" class="th" src="{{item.poster}}" mode="aspectFill" />
            <view class="pi">
              <view class="pt">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></view>
              <text class="ps">{{item.dir}} · {{item.minTxt}}</text>
              <text class="pv">{{item.venue}}<text class="htag">{{item.hall}}</text></text>
              <text wx:if="{{item.canRm}}" class="rmd {{item.rm ? 'on' : ''}}" data-key="{{item.key}}" data-film="{{item.id}}" catchtap="remindTap">{{item.rm ? L.t(i, '🔔 已开启开场提醒') : L.t(i, '🔔 开启开场提醒')}}</text>
            </view>
            <view class="rm" data-key="{{item.key}}" catchtap="remove">✕</view>
          </view>
        </view>
      </block>
    </view>
    <canvas type="2d" id="poster" class="poster-cv" />
    <view class="note">{{L.t(i,'散场时间按片长计算；含映后活动的场次已按约 30 分钟纳入转场提醒，跨影院用时按距离估算。')}}</view>
  </block>

  <view class="makers">
    <text class="k2">{{L.t(i, '制作设计 · PRODUCED ' + '&' + ' DESIGNED BY')}}</text>
    <view class="row">
      <image src="{{dk ? '/images/brand/sparrow-movies-sq-dark.png' : '/images/brand/sparrow-movies-sq.png'}}" mode="aspectFit" />
      <text class="x">×</text>
      <image src="{{dk ? '/images/brand/sparrow-tribe-sq-dark.png' : '/images/brand/sparrow-tribe-sq.png'}}" mode="aspectFit" />
    </view>
    <text class="d">{{L.t(i,'电影放映与策展')}}</text>
  </view>
</view>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>
