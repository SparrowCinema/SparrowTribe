.hero { position: relative; overflow: hidden; color: #fffaf0; background: #1c1510; }
.bg { position: absolute; left: -60rpx; top: -60rpx; width: calc(100% + 120rpx); height: calc(100% + 120rpx); filter: blur(30px) saturate(1.2); opacity: .85; }
.shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(20,14,10,.35), rgba(20,14,10,.6) 50%, rgba(20,14,10,.85)); }
.hin { position: relative; display: flex; gap: 32rpx; align-items: flex-end; padding: 48rpx 32rpx 40rpx; }
.pst { flex: none; width: 220rpx; height: 330rpx; border-radius: 12rpx; box-shadow: 0 20rpx 50rpx rgba(0,0,0,.5); }
.tt { flex: 1; min-width: 0; }
.prog { display: inline-block; font-size: 20rpx; font-weight: 700; padding: 4rpx 16rpx; border-radius: 99rpx; background: rgba(255,250,240,.92); color: #2b2117; margin-bottom: 0; }
.progrow { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-bottom: 12rpx; }
.unit { display: inline-flex; align-items: center; gap: 8rpx; font-size: 20rpx; font-weight: 700; padding: 4rpx 18rpx 4rpx 14rpx; border-radius: 99rpx; color: #ffe7a6; background: rgba(255,214,110,.16); border: 2rpx solid rgba(255,214,110,.5); }
.unit .ud { font-size: 12rpx; color: #ffd66e; }
.eyebrow { font-size: 20rpx; opacity: .85; }
.reg { font-size: 18rpx; padding: 2rpx 12rpx; border-radius: 6rpx; background: var(--fc); margin-right: 10rpx; }
.h1 { font-size: 56rpx; font-weight: 900; line-height: 1.15; margin: 10rpx 0 6rpx; }
.en { font-size: 26rpx; font-style: italic; opacity: .9; }
.native { font-size: 22rpx; opacity: .7; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.tg { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 8rpx; background: rgba(255,250,240,.14); border: 2rpx solid rgba(255,250,240,.22); }
.ed2 { background: #fffaf0; color: #2b2117; font-weight: 700; }
.by { margin-top: 16rpx; font-size: 24rpx; opacity: .9; }
.b { font-weight: 700; }
.small { font-size: 22rpx; font-weight: 400; }
.buy { display: flex; align-items: center; gap: 24rpx; margin-top: 32rpx; padding: 30rpx 28rpx; border-radius: 24rpx; background: var(--surface); border: 2rpx solid var(--line); border-top: 6rpx solid var(--accent); box-shadow: 0 8rpx 36rpx rgba(43, 33, 23, .06); }
.buyt { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 6rpx; }
.bk { font-size: 18rpx; letter-spacing: 5rpx; color: var(--accent); }
.bh { font-size: 46rpx; font-weight: 900; line-height: 1.3; font-family: 'Noto Serif SC', 'Songti SC', serif; }
.bs { font-size: 22rpx; color: var(--muted); line-height: 1.7; margin-bottom: 10rpx; }
.bx { font-size: 22rpx; color: var(--accent); border-bottom: 2rpx solid var(--accent); padding-bottom: 4rpx; }
.bx.hv { opacity: .6; }

.qr { flex: none; width: 236rpx; height: 236rpx; background: #fff; border-radius: 16rpx; padding: 12rpx; box-sizing: border-box; box-shadow: 0 0 0 2rpx rgba(43, 33, 23, .06); }
.ratings { display: flex; margin-top: 28rpx; overflow: hidden; }
.rt { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 6rpx; padding: 20rpx 4rpx; }
.rt + .rt { border-left: 2rpx solid var(--line-soft); }
.rl { font-size: 18rpx; color: var(--muted); }
.rv { font-size: 34rpx; font-weight: 700; }
.rt.na .rv { color: var(--muted); font-weight: 400; }
.rb { width: 70%; height: 6rpx; border-radius: 4rpx; background: var(--line-soft); overflow: hidden; }
.ri { height: 100%; background: var(--fc); }
.sec-h { display: flex; align-items: baseline; gap: 12rpx; font-size: 26rpx; font-weight: 700; letter-spacing: 2rpx; margin: 40rpx 0 16rpx; }
.ticket { position: relative; display: flex; overflow: hidden; margin-bottom: 16rpx; border-radius: 24rpx; }
.td { position: relative; flex: none; width: 152rpx; background: var(--fc); color: #fffaf0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24rpx 0; }
.td::after { content: ''; position: absolute; right: -2rpx; top: 16rpx; bottom: 16rpx; border-right: 4rpx dashed var(--surface); }
.tm { font-size: 22rpx; opacity: .85; }
.tdd { font-size: 64rpx; font-weight: 700; line-height: 1; }
.tw { font-size: 22rpx; margin-top: 6rpx; }
.tb { flex: 1; min-width: 0; padding: 22rpx 24rpx 22rpx 28rpx; display: flex; flex-direction: column; gap: 6rpx; }
.ttime { font-size: 30rpx; color: var(--muted); }
.ttime .b { font-size: 40rpx; color: var(--fg); }
.tv { font-size: 24rpx; color: var(--teal); font-weight: 600; line-height: 1.45; }
.thall { align-self: flex-start; font-size: 22rpx; color: var(--teal); font-weight: 600; line-height: 1.5; padding: 0 14rpx; border-radius: 12rpx; background: rgba(47,111,108,.12); margin-top: 6rpx; }
.tact { display: flex; flex-wrap: nowrap; gap: 10rpx; margin-top: 14rpx; }
.ta { flex: 1; min-width: 0; height: 56rpx; line-height: 56rpx; text-align: center; white-space: nowrap; padding: 0; font-size: 22rpx; font-weight: 700; border-radius: 12rpx; background: var(--fc); color: #fffaf0; border: 2rpx solid transparent; box-sizing: border-box; }
.ta.on, .ta.ghost { background: transparent; color: var(--fg); border: 2rpx solid var(--line); font-weight: 500; }
.ta.ghost { color: var(--muted); }
.credits { border-top: 2rpx solid var(--line-soft); }
.cr { display: flex; gap: 32rpx; padding: 18rpx 0; border-bottom: 2rpx solid var(--line-soft); font-size: 26rpx; }
.ck { flex: none; width: 110rpx; color: var(--muted); }
.cv { flex: 1; min-width: 0; }
.st { display: flex; align-items: baseline; gap: 16rpx; margin: 56rpx 0 20rpx; padding-bottom: 14rpx; border-bottom: 4rpx solid var(--fg); }
.stt { font-size: 40rpx; font-weight: 900; }
.ste { margin-left: auto; font-size: 18rpx; letter-spacing: 6rpx; color: var(--muted); }
.p { font-size: 30rpx; line-height: 1.85; margin-bottom: 20rpx; }
.syn.clamp { max-height: 340rpx; overflow: hidden; -webkit-mask-image: linear-gradient(#000 55%, transparent); }
.more { font-size: 26rpx; font-weight: 700; color: var(--accent); padding: 8rpx 0; }
.hl { display: flex; gap: 24rpx; padding: 28rpx; margin-bottom: 16rpx; }
.hn { font-size: 52rpx; font-weight: 900; color: var(--fc); line-height: 1; }
.hx { flex: 1; font-size: 28rpx; line-height: 1.75; }
.ho { display: flex; align-items: baseline; gap: 18rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--line-soft); }
.ht { flex: none; font-size: 20rpx; font-weight: 700; padding: 2rpx 12rpx; border-radius: 8rpx; border: 2rpx solid var(--line); color: var(--muted); }
.ho.win .ht { background: var(--fc); border-color: var(--fc); color: #fffaf0; }
.ho.nom .ht { border-color: var(--fc); color: var(--fc); }
.ho.list .ht { border-color: var(--teal); color: var(--teal); }
.hy { flex: none; width: 80rpx; font-size: 24rpx; color: var(--muted); }
.hb { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ha { font-size: 27rpx; font-weight: 600; }
.hbb { font-size: 24rpx; color: var(--muted); }
.dc { padding: 32rpx; }
.dh { display: flex; align-items: center; gap: 24rpx; margin-bottom: 20rpx; }
.av { width: 100rpx; height: 100rpx; border-radius: 50%; background: var(--fc); color: #fffaf0; display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 900; }
.dn { font-size: 32rpx; font-weight: 700; }
.ds { font-size: 22rpx; color: var(--muted); }
.ctx { padding-left: 36rpx; border-left: 6rpx solid var(--fc); }
.nav { display: flex; gap: 16rpx; margin-top: 60rpx; }
.nb { flex: 1; min-width: 0; }
.nbi { display: flex; align-items: center; gap: 18rpx; padding: 18rpx; border-radius: 24rpx; border: 2rpx solid var(--line); background: var(--surface); }
.nb.r .nbi { flex-direction: row-reverse; text-align: right; }
.nbi image { width: 72rpx; height: 108rpx; border-radius: 6rpx; flex: none; }
.nbt { min-width: 0; display: flex; flex-direction: column; }
.nbt .b { font-size: 26rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.share { width: 100%; margin-top: 32rpx !important; }
.noshow { display: flex; flex-direction: column; gap: 6rpx; padding: 24rpx; border-style: dashed; }

.gift { padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.gl { display: inline-block; font-size: 22rpx; font-weight: 600; color: var(--accent); border: 2rpx solid var(--accent); border-radius: 8rpx; padding: 2rpx 12rpx; margin-bottom: 16rpx; }
.gis { display: flex; flex-wrap: wrap; gap: 12rpx; }
.gi { font-size: 26rpx; padding: 10rpx 18rpx; border-radius: 14rpx; background: var(--chip, #e5d8bf); }
.gnote { display: block; margin-top: 4rpx; }

/* 映后交流 */
.qapanel { padding: 24rpx 28rpx; border: 4rpx dashed var(--teal); border-radius: 24rpx; background: rgba(47, 111, 108, .08); color: var(--teal); }
.qapanel.qa-empty { border-color: var(--line); background: transparent; color: var(--muted); }
.qap-h { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.qap-l { font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.qap-t { font-size: 28rpx; font-weight: 700; }
.qap-b { display: block; margin-top: 8rpx; font-size: 28rpx; line-height: 1.6; }

/* 我的观影：看过 + 五星十分制 */
.mr { margin-top: 28rpx; padding: 24rpx 28rpx; }
.mr-h { display: flex; align-items: baseline; gap: 14rpx; margin-bottom: 18rpx; }
.mr-t { font-size: 30rpx; font-weight: 900; }
.mr-en { font-size: 18rpx; letter-spacing: 4rpx; color: var(--muted); }
.mr-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx 18rpx; }
.mr-rate { flex: 1 1 300rpx; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.mr-seen { flex: none; max-width: 100%; box-sizing: border-box; white-space: nowrap; height: 68rpx; padding: 0 24rpx; display: flex; align-items: center; border-radius: 16rpx; border: 3rpx solid var(--accent); color: var(--accent); font-size: 26rpx; font-weight: 700; }
.mr.on .mr-seen { background: var(--accent); color: #fffaf0; }
.mr-stars { display: flex; flex: none; }
.mr-star { position: relative; width: 50rpx; height: 50rpx; font-size: 46rpx; line-height: 50rpx; text-align: center; }
.mr-star .s0 { color: var(--line); }
.mr-star .s1 { position: absolute; left: 0; top: 0; height: 100%; overflow: hidden; color: #c8862a; }
.mr-star .s1 text { display: block; width: 50rpx; text-align: center; }
.mr-star .hz { position: absolute; top: -12rpx; bottom: -12rpx; width: 50%; }
.mr-star .hz.l { left: 0; } .mr-star .hz.r { right: 0; }
.mr-score { flex: none; min-width: 84rpx; text-align: right; font-size: 20rpx; color: var(--muted); }
.mr-score.has { font-size: 30rpx; font-weight: 700; color: #c8862a; }
.mr-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 20rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 2rpx dashed var(--line); font-size: 22rpx; color: var(--muted); }
.mr-date { padding: 6rpx 14rpx; border-radius: 10rpx; border: 2rpx solid var(--line); background: var(--bg); color: var(--fg); }
.mr-go { margin-left: auto; color: var(--accent); white-space: nowrap; }
.mr-at { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mr-tip { display: block; margin-top: 16rpx; font-size: 22rpx; color: var(--muted); line-height: 1.6; }

.evtag { display: inline-block; font-size: 20rpx; font-weight: 700; line-height: 32rpx; padding: 0 14rpx; margin-right: 12rpx; border-radius: 99rpx; background: #ffe94a; color: #2b2110; vertical-align: 2rpx; }

.tvrow { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.tmap { font-size: 22rpx; font-weight: 700; color: var(--accent); padding: 4rpx 14rpx; border: 2rpx solid var(--accent); border-radius: 99rpx; }

.part { border-top: 2rpx solid var(--line-soft); padding: 18rpx 0; display: flex; flex-direction: column; gap: 6rpx; }
.pn { font-size: 29rpx; font-weight: 700; }
.ps { font-size: 23rpx; color: var(--muted); }
.pd { font-size: 26rpx; line-height: 1.75; }

.content-note{font-size:24rpx;line-height:1.8;margin-bottom:30rpx}.content-note>text{display:block}.content-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-bottom:15rpx}.content-tags>text{font-size:23rpx;border:1rpx solid var(--line);border-radius:8rpx;padding:5rpx 12rpx;color:var(--accent)}.content-note .small{font-size:22rpx;color:var(--muted);margin-top:12rpx}

/* Match the surrounding screening and post-screening cards. */
.content-note{box-sizing:border-box;width:100%;padding:30rpx;border:2rpx solid var(--line);border-radius:24rpx;background:var(--surface);font-size:26rpx;line-height:1.9}
.content-tags{gap:10rpx 18rpx;margin-bottom:18rpx}.content-tags>text{border:0;border-radius:0;padding:0;color:var(--fg);font-size:26rpx}.content-note .small{font-size:24rpx;line-height:1.9;margin-top:20rpx}
