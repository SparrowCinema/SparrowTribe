<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view wx:if="{{homeTip}}" class="home-tip" catchtap="homeTipGo"><view class="home-tip-arrow" /><text class="home-tip-i">⌂</text><view class="home-tip-copy"><text class="home-tip-t">{{i.__en?'More films & schedules':'更多影片与排片'}}</text><text class="home-tip-s">{{i.__en?'Tap Home at top left':'点左上角「主页」查看'}}</text></view><text class="home-tip-x" catchtap="homeTipClose">×</text></view>
<view wx:if="{{f}}" style="--fc:{{f.color}}">
  <view class="hero">
    <image wx:if="{{f.poster}}" class="bg" src="{{f.poster}}" mode="aspectFill" />
    <view class="shade" />
    <view class="hin">
      <view class="progrow" wx:for="{{f.progs}}" wx:key="id"><view class="prog" data-id="{{item.id}}" bindtap="openProg">{{item.kind}} · {{item.name}} ›</view><view wx:if="{{item.section}}" class="unit"><text class="ud">◆</text>{{item.section}}</view></view>
      <view class="hrow">
      <image wx:if="{{f.poster}}" id="hero-pst" class="pst" src="{{f.poster}}" mode="aspectFill" />
      <view class="tt" id="hero-tt">
        <view class="eyebrow mono"><text class="reg">{{f.reg}}</text><text class="eyc">{{f.y}} · {{f.c}}</text></view>
        <view class="h1" style="font-size:calc({{29.7*fs}} * var(--fr))">{{f.cn}}</view>
        <view wx:if="{{f.cnDb}}" class="native" style="font-size:calc({{16.5*fs}} * var(--fr))">{{L.t(i,'豆瓣译名')}} {{f.cnDb}}</view>
        <view class="en" style="font-size:calc({{17.6*fs}} * var(--fr))">{{f.en}}</view>
        <view wx:if="{{f.o}}" class="native" style="font-size:calc({{16.5*fs}} * var(--fr))">{{L.t(i,'原名')}} {{f.o}}</view>
        <view class="tags" style="font-size:calc({{fs<0.8?17:20}} * var(--fr))">
          <text wx:if="{{f.version}}" class="tg ed2">{{f.version}}</text>
          <text wx:if="{{f.minText}}" class="tg">{{f.minText}}</text>
          <text wx:if="{{f.lang}}" class="tg">{{f.lang}}</text>
          <text wx:for="{{f.genre}}" wx:key="*this" class="tg">{{item}}</text>
        </view>
        <view wx:if="{{!f.ev}}" class="hero-acts"><button class="ha" open-type="share" hover-class="ha-hv"><image class="ha-i" src="/images/menu/share-w.svg" mode="aspectFit" />{{L.t(i,'分享影片')}}</button><button class="ha" bindtap="sharePoster" hover-class="ha-hv"><image class="ha-i" src="/images/menu/poster-w.svg" mode="aspectFit" />{{L.t(i,'分享海报')}}</button></view>
      </view>
      </view>
      <view wx:if="{{!mine.seen}}" class="mr-seen mr-seen-full" hover-class="hv" bindtap="toggleSeen">{{mine.seenTxt}}</view>
      <view class="mrc">
        <view class="mrc-rate"><view class="mrc-k"><text>{{i.__en?'My rating':'我的评分'}}</text><text wx:if="{{mine.n > 1}}" class="mrc-ks">{{i.__en?'latest':'最近一次'}}</text></view>
          <view class="mr-stars"><view wx:for="{{mine.stars}}" wx:key="index" class="mr-star"><text class="s0">★</text><view class="s1" style="width:{{item}}%"><text>★</text></view><view class="hz l" data-v="{{index * 2 + 1}}" bindtap="rate" /><view class="hz r" data-v="{{index * 2 + 2}}" bindtap="rate" /></view></view>
          <text class="mr-score mono {{mine.r ? 'has' : ''}}">{{mine.scoreTxt}}</text></view>
        <view class="ts-row sep" hover-class="hv" bindtap="openTaste" role="button" aria-haspopup="dialog">
        <text class="ts-row-k">{{i.__en?'Taste':'趣味'}}</text>
        <view wx:if="{{tsRow.mine}}" class="ts-mine"><text>{{i.__en?'Fun':'有趣'}} </text><text class="ts-n mono">{{tsRow.fun}}</text><text class="ts-gap">{{i.__en?'Boring':'无聊'}} </text><text class="ts-n mono">{{tsRow.bore}}</text></view>
        <text wx:else class="{{mine.seen?'ts-cta':'ts-muted'}}">{{mine.seen?(i.__en?'Rate interesting and boring':'给有趣度、无聊度打分'):(i.__en?'Rate it after watching':'看过后可以评有趣度、无聊度')}}</text>
        <text class="ts-comm">{{tsRow.comm}}</text><text class="ts-go">›</text>
        </view>
        <block wx:if="{{mine.seen}}">
          <view wx:for="{{mine.diary}}" wx:key="i" class="dy-row sep" hover-class="hv" data-i="{{item.i}}" bindtap="lgOpen">
            <view class="dy-d"><text class="dy-md mono">{{item.md}}</text><text class="dy-y mono">{{item.y}}</text></view>
            <view class="dy-m"><text class="dy-l1 {{item.l1Nil ? 'nil' : ''}}">{{item.l1}}</text><text wx:if="{{item.l2}}" class="dy-l2">{{item.l2}}</text></view>
            <view wx:if="{{mine.n > 1}}" class="dy-s"><text class="dy-sb {{item.rNil ? 'nil' : ''}}">{{item.rs}}</text><text wx:if="{{item.tag}}" class="dy-st">{{item.tag}}</text></view>
            <text class="dy-go">›</text>
          </view>
          <view wx:if="{{mine.dyFold}}" class="dy-more sep" hover-class="hv" bindtap="dyToggle"><text>{{mine.dyMoreTxt}}</text><text class="dy-mi">{{mine.dyOpen ? '▴' : '▾'}}</text></view>
          <view class="dy-add sep" hover-class="hv" bindtap="lgOpen">＋ {{i.__en?'Log another viewing':'再看一次'}}</view>
        </block>
      </view>
      <text wx:if="{{!mine.seen}}" class="mr-tip">{{L.t(i,'看过后会在「我的 → 观影护照」盖下这部电影的印章；评分为五星十分制，可打半颗星。')}}</text>
    </view>

    <view class="sec-h">{{L.t(i,'放映场次')}} <text class="muted small">{{cnt}}</text></view>
    <view wx:if="{{sf.show}}" class="sf-bar" style="grid-template-columns:repeat({{sf.hasD && sf.hasV ? 2 : 1}},minmax(0,1fr))"><view wx:if="{{sf.hasD}}" class="sf-cell {{sf.dOn?'active':''}}" data-type="date" bindtap="sfOpen"><text class="sf-label">{{L.t(i,'放映日期')}}</text><view class="sf-value"><text class="sf-v">{{sf.dText}}</text><text class="sf-arrow">⌄</text></view></view><view wx:if="{{sf.hasV}}" class="sf-cell {{sf.vOn?'active':''}}" data-type="venue" bindtap="sfOpen"><text class="sf-label">{{L.t(i,'影院')}}</text><view class="sf-value"><text class="sf-v">{{sf.vText}}</text><text class="sf-arrow">⌄</text></view></view></view>
    <view wx:if="{{sf.filtered}}" class="sf-note">{{L.t(i,'已筛选')}} <text class="mono b">{{shows.length}} / {{sfAll}}</text> {{L.t(i,'场')}} · <text class="sf-clear" bindtap="sfTap">{{L.t(i,'清除')}}</text></view>
    <view wx:if="{{sf.filtered && !shows.length}}" class="noshow card"><text class="b">{{L.t(i,'所选日期和影院暂无场次')}}</text><text class="sf-clear" bindtap="sfTap">{{L.t(i,'清除筛选')}}</text></view>
    <view wx:if="{{!shows.length && !sf.filtered}}" class="noshow card"><text class="b">{{ended ? L.t(i,'本片场次已全部放映结束') : (f.release || L.t(i,'上映信息待公布'))}}</text><text class="muted small">{{ended ? L.t(i,'已放映的场次不再显示在这里。') : L.t(i,'场次公布后会更新到这里，也可以先在各影院售票平台查看。')}}</text></view>
    <view wx:for="{{shows}}" wx:key="key" class="ticket card">
      <view class="td" style="background:{{item.tone.bg}};color:{{item.tone.ink}};border-right:calc(2 * var(--r)) solid {{item.tone.line}}"><text class="tm">{{item.mon}}</text><text class="tdd mono">{{item.dd}}</text><text class="tw">{{item.wk}}</text></view>
      <view class="tb">
        <view class="ttime mono"><text class="b">{{item.t}}</text> – {{item.end}}</view>
        <view class="tvrow"><text class="tv">{{item.venue}}</text><text wx:if="{{item.geo}}" class="tmap" data-v="{{item.vid}}" bindtap="openMap">📍 {{L.t(i,'地图')}}</text></view>
        <text class="thall">{{item.hall}}</text><text wx:if="{{item.progTag}}" class="thall">{{item.progTag}}</text>
        <view wx:if="{{item.note}}" class="muted"><text wx:if="{{item.ev}}" class="evtag">{{L.t(i,'映后活动')}}</text>{{item.ev ? item.noteRest : item.note}}</view><view class="tact">
          <view class="ta {{item.picked?'on':''}}" data-key="{{item.key}}" bindtap="toggle">{{item.picked ? L.t(i,'✓ 已加入排片') : L.t(i,'+ 加入排片')}}</view>
          <view class="ta ghost" data-key="{{item.key}}" bindtap="calendar">{{L.t(i,'加入日历')}}</view>
          <view class="ta ghost" data-d="{{item.d}}" bindtap="seeDay">{{L.t(i,'看当天排片')}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{goneShows.length}}" class="gs-h" hover-class="hv" bindtap="toggleGone"><text>{{L.t(i,'已放映')}} {{goneN}}</text><text class="gs-ar {{goneOpen ? 'open' : ''}}">▾</text></view>
    <block wx:if="{{goneShows.length && goneOpen}}"><scroll-view wx:for="{{goneShows}}" wx:key="key" class="gs-row" scroll-x="{{true}}" show-scrollbar="{{false}}"><view class="gs-line"><text class="gs-d mono">{{item.d}}</text><text class="gs-t mono">{{item.t}}</text><text class="gs-p">{{item.place}}</text></view></scroll-view></block>

    <view class="sec-h">{{L.t(i,'内容提示')}}</view><view class="content-note"><view class="content-tags"><text wx:for="{{f.warnings}}" wx:key="*this">{{item}}</text></view><text>{{f.contentNote}}</text><text class="small">{{f.sensory?L.t(i,'已查到闪烁影像提示；光敏观众请谨慎选择。'):L.t(i,'闪烁与突发音量尚未核实；有需要请提前询问影院。')}}</text></view>
    <view class="sec-h">{{L.t(i,'映后交流')}} <text class="muted small">POST-SCREENING</text></view>
    <view wx:if="{{!f.ev}}" class="qapanel {{qa ? '' : 'qa-empty'}}">
      <view class="qap-h"><text class="qap-l">✦ {{qa ? L.t(i,'映后交流 · DIRECTOR Q&A') : L.t(i,'映后信息')}}</text><text wx:if="{{qa}}" class="qap-t mono">{{qa.label}}</text></view>
      <text class="qap-b">{{qa ? qa.guest : L.t(i,'暂无映后交流安排')}}</text>
    </view>

    <view class="sec-h">{{L.t(i,'伴手礼周边')}}</view>
    <view wx:if="{{!f.gifts.length}}" class="noshow card"><text class="b">{{L.t(i,'伴手礼信息待公布')}}</text><text class="muted small">{{L.t(i,'公布后会更新到这里。')}}</text></view>
    <view wx:for="{{f.gifts}}" wx:key="k" class="gift card">
      <text wx:if="{{item.label}}" class="gl">{{item.label}}</text>
      <view class="gis"><text wx:for="{{item.items}}" wx:for-item="it" wx:key="*this" class="gi">{{it}}</text></view>
    </view>
    <text wx:if="{{f.gifts.length}}" class="muted small gnote">{{L.t(i,'数量有限，以影院现场发放为准。')}}</text>

    <view class="sec-h">{{L.t(i,'影片信息')}}</view>
    <view class="credits">
      <view wx:for="{{credits}}" wx:key="k" class="cr"><text class="ck">{{item.k}}</text><text class="cv">{{item.v}}</text></view>
    </view>

    <block wx:if="{{parts.length}}">
      <view class="sec-h">{{L.t(i,'收录短片')}}</view>
      <view wx:for="{{parts}}" wx:key="n" class="part"><text class="pn">{{item.n}}</text><text class="ps">{{item.sub}}</text><text wx:if="{{item.dir}}" class="ps">{{L.t(i,'导演')}}：{{item.dir}}</text><text wx:if="{{item.src}}" class="ps">{{L.t(i,'影片版权')}}：{{item.src}}</text><text wx:if="{{item.syn}}" class="pd">{{item.syn}}</text><text wx:if="{{item.bio}}" class="pd">{{L.t(i,'导演介绍')}}：{{item.bio}}</text><view wx:for="{{item.honors}}" wx:for-item="h" wx:key="a" class="ps">{{h.t}} {{h.yr}} {{h.a}} {{h.b}}</view></view>
    </block>
    <view class="st"><text class="stt">{{L.t(i,'剧情简介')}}</text><text class="ste mono">SYNOPSIS</text></view>
    <view class="syn {{f.long && !open ? 'clamp' : ''}}">
      <view wx:for="{{f.syn}}" wx:key="index" class="p">{{item}}</view>
    </view>
    <view wx:if="{{f.long}}" class="more" bindtap="more">{{open ? L.t(i,'收起') : L.t(i,'展开全文')}}</view>

    <block wx:if="{{f.highlights.length}}">
      <view class="st"><text class="stt">{{L.t(i,'荐片笔记')}}</text><text class="ste mono">CURATOR'S NOTES</text></view>
      <view wx:for="{{f.highlights}}" wx:key="n" class="hl card"><text class="hn">{{item.n}}</text><text class="hx">{{item.x}}</text></view>
    </block>

    <block wx:if="{{f.honors.length}}">
      <view class="st"><text class="stt">{{L.t(i,'影展与荣誉')}}</text><text class="ste mono">FESTIVALS {{'&'}} AWARDS</text></view>
      <view wx:for="{{f.honors}}" wx:key="index" class="ho {{item.cls}}">
        <text class="ht">{{item.t}}</text><text wx:if="{{item.yr}}" class="hy mono">{{item.yr}}</text>
        <view class="hb"><text class="ha">{{item.a}}</text><text wx:if="{{item.b}}" class="hbb">{{item.b}}</text></view>
      </view>
    </block>

    <view class="st"><text class="stt">{{L.t(i,'导演介绍')}}</text><text class="ste mono">DIRECTOR</text></view>
    <view class="dc card">
      <view class="dh"><view class="av">{{f.ini}}</view><view><view class="dn">{{f.dir}}</view><view wx:if="{{f.dirO && f.dirO !== f.dir}}" class="ds">{{f.dirO}}</view><view class="ds">{{f.dirLife}}</view></view></view>
      <view wx:for="{{f.bio}}" wx:key="index" class="p">{{item}}</view>
    </view>

    <view class="st"><text class="stt">{{L.t(i,'创作背景')}}</text><text class="ste mono">CONTEXT</text></view>
    <view class="ctx"><view wx:for="{{f.st}}" wx:key="index" class="p">{{item}}</view></view>

    <view wx:if="{{!f.ev}}" class="nav">
      <view wx:for="{{nav}}" wx:key="index" class="nb {{index===1?'r':''}}">
        <block wx:if="{{item}}">
          <view class="nbi" data-id="{{item.id}}" bindtap="openFilm">
            <image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFill" />
            <view class="nbt"><text class="muted small">{{index===0 ? L.t(i,'上一部') : L.t(i,'下一部')}}</text><text class="b">{{item.cn}}</text></view>
          </view>
        </block>
      </view>
    </view>
    <button wx:if="{{f.ev}}" class="btn ghost share" open-type="share">{{L.t(i,'分享这部影片')}}</button>
  </view>
</view>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>

<page-container show="{{tsShow || lgShow}}" position="bottom" round="{{true}}" z-index="1200" custom-style="background:transparent" overlay-style="background:rgba(24,16,8,0.45)" bind:afterleave="sheetLeave">
<block wx:if="{{tsShow}}">
  <view class="ts-sheet" style="{{ps}}">
    <view class="ts-grab" />
    <view class="ts-head"><view><text class="ts-kicker">TASTE · {{f.cn}}</text><text class="ts-title">{{i.__en?'Interesting or boring?':'这部电影，有趣还是无聊？'}}</text></view><view class="ts-x" bindtap="closeTaste" aria-label="{{i.__en?'Close':'关闭'}}" role="button">×</view></view>
    <scroll-view scroll-y class="ts-body">
      <block wx:if="{{mine.seen}}">
        <view wx:for="{{taste}}" wx:key="key" class="taste-row">
          <view class="taste-caption"><text>{{item.key==='fun'?(i.__en?'Interesting':'有趣度'):(i.__en?'Boring':'无聊度')}}</text><text class="taste-description">{{item.key==='fun'?(i.__en?'How captivating?':'有多让你着迷？'):(i.__en?'How often did you feel bored?':'观看时多经常感到乏味？')}}</text></view>
          <view class="taste-stars">
            <text class="taste-zero {{item.value===0?'selected':''}}" data-k="{{item.key}}" data-n="0" bindtap="tasteRate">0</text>
            <view class="mr-stars taste-stars-row"><view wx:for="{{item.stars}}" wx:for-item="st" wx:key="n" class="mr-star"><text class="s0">★</text><view class="s1" style="width:{{st.fill}}%"><text>★</text></view><view class="hz l" data-k="{{item.key}}" data-n="{{st.n - 0.5}}" bindtap="tasteRate" /><view class="hz r" data-k="{{item.key}}" data-n="{{st.n}}" bindtap="tasteRate" /></view></view>
            <text class="taste-result mono"><block wx:if="{{item.value===null}}"><text class="tr-nil">{{i.__en?'Not rated':'未评'}}</text></block><block wx:else><text class="tr-v">{{item.value}}</text>/5</block></text>
          </view>
        </view>
        <text class="taste-hint">{{i.__en?'0 = not at all (different from not rated) · Tap the same score to clear · Both can be high':'0 = 完全没有，与「未评」不同 · 再点相同分数可取消 · 两项可以同时很高'}}</text>
      </block>
      <view wx:else class="ts-unseen"><text>{{i.__en?'Mark it watched to rate how interesting and how boring it was.':'标记看过后，就能给这部电影的有趣度和无聊度打分。'}}</text><view class="ts-unseen-btn" hover-class="hv" bindtap="toggleSeen">＋ {{i.__en?'Watched':'看过'}}</view></view>
      <view class="community-card"><text class="community-title">{{i.__en?'Community':'影迷社区'}}<text class="taste-sub"> COMMUNITY</text></text><view class="community-values"><view><text class="cv-label">{{i.__en?'Interesting':'有趣度'}}</text><view class="cv-val"><block wx:if="{{community.fun.avg}}"><view class="cv-stars"><view wx:for="{{community.fun.stars}}" wx:for-item="p" wx:key="index" class="cv-star"><text class="s0">★</text><view class="s1" style="width:{{p}}%"><text>★</text></view></view></view><text class="cv-avg mono">{{community.fun.avg}}<text class="cv-of">/5</text></text></block><text wx:else class="cv-low">{{community.fun.low}}</text></view><text>{{community.fun.n}} {{i.__en?'ratings':'人评价'}}</text></view><view><text class="cv-label">{{i.__en?'Boring':'无聊度'}}</text><view class="cv-val"><block wx:if="{{community.bore.avg}}"><view class="cv-stars"><view wx:for="{{community.bore.stars}}" wx:for-item="p" wx:key="index" class="cv-star"><text class="s0">★</text><view class="s1" style="width:{{p}}%"><text>★</text></view></view></view><text class="cv-avg mono">{{community.bore.avg}}<text class="cv-of">/5</text></text></block><text wx:else class="cv-low">{{community.bore.low}}</text></view><text>{{community.bore.n}} {{i.__en?'ratings':'人评价'}}</text></view></view><text class="community-note">{{communityError?(i.__en?'Community unavailable. Personal ratings are saved locally.':'社区评分暂不可用；个人评分已保存在本机。'):(i.__en?'Each is counted separately; the average shows from 3 ratings.':'两项独立统计，各自满 3 人评价后显示平均星级。')}}</text><view wx:if="{{community.eligible}}" class="ts-share" role="switch" aria-checked="{{community.published}}" data-action="{{community.published?'withdraw':'publish'}}" bindtap="communityAction"><view class="ts-share-copy"><text class="ts-share-t">{{i.__en?'Share with the community':'公开到影迷社区'}}</text><text class="ts-share-s">{{community.published?(community.pending?(i.__en?'Pending upload; retries when online':'等待上传，联网后自动重试'):(i.__en?'Shared · edits replace your vote':'已公开 · 修改评分会替换原票')):(i.__en?'Only the two scores are pooled; dates, venues, names and photos stay private':'只汇总两项分数；日期、影院、姓名和照片不公开')}}</text></view><view class="ts-switch {{community.published?'on':''}}"><view class="ts-knob" /></view></view><text wx:elif="{{mine.seen}}" class="cs-hint">{{i.__en?'Rate first, then choose whether to share.':'评分后可以选择公开到社区。'}}</text><button wx:if="{{community.pending}}" class="community-button" data-action="retry" bindtap="communityAction">{{i.__en?'Pending upload · Retry':'等待上传 · 重试'}}</button></view>
    </scroll-view>
    <view class="ts-foot"><text class="ts-link" bindtap="toTasteMap">{{i.__en?'My taste map':'我的趣味图谱'}} ›</text><view class="ts-done" hover-class="hv" bindtap="closeTaste">{{i.__en?'Done':'完成'}}</view></view>
  </view>
</block>
<block wx:if="{{lgShow}}">
  <view class="ts-sheet" style="{{ps}}">
    <view class="ts-grab" />
    <view class="ts-head"><view><text class="ts-kicker">DIARY · {{f.cn}}</text><text class="ts-title">{{lg.title}}</text></view><view class="ts-x" bindtap="lgClose" aria-label="{{i.__en?'Close':'关闭'}}" role="button">×</view></view>
    <scroll-view scroll-y class="ts-body">
      <view class="mr-list dy-form">
        <picker mode="date" value="{{lg.d}}" end="{{lg.today}}" bindchange="lgDate"><view class="mr-li" hover-class="hv"><text class="mr-k">{{L.t(i,'观影日期')}}</text><text class="mr-v mono">{{lg.dShow}}</text><text class="mr-dd">▾</text></view></picker>
        <picker wx:if="{{lg.hasPast}}" mode="selector" range="{{lg.shows}}" value="{{lg.showIdx}}" bindchange="lgPick"><view class="mr-li sep" hover-class="hv"><text class="mr-k">{{L.t(i,'放映场次')}}</text><text class="mr-v {{lg.atNil ? 'nil' : ''}}">{{lg.at}}</text><text class="mr-dd">▾</text></view></picker>
        <view wx:else class="mr-li sep static"><text class="mr-k">{{L.t(i,'放映场次')}}</text><text class="mr-v nil">{{lg.at}}</text></view>
        <picker mode="multiSelector" range="{{lg.fmt.cols}}" value="{{lg.fmt.val}}" bindchange="setFmt" bindcolumnchange="fmtCol"><view class="mr-li sep" hover-class="hv"><text class="mr-k">{{L.t(i,'放映版本')}}<text class="mr-opt">{{i.__en?'optional':'可选'}}</text></text><text class="mr-v {{lg.fmt.on ? '' : 'nil'}}">{{lg.fmt.txt}}</text><text class="mr-dd">▾</text></view></picker>
      </view>
      <view class="dy-rate"><text class="mr-k">{{i.__en?'Rating':'这一次的评分'}}</text>
        <view class="mr-stars"><view wx:for="{{lg.stars}}" wx:key="index" class="mr-star"><text class="s0">★</text><view class="s1" style="width:{{item}}%"><text>★</text></view><view class="hz l" data-v="{{index * 2 + 1}}" bindtap="lgRate" /><view class="hz r" data-v="{{index * 2 + 2}}" bindtap="lgRate" /></view></view>
        <text class="mr-score mono {{lg.r ? 'has' : ''}}">{{lg.scoreTxt}}</text></view>
    </scroll-view>
    <view class="ts-foot"><text wx:if="{{lg.delTxt}}" class="dy-del" bindtap="lgDel">{{lg.delTxt}}</text><text wx:else /><view class="ts-done" hover-class="hv" bindtap="lgSave">{{i.__en?'Save':'保存'}}</view></view>
  </view>
</block>
</page-container>

<canvas type="2d" id="share-canvas" class="share-canvas" />

<view wx:if="{{sfSel}}" class="sel-mask" catchtap="sfClose" catchtouchmove="sfStop" style="{{ps}}">
  <view class="sel-panel" catchtap="sfStop"><view class="sel-head"><text>{{sfTitle}}</text><view class="sel-close" bindtap="sfClose">×</view></view>
    <input class="sel-search" placeholder="{{sfPh}}" value="{{sfQ}}" bindinput="sfSearch" />
    <scroll-view scroll-y class="sel-results"><view wx:for="{{sfRowsV}}" wx:key="id" class="sel-option {{item.selected?'on':''}}" data-id="{{item.id}}" bindtap="sfPick"><view class="sel-copy"><text class="b">{{item.name}}</text><text class="small muted">{{item.sub}}</text></view><text class="sel-check {{item.selected?'on':''}}">{{item.selected?'✓':''}}</text></view><view wx:if="{{!sfRowsV.length}}" class="sel-empty">{{L.t(i,'没有匹配的结果')}}</view></scroll-view>
    <view class="sel-foot"><text>{{L.t(i,'可多选')}}</text><view class="sel-done" bindtap="sfClose">{{L.t(i,'完成')}}</view></view>
  </view>
</view>
