<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view wx:if="{{f}}" style="--fc:{{f.color}}">
  <view class="hero">
    <image wx:if="{{f.poster}}" class="bg" src="{{f.poster}}" mode="aspectFill" />
    <view class="shade" />
    <view class="hin">
      <view class="progrow" wx:for="{{f.progs}}" wx:key="id"><view class="prog" data-id="{{item.id}}" bindtap="openProg">{{item.kind}} · {{item.name}} ›</view><view wx:if="{{item.section}}" class="unit"><text class="ud">◆</text>{{item.section}}</view></view>
      <view class="hrow">
      <image wx:if="{{f.poster}}" id="hero-pst" class="pst" src="{{f.poster}}" mode="aspectFill" />
      <view class="tt" id="hero-tt">
        <view class="eyebrow mono"><text class="reg">{{f.reg}}</text><text class="eyc">{{f.y}} · {{f.c}}</text></view>
        <view class="h1" style="font-size:calc({{44*fs}} * var(--r))">{{f.cn}}</view>
        <view wx:if="{{f.cnDb}}" class="native" style="font-size:calc({{22*fs}} * var(--r))">{{L.t(i,'豆瓣译名')}} {{f.cnDb}}</view>
        <view class="en" style="font-size:calc({{24*fs}} * var(--r))">{{f.en}}</view>
        <view wx:if="{{f.o}}" class="native" style="font-size:calc({{22*fs}} * var(--r))">{{L.t(i,'原名')}} {{f.o}}</view>
        <view class="tags" style="font-size:calc({{fs<0.8?17:20}} * var(--r))">
          <text wx:if="{{f.version}}" class="tg ed2">{{f.version}}</text>
          <text class="tg">{{f.minText}}</text>
          <text class="tg">{{f.lang}}</text>
          <text wx:for="{{f.genre}}" wx:key="*this" class="tg">{{item}}</text>
        </view>
      </view>
      </view>
    </view>
  </view>

  <view class="wrap">
    <!-- 购票：醒目位置 -->
    <view wx:for="{{tickets}}" wx:key="url" class="buy">
      <view class="buyt">
        <text class="bk mono">BOOK YOUR SEAT{{item.prog ? ' · ' + item.prog : ''}}</text>
        <text class="bh">{{L.t(i,'银幕见')}}</text>
        <text class="bs">{{item.hint || L.t(i,'长按右侧小程序码，选择「识别小程序码」即可')}}</text>
        <view class="bx" hover-class="hv" data-k="{{index}}" bindtap="previewTicket">{{i.__en ? item.label + ' code ↗' : '查看' + item.label + '码 ↗'}}</view>
      </view>
      <image class="qr" src="{{item.url}}" mode="aspectFit" show-menu-by-longpress />
    </view>

    <view wx:if="{{!f.ev}}" class="ratings card">
      <view wx:for="{{ratings}}" wx:key="l" class="rt {{item.na?'na':''}}">
        <text class="rl">{{item.l}}</text>
        <text class="rv mono">{{item.v}}</text>
        <view class="rb"><view class="ri" style="width:{{item.pct}}%" /></view>
      </view>
    </view>

    <view wx:if="{{!f.ev}}" class="mr card {{mine.seen ? 'on' : ''}}">
      <view class="mr-h"><text class="mr-t">{{L.t(i,'我的观影')}}</text><text class="mr-en mono">MY FILM PASSPORT</text></view>
      <view class="mr-row">
        <view class="mr-seen" hover-class="hv" bindtap="toggleSeen">{{mine.seenTxt}}</view>
        <view class="mr-rate"><view class="mr-stars">
          <view wx:for="{{mine.stars}}" wx:key="index" class="mr-star">
            <text class="s0">★</text><view class="s1" style="width:{{item}}%"><text>★</text></view>
            <view class="hz l" data-v="{{index * 2 + 1}}" bindtap="rate" /><view class="hz r" data-v="{{index * 2 + 2}}" bindtap="rate" />
          </view>
        </view>
        <text class="mr-score mono {{mine.r ? 'has' : ''}}">{{mine.scoreTxt}}</text></view>
      </view>
      <block wx:if="{{mine.seen && !mine.multi}}">
        <view class="mr-meta">
          <picker mode="date" value="{{mine.d}}" end="{{mine.today}}" bindchange="setSeenDate"><view class="mr-date">{{L.t(i,'观影日期')}} <text class="mono">{{mine.d}}</text> ▾</view></picker>
          <text class="mr-at">{{mine.at}}</text>
          <text class="mr-again" bindtap="rwAgain">＋ {{i.__en?'Watch again':'再看一次'}}</text>
          <text class="mr-go" bindtap="toMy">{{L.t(i,'查看护照 ›')}}</text>
        </view>
        <picker mode="multiSelector" range="{{mine.fmt.cols}}" value="{{mine.fmt.val}}" bindchange="setFmt" bindcolumnchange="fmtCol"><view class="mr-fmt"><text>{{L.t(i,'放映版本')}} <text class="muted">{{i.__en?'optional':'可选'}}</text></text><text class="mr-fv {{mine.fmt.on ? 'has' : ''}}">{{mine.fmt.txt}} ▾</text></view></picker>
      </block>
      <block wx:elif="{{mine.seen && mine.multi}}">
        <view class="rw-strip" bindtap="rwToggle"><view class="rw-dots"><view wx:for="{{mine.rw.dots}}" wx:key="*this" class="rw-dot" /><text wx:if="{{mine.rw.n > 10}}" class="rw-more mono">+{{mine.rw.n - 10}}</text></view><text class="rw-b">{{mine.rw.txt}}</text><text class="rw-sub">{{mine.rw.sub}}</text><text class="rw-tg">{{mine.rw.open ? (i.__en ? 'Hide ▴' : '收起 ▴') : (i.__en ? 'Show ▾' : '展开 ▾')}}</text></view>
        <view wx:if="{{mine.rw.open}}" class="rw-tl">
          <block wx:for="{{mine.rw.rows}}" wx:key="i">
            <view wx:if="{{!item.edit}}" class="rw-v {{item.last ? 'last' : ''}}" data-i="{{item.i}}" bindtap="rwEdit"><text class="rw-n mono">{{item.no}}</text><text class="rw-d">{{item.d}}</text><view class="rw-s"><text class="rw-sb {{item.r ? '' : 'nil'}}">{{item.rs}}</text><text wx:if="{{item.tag}}" class="rw-st">{{item.tag}}</text></view><text class="rw-f">{{item.line}}</text></view>
            <view wx:else class="rw-v edit">
              <view class="rw-eh"><text class="rw-n mono">{{item.no}}</text>
                <view class="mr-stars"><view wx:for="{{item.stars}}" wx:for-item="st" wx:for-index="k" wx:key="k" class="mr-star"><text class="s0">★</text><view class="s1" style="width:{{st}}%"><text>★</text></view><view class="hz l" data-v="{{k * 2 + 1}}" bindtap="rwRate" /><view class="hz r" data-v="{{k * 2 + 2}}" bindtap="rwRate" /></view></view></view>
              <view class="rw-fm">
                <picker mode="date" value="{{item.raw}}" end="{{mine.today}}" bindchange="rwDate"><view class="mr-date">{{item.raw}} ▾</view></picker>
                <picker mode="multiSelector" range="{{mine.fmt.cols}}" value="{{mine.fmt.val}}" bindchange="setFmt" bindcolumnchange="fmtCol"><view class="mr-fv {{mine.fmt.on ? 'has' : ''}}">{{mine.fmt.txt}} ▾</view></picker>
              </view>
              <view class="rw-act"><text class="rw-done" bindtap="rwDone">{{i.__en ? 'Done' : '完成'}}</text><text class="rw-del" data-i="{{item.i}}" bindtap="rwDel">{{i.__en ? 'Delete' : '删除这一次'}}</text></view>
            </view>
          </block>
          <view class="rw-add" bindtap="rwAgain">＋ {{i.__en ? 'Watch again' : '再看一次'}}</view>
        </view>
      </block>
      <text wx:else class="mr-tip">{{L.t(i,'看过后会在「我的 → 观影护照」盖下这部电影的印章；评分为五星十分制，可打半颗星。')}}</text>
    </view>

    <view class="sec-h">{{L.t(i,'放映场次')}} <text class="muted small">{{cnt}}</text></view>
    <view wx:if="{{!shows.length}}" class="noshow card"><text class="b">{{ended ? L.t(i,'本片场次已全部放映结束') : (f.release || L.t(i,'上映信息待公布'))}}</text><text class="muted small">{{ended ? L.t(i,'已放映的场次不再显示在这里。') : L.t(i,'场次公布后会更新到这里，也可以先在各影院售票平台查看。')}}</text></view>
    <view wx:for="{{shows}}" wx:key="key" class="ticket card">
      <view class="td" style="background:{{item.tone.bg}};color:{{item.tone.ink}};border-right:calc(2 * var(--r)) solid {{item.tone.line}}"><text class="tm">{{item.mon}}</text><text class="tdd mono">{{item.dd}}</text><text class="tw">{{item.wk}}</text></view>
      <view class="tb">
        <view class="ttime mono"><text class="b">{{item.t}}</text> – {{item.end}}</view>
        <view class="tvrow"><text class="tv">{{item.venue}}</text><text wx:if="{{item.geo}}" class="tmap" data-v="{{item.vid}}" bindtap="openMap">📍 {{L.t(i,'地图')}}</text></view>
        <text class="thall">{{item.hall}}</text><text wx:if="{{item.progTag}}" class="thall">{{item.progTag}}</text>
        <view wx:if="{{item.note}}" class="muted"><text wx:if="{{item.ev}}" class="evtag">{{L.t(i,'映后活动')}}</text>{{item.ev ? item.noteRest : item.note}}</view><view class="tact">
          <view class="ta {{item.picked?'on':''}}" data-key="{{item.key}}" bindtap="toggle">{{item.picked ? L.t(i,'✓ 已加入排片') : L.t(i,'+ 加入排片')}}</view>
          <view class="ta ghost" data-key="{{item.key}}" bindtap="calendar">{{L.t(i,'加入日历')}}</view>
          <view class="ta ghost" data-d="{{item.d}}" bindtap="seeDay">{{L.t(i,'看当天排片')}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{goneShows.length}}" class="gs-h" hover-class="hv" bindtap="toggleGone"><text>{{L.t(i,'已放映')}} {{goneN}}</text><text class="gs-ar {{goneOpen ? 'open' : ''}}">▾</text></view>
    <block wx:if="{{goneShows.length && goneOpen}}"><view wx:for="{{goneShows}}" wx:key="key" class="gs-row"><text class="gs-d mono">{{item.d}}</text><text class="gs-t mono">{{item.t}}–{{item.end}}</text><text class="gs-p">{{item.place}}</text></view></block>

    <view class="sec-h">{{L.t(i,'内容提示')}}</view><view class="content-note"><view class="content-tags"><text wx:for="{{f.warnings}}" wx:key="*this">{{item}}</text></view><text>{{f.contentNote}}</text><text class="small">{{f.sensory?L.t(i,'已查到闪烁影像提示；光敏观众请谨慎选择。'):L.t(i,'闪烁与突发音量尚未核实；有需要请提前询问影院。')}}</text></view>
    <view class="sec-h">{{L.t(i,'映后交流')}} <text class="muted small">POST-SCREENING</text></view>
    <view wx:if="{{!f.ev}}" class="qapanel {{qa ? '' : 'qa-empty'}}">
      <view class="qap-h"><text class="qap-l">✦ {{qa ? L.t(i,'映后交流 · DIRECTOR Q&A') : L.t(i,'映后信息')}}</text><text wx:if="{{qa}}" class="qap-t mono">{{qa.label}}</text></view>
      <text class="qap-b">{{qa ? qa.guest : L.t(i,'暂无映后交流安排')}}</text>
    </view>

    <view class="sec-h">{{L.t(i,'伴手礼周边')}}</view>
    <view wx:if="{{!f.gifts.length}}" class="noshow card"><text class="b">{{L.t(i,'伴手礼信息待公布')}}</text><text class="muted small">{{L.t(i,'公布后会更新到这里。')}}</text></view>
    <view wx:for="{{f.gifts}}" wx:key="k" class="gift card">
      <text wx:if="{{item.label}}" class="gl">{{item.label}}</text>
      <view class="gis"><text wx:for="{{item.items}}" wx:for-item="it" wx:key="*this" class="gi">{{it}}</text></view>
    </view>
    <text wx:if="{{f.gifts.length}}" class="muted small gnote">{{L.t(i,'数量有限，以影院现场发放为准。')}}</text>

    <view class="sec-h">{{L.t(i,'影片信息')}}</view>
    <view class="credits">
      <view wx:for="{{credits}}" wx:key="k" class="cr"><text class="ck">{{item.k}}</text><text class="cv">{{item.v}}</text></view>
    </view>

    <block wx:if="{{parts.length}}">
      <view class="sec-h">{{L.t(i,'收录短片')}}</view>
      <view wx:for="{{parts}}" wx:key="n" class="part"><text class="pn">{{item.n}}</text><text class="ps">{{item.sub}}</text><text wx:if="{{item.dir}}" class="ps">{{L.t(i,'导演')}}：{{item.dir}}</text><text wx:if="{{item.src}}" class="ps">{{L.t(i,'影片版权')}}：{{item.src}}</text><text wx:if="{{item.syn}}" class="pd">{{item.syn}}</text><text wx:if="{{item.bio}}" class="pd">{{L.t(i,'导演介绍')}}：{{item.bio}}</text><view wx:for="{{item.honors}}" wx:for-item="h" wx:key="a" class="ps">{{h.t}} {{h.yr}} {{h.a}} {{h.b}}</view></view>
    </block>
    <view class="st"><text class="stt">{{L.t(i,'剧情简介')}}</text><text class="ste mono">SYNOPSIS</text></view>
    <view class="syn {{f.long && !open ? 'clamp' : ''}}">
      <view wx:for="{{f.syn}}" wx:key="index" class="p">{{item}}</view>
    </view>
    <view wx:if="{{f.long}}" class="more" bindtap="more">{{open ? L.t(i,'收起') : L.t(i,'展开全文')}}</view>

    <block wx:if="{{f.highlights.length}}">
      <view class="st"><text class="stt">{{L.t(i,'荐片笔记')}}</text><text class="ste mono">CURATOR'S NOTES</text></view>
      <view wx:for="{{f.highlights}}" wx:key="n" class="hl card"><text class="hn">{{item.n}}</text><text class="hx">{{item.x}}</text></view>
    </block>

    <block wx:if="{{f.honors.length}}">
      <view class="st"><text class="stt">{{L.t(i,'影展与荣誉')}}</text><text class="ste mono">FESTIVALS {{'&'}} AWARDS</text></view>
      <view wx:for="{{f.honors}}" wx:key="index" class="ho {{item.cls}}">
        <text class="ht">{{item.t}}</text><text wx:if="{{item.yr}}" class="hy mono">{{item.yr}}</text>
        <view class="hb"><text class="ha">{{item.a}}</text><text wx:if="{{item.b}}" class="hbb">{{item.b}}</text></view>
      </view>
    </block>

    <view class="st"><text class="stt">{{L.t(i,'导演介绍')}}</text><text class="ste mono">DIRECTOR</text></view>
    <view class="dc card">
      <view class="dh"><view class="av">{{f.ini}}</view><view><view class="dn">{{f.dir}}</view><view wx:if="{{f.dirO && f.dirO !== f.dir}}" class="ds">{{f.dirO}}</view><view class="ds">{{f.dirLife}}</view></view></view>
      <view wx:for="{{f.bio}}" wx:key="index" class="p">{{item}}</view>
    </view>

    <view class="st"><text class="stt">{{L.t(i,'创作背景')}}</text><text class="ste mono">CONTEXT</text></view>
    <view class="ctx"><view wx:for="{{f.st}}" wx:key="index" class="p">{{item}}</view></view>

    <view wx:if="{{!f.ev}}" class="nav">
      <view wx:for="{{nav}}" wx:key="index" class="nb {{index===1?'r':''}}">
        <block wx:if="{{item}}">
          <view class="nbi" data-id="{{item.id}}" bindtap="openFilm">
            <image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFill" />
            <view class="nbt"><text class="muted small">{{index===0 ? L.t(i,'上一部') : L.t(i,'下一部')}}</text><text class="b">{{item.cn}}</text></view>
          </view>
        </block>
      </view>
    </view>
    <button class="btn ghost share" open-type="share">{{L.t(i,'分享这部影片')}}</button>
  </view>
</view>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>
