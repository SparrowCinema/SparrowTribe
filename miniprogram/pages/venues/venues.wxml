<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view wx:if="{{homeTip}}" class="home-tip" catchtap="homeTipGo"><view class="home-tip-arrow" /><text class="home-tip-i">⌂</text><view class="home-tip-copy"><text class="home-tip-t">{{i.__en?'More films & schedules':'更多影片与排片'}}</text><text class="home-tip-s">{{i.__en?'Tap Home at top left':'点左上角「主页」查看'}}</text></view><text class="home-tip-x" catchtap="homeTipClose">×</text></view>
<view wx:if="{{p}}" class="wrap">
  <view class="k mono">{{'VENUES & TRANSIT'}}</view>
  <view class="h1">{{L.t(i,'影院地图与交通')}}</view>
  <view class="sub">{{p.name}} · {{L.n(i, venueN, 'j')}}</view>

  <view wx:if="{{venueMap}}" class="vn-wrap">
    <map id="vn-map" class="vn-map" latitude="{{venueMap.lat}}" longitude="{{venueMap.lng}}" scale="{{venueMap.scale}}" markers="{{venueMap.markers}}" include-points="{{venueMap.points}}" enable-zoom="{{true}}" enable-scroll="{{true}}" bindmarkertap="onMarkerTap" bindcallouttap="onMarkerTap" />
    <view class="vn-cap">
      <text class="vn-hint">{{L.t(i,'点击编号定位对应影院 · 导航按实际路况打开地图')}}</text>
      <view wx:if="{{canReset}}" class="vn-reset" hover-class="hv" bindtap="resetMap">⌖ {{L.t(i,'重置视角')}}</view>
    </view>
  </view>

  <view wx:if="{{!venueRows.length}}" class="empty">
    <text class="eb">{{L.t(i,'暂无影院排片信息')}}</text>
  </view>
  <view wx:else class="vn-cards">
    <view wx:for="{{venueRows}}" wx:key="id" id="vc-{{item.domIdx}}" class="vn-card {{activeId === item.id ? 'hi' : ''}}">
      <view class="vn-ch">
        <view class="vn-idx mono {{activeId === item.id ? 'hi' : ''}}" data-id="{{item.id}}" bindtap="focusVenue">{{item.idx}}</view>
        <view class="vn-ct">
          <text class="vn-nm">{{item.name}}</text>
          <text wx:if="{{item.addr}}" class="vn-ad">{{item.addr}}</text>
        </view>
        <view wx:if="{{item.geo}}" class="vn-go" hover-class="hv" data-id="{{item.id}}" bindtap="openVenueMap">{{L.t(i,'地图导航')}} ↗</view>
      </view>
      <view class="vn-halls">
        <text wx:for="{{item.halls}}" wx:for-item="h" wx:key="name" class="vn-hall">{{h.name}}{{h.acc ? ' · ' + L.t(i,'无障碍') : ''}}</text>
        <text class="vn-cnt mono">{{item.cntText}}</text>
      </view>
      <view wx:if="{{item.trs.length}}" class="vn-tr">
        <view wx:for="{{item.trs}}" wx:for-item="tr" wx:key="k" class="vn-trl">
          <text class="vn-tk">{{tr.k}}</text>
          <text class="vn-tv">{{tr.v}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{transfers.length}}" class="vn-xfer">
    <view class="blockh">{{L.t(i,'跨影院转场参考')}} <text class="en">TRANSFERS</text></view>
    <view class="vn-xlist">
      <view wx:for="{{transfers}}" wx:key="key" class="vn-xrow">
        <text class="vn-xp">{{item.a}} ↔ {{item.b}}</text>
        <text class="vn-xt mono">{{item.text}}</text>
      </view>
    </view>
  </view>
</view>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>
