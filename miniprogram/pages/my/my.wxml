<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view class="brandbar">
  <image class="sq" src="{{dk ? '/images/brand/sparrow-movies-sq-dark.png' : '/images/brand/sparrow-movies-sq.png'}}" mode="aspectFit" />
  <text class="x">×</text>
  <image class="sq" src="{{dk ? '/images/brand/sparrow-tribe-sq-dark.png' : '/images/brand/sparrow-tribe-sq.png'}}" mode="aspectFit" />
  <view class="bb-sp" />
  <view class="lang" hover-class="hv" bindtap="switchLang"><text class="{{en ? '' : 'on'}}">中</text><text class="{{en ? 'on' : ''}}">EN</text></view>
  <view class="tag"><text>{{L.t(i,'观影')}}\n{{L.t(i,'护照')}}</text></view>
</view>
<view class="wrap">
 <view class="h1">{{L.t(i,'我的')}}</view><view class="sub">{{L.t(i,'带着日程出发，带着电影回来。')}}</view>
 <view class="menu card">
  <view class="me-row" hover-class="hv" bindtap="toggleCollection"><image class="me-ic" src="/images/menu/passport.svg" mode="aspectFit" /><view class="me-copy"><text class="me-t">{{L.t(i,'我的观影护照')}}</text><text class="me-s">{{pp.st.n}} {{L.t(i,'部影片')}} · {{L.t(i,'展开封面与电影印章')}}</text></view><text class="me-go {{collectionOpen?'on':''}}">›</text></view>
  <view wx:if="{{collectionOpen}}" class="me-body">
  <view class="fp">
    <view class="k mono">YOUR LIFE IN CINEMA</view>
    <view class="h1 fp-h1">{{L.t(i,'我的观影护照')}}</view>
    <view class="sub">{{L.t(i,'把每一次银幕相遇，收进自己的电影档案。')}}</view>
  <view class="fp-tabs"><view class="fp-tab {{ppTab!=='growth'?'on':''}}" data-t="stamps" bindtap="ppTabSw">{{i.__en?'Stamps':'签章'}}</view><view class="fp-tab {{ppTab==='growth'?'on':''}}" data-t="growth" bindtap="ppTabSw">{{i.__en?'Growth':'成长'}}</view></view>
  <view wx:if="{{ppTab==='growth'}}" class="gw">
    <view class="gh">
      <text class="gh-k mono">{{L.t(i,'我的影迷等级')}}</text>
      <view class="gh-row"><view class="gh-n"><text class="gh-nb">{{gr.n}}</text><text class="gh-nu">{{i.__en?'films':'部'}}</text></view><view class="gh-lv"><text class="gh-name">{{gr.lvName}}</text><text wx:if="{{gr.lvSub}}" class="gh-sub">{{gr.lvSub}}</text></view></view>
      <view class="gh-bar"><view class="gh-fill" style="width:{{gr.pct}}%" /></view>
      <text class="gh-left">{{gr.lvLeft}}</text>
      <view class="gh-stats"><view wx:for="{{gr.stats}}" wx:key="index" class="gh-st"><text class="gh-sn">{{item[0]}}</text><text class="gh-sl">{{item[1]}}</text></view></view>
    </view>
    <view wx:if="{{gr.next}}" class="gn"><view class="gn-c"><text class="gn-k mono">{{L.t(i,'下一枚')}} · {{gr.next.grp}}</text><text class="gn-n">{{gr.next.name}}</text><text class="gn-t">{{gr.next.txt}}</text><view class="gn-bar"><view class="gn-fill" style="width:{{gr.next.pct}}%" /></view></view><text class="gn-p mono">{{gr.next.pct}}%</text></view>
    <view class="gt"><view wx:for="{{gr.subs}}" wx:key="k" class="gt-i {{gt === item.k ? 'on' : ''}}" data-t="{{item.k}}" bindtap="grSub"><text class="gt-n">{{item.n}}</text><text class="gt-c mono">{{item.c}}</text></view></view>
    <view wx:if="{{gt === 'level'}}" class="gs"><view class="gs-h"><text class="gs-t">{{i.__en?'Levels':'影迷等级'}}</text><text class="gs-s">{{L.t(i,'按看过的不同影片数')}}</text></view>
      <view class="gl"><view wx:for="{{gr.ladder}}" wx:key="name" class="gl-i {{item.st}}"><view class="gl-dot" /><text class="gl-n">{{item.name}}</text><text class="gl-sub">{{item.sub}}</text><text wx:if="{{item.tag}}" class="gl-tag">{{item.tag}}</text></view></view>
      <view class="gl-more" bindtap="lvToggle">{{gr.lvMore}}</view></view>
    <view wx:if="{{gt === 'trail'}}" class="gs"><view class="gs-h"><text class="gs-t">{{L.t(i,'全球足迹')}}</text><text class="gs-s">{{gr.geo}}</text></view>
      <view wx:for="{{gr.cities}}" wx:key="name" class="gc"><view class="gc-h"><view><text class="gc-n">{{item.name}}</text><text class="gc-c">{{item.country}}</text></view><view class="gc-cnt"><text class="gc-cn">{{item.n}}</text><text class="gc-cu">{{i.__en?'films':'部'}}</text></view></view>
        <view wx:for="{{item.bars}}" wx:for-item="b" wx:key="name" class="gc-b"><view class="gc-bt"><text class="gc-bn">{{b.name}}</text><text class="gc-be mono">{{b.seen}}/{{b.total}}</text></view><view class="gc-bar"><view class="gc-bf" style="width:{{b.pct}}%" /></view></view></view>
      <view wx:if="{{gr.cMore}}" class="gl-more" bindtap="cToggle">{{gr.cMore}}</view><text wx:if="{{!gr.cities.length}}" class="gs-empty">{{L.t(i,'看过的影片落在哪座城市，这里就会点亮一座城市。')}}</text></view>
    <view wx:if="{{gt === 'medals'}}" class="gs"><view class="gs-h"><text class="gs-t">{{L.t(i,'纪念章')}}</text><text class="gs-s mono">{{gr.medalSum}}</text></view>
      <scroll-view scroll-x enable-flex class="mc"><view wx:for="{{gr.cats}}" wx:for-item="c" wx:key="id" class="mc-b {{c.id===gr.mcat?'on':''}}" data-c="{{c.id}}" bindtap="mcSw"><text class="mc-n">{{c.name}}</text><text class="mc-c mono">{{c.n}}/{{c.t}}</text></view></scroll-view>
      <block wx:for="{{gr.cats}}" wx:for-item="c" wx:key="id"><block wx:if="{{c.id===gr.mcat}}">
      <view wx:for="{{c.groups}}" wx:for-item="g" wx:key="id" class="gg {{g.open ? 'open' : ''}}"><view class="gg-h" data-g="{{g.id}}" bindtap="gTog"><text class="gg-n">{{g.name}}</text><view class="gg-dots"><view wx:for="{{g.dots}}" wx:for-item="d" wx:key="index" class="gg-dot {{d}}" /></view><text class="gg-c mono">{{g.earned}}</text><text class="gg-a">›</text></view>
        <view wx:if="{{g.open}}" class="gg-b"><text class="gg-r">{{g.rule}}</text>
          <block wx:if="{{g.set}}"><view class="gm-wrap"><view wx:for="{{g.medals}}" wx:for-item="m" wx:key="name" class="gm {{m.st}}"><view class="gm-d"><text class="gm-ic">{{m.n}}</text></view><text class="gm-t">{{m.name}}</text></view></view></block>
          <block wx:else><text class="gg-v mono">{{g.val}}</text><scroll-view scroll-x enable-flex class="gm-row"><view wx:for="{{g.medals}}" wx:for-item="m" wx:key="name" class="gm {{m.st}}"><view class="gm-d"><text class="gm-b">{{m.n}}</text></view><text class="gm-t">{{m.name}}</text><text wx:if="{{m.st==='next'}}" class="gm-p mono">{{m.pct}}%</text></view></scroll-view></block></view></view></block></block>
    </view>
  </view>
  <block wx:if="{{ppTab!=='growth'}}">
    <view wx:if="{{ppShelf}}" class="fp-shelf">
      <view class="fp-shelf-h"><view><text class="fp-sk mono">BOOKSHELF</text><text class="fp-st">{{L.t(i,'我的护照书架')}}</text><text class="fp-ss">{{L.t(i,'每册最多 285 枚印章，满了自动换下一册。')}}</text></view><text class="fp-back" bindtap="ppShelfClose">{{L.t(i,'返回')}}</text></view>
      <view class="fp-vgrid">
        <view wx:for="{{pp.vols}}" wx:for-item="v" wx:key="k" class="fp-vcard cv{{v.cv}}" hover-class="fp-press" data-v="{{v.k}}" bindtap="ppPickVol">
          <text class="fp-vc-no mono">VOL. {{v.no}}</text>
          <text class="fp-vc-t">{{L.t(i,'观影护照')}}</text>
          <text class="fp-vc-r mono">{{v.range}}</text>
          <text class="fp-vc-n mono">{{v.nTxt}}</text>
        </view>
      </view>
    </view>
    <view wx:elif="{{!ppOpen}}" class="fp-stage {{wide?'wide':''}}" style="{{wide?'height:'+ppCH+'px':''}}">
      <view class="fp-cover cv{{pp.cv}} {{i.__en?'en':''}}" style="{{wide?'transform:scale('+ppCK+')':''}}" hover-class="fp-press" bindtap="ppOpen">
        <view class="fp-cb" />
        <view class="fp-edition mono"><text>SPARROW CINEMA</text><text>VOL. {{pp.volNo}}</text></view>
        <text class="fp-name">{{i.__en?'PERSONAL EDITION':'观影护照'}}</text>
        <text class="fp-title-en">FILM
PASSPORT</text>
        <image class="fp-cover-art" src="/images/brand/passport-aperture.png" mode="aspectFit" />
        <view class="fp-cover-rule" />
        <view class="fp-cover-bottom mono"><text>ONE FILM
ONE STAMP</text><text class="fp-open-icon">↗</text></view>
        <text class="fp-publishers">{{L.t(i,'麻雀映画 × 麻雀部落')}}</text>
      </view>
      <text class="fp-cap">{{pp.capPre}}{{L.t(i,'轻触封面，翻开你的银幕旅程 ↗')}}</text>
      <view class="fp-tallies card">
        <view><text class="n mono">{{pp.st.n}}</text><text class="l">{{L.t(i,'看过影片')}}</text></view>
        <view><text class="n mono">{{pp.st.progs}}</text><text class="l">{{L.t(i,'专题')}}</text></view>
        <view><text class="n mono">{{pp.st.venues}}</text><text class="l">{{L.t(i,'影院')}}</text></view>
        <view><text class="n mono">{{pp.st.avg}}</text><text class="l">{{L.t(i,'平均评分')}}</text></view>
      </view>
      <view wx:if="{{pp.nv>1}}" class="fp-shelfbtn" hover-class="hv" bindtap="ppShelfOpen">{{pp.shelfTxt}}</view>
    </view>
    <block wx:elif="{{!wide}}">
      <swiper class="fp-book" current="{{ppPage}}" bindchange="ppChange" easing-function="easeOutCubic" duration="420">
        <swiper-item>
          <view class="fp-fx"><template is="fp-id" data="{{pp,i}}" /></view>
        </swiper-item>
        <swiper-item wx:for="{{pp.pages}}" wx:for-item="pg" wx:key="no">
          <view class="fp-fx"><template is="fp-visa" data="{{pg,pp,i}}" /></view>
        </swiper-item>
      </swiper>
      <view class="fp-nav">
        <view class="nb {{ppPage === 0 ? 'dis' : ''}}" bindtap="ppPrev">{{L.t(i,'← 上一页')}}</view>
        <text class="mono">{{ppPage + 1}} / {{pp.n}}</text>
        <view class="nb {{ppPage === pp.n - 1 ? 'dis' : ''}}" bindtap="ppNext">{{L.t(i,'下一页 →')}}</view>
      </view>
      <view class="fp-close"><text>{{L.t(i,'左右滑动翻页')}}</text><view class="fp-cl"><text wx:if="{{pp.nv>1}}" class="lk" bindtap="ppShelfOpen">{{pp.shelfLk}}</text><text class="lk" bindtap="ppClose">{{L.t(i,'合上护照')}}</text></view></view>
    </block>
    <block wx:else>
      <view class="fp-sw" style="height:{{ppH}}px">
        <swiper class="fp-sbook" current="{{ppSp}}" bindchange="ppChange" easing-function="easeOutCubic" duration="460">
          <swiper-item wx:for="{{spreads}}" wx:for-item="sp" wx:key="k">
            <view class="fp-fx">
            <view class="fp-spread" style="transform:scale({{ppK}})">
              <view class="fp-sl"><template wx:if="{{sp.l === 0}}" is="fp-id" data="{{pp,i}}" /><template wx:else is="fp-visa" data="{{pg:pp.pages[sp.l - 1],pp,i}}" /></view>
              <view class="fp-sr"><template wx:if="{{sp.r < pp.n}}" is="fp-visa" data="{{pg:pp.pages[sp.r - 1],pp,i}}" /><view wx:else class="fp-page fp-blank"><view class="fp-ph mono"><text>SPARROW FILM PASSPORT</text><text>{{sp.rno}}</text></view></view></view>
              <view class="fp-spine" />
            </view>
            </view>
          </swiper-item>
        </swiper>
      </view>
      <view class="fp-nav fp-navw">
        <view class="nb {{ppSp === 0 ? 'dis' : ''}}" bindtap="ppPrev">{{L.t(i,'← 上一页')}}</view>
        <text class="mono">{{ppLabel}}</text>
        <view class="nb {{ppSp >= spreads.length - 1 ? 'dis' : ''}}" bindtap="ppNext">{{L.t(i,'下一页 →')}}</view>
      </view>
      <view class="fp-close fp-navw"><text>{{L.t(i,'左右滑动翻页')}}</text><view class="fp-cl"><text wx:if="{{pp.nv>1}}" class="lk" bindtap="ppShelfOpen">{{pp.shelfLk}}</text><text class="lk" bindtap="ppClose">{{L.t(i,'合上护照')}}</text></view></view>
    </block>
  </block>
  </view>
  <view class="my-library-links"><view data-mode="planned" bindtap="openLibrary">{{L.t(i,'已加入排片')}} ↗</view><view data-mode="watched" bindtap="openLibrary">{{L.t(i,'已看过')}} ↗</view><view data-mode="qa" bindtap="openLibrary">{{L.t(i,'主创映后场')}} ↗</view></view>
  </view>
  <view class="me-row" hover-class="hv" bindtap="openRecap"><image class="me-ic" src="/images/menu/recap.svg" mode="aspectFit" /><view class="me-copy"><text class="me-t">{{L.t(i,'我的影院观影结算')}}</text><text class="me-s">{{L.t(i,'按年份与专题，收藏印章与评分。')}}</text></view><text class="me-go">›</text></view>
  <view class="me-row" hover-class="hv" bindtap="toPlan"><image class="me-ic" src="/images/menu/plan.svg" mode="aspectFit" /><view class="me-copy"><text class="me-t">{{L.t(i,'个人排片')}}</text><text class="me-s">{{planSub}}</text></view><text class="me-go">›</text></view>
  <view class="me-row" hover-class="hv" bindtap="toTasteMap"><image class="me-ic" src="/images/menu/taste.svg" mode="aspectFit" /><view class="me-copy"><text class="me-t">{{L.t(i,'我的趣味图谱')}}</text><text class="me-s">{{tasteSub}}</text></view><text class="me-go">›</text></view>
  <view class="me-row" hover-class="hv" bindtap="toPosterWall"><image class="me-ic" src="/images/menu/wall.svg" mode="aspectFit" /><view class="me-copy"><text class="me-t">{{L.t(i,'我的海报墙')}}</text><text class="me-s">{{L.t(i,'看过的影片 · 我的评分')}}</text></view><text class="me-go">›</text></view>
  <view class="me-row" bindtap="toggleAppearance" hover-class="hv"><text class="me-theme-icon">◐</text><view class="me-copy"><text class="me-t">{{L.t(i,'外观')}}</text><text class="me-s">{{tpref==='light'?L.t(i,'浅色'):tpref==='dark'?L.t(i,'暗色'):L.t(i,'跟随系统')}}</text></view><text class="me-go">{{appearanceOpen?'⌄':'›'}}</text></view>
  <view wx:if="{{appearanceOpen}}" class="appearance-body"><text class="me-s">{{L.t(i,'自动跟随手机或电脑，也可固定浅色、暗色')}}</text><view class="th-seg"><view class="th-o {{tpref==='auto'?'on':''}}" data-p="auto" bindtap="setTheme">{{L.t(i,'跟随系统')}}</view><view class="th-o {{tpref==='light'?'on':''}}" data-p="light" bindtap="setTheme">{{L.t(i,'浅色')}}</view><view class="th-o {{tpref==='dark'?'on':''}}" data-p="dark" bindtap="setTheme">{{L.t(i,'暗色')}}</view></view></view>
  <view class="me-row" hover-class="hv" bindtap="toggleSync"><image class="me-ic" src="/images/menu/sync.svg" mode="aspectFit" /><view class="me-copy"><text class="me-t">{{L.t(i,'个人档案云端同步')}}</text><text class="me-s">{{sy.on ? sy.line : L.t(i,'同步、备份与档案保管')}}</text></view><text class="me-go {{syncExpanded?'on':''}}">›</text></view>
  <view wx:if="{{syncExpanded}}" class="me-body sync-body">
   <block wx:if="{{sy}}">
    <block wx:if="{{!sy.on}}">
      <view class="sy-lead">{{L.t(i,'用微信登录自动保存档案：换手机、重装小程序都不会丢，也可以用同步码和网站互通。')}}</view>
      <view class="sy-row"><view class="btn" hover-class="hv" bindtap="syStart">{{L.t(i,'用微信登录并同步')}}</view><view class="btn ghost" hover-class="hv" bindtap="syJoin">{{L.t(i,'我已有同步码')}}</view></view>
    </block>
    <block wx:else>
      <view class="sy-st"><view class="dot {{sy.state}}" /><text>{{sy.wx ? L.t(i,'微信已登录 · ') : ''}}{{sy.line}}</text></view>
      <view class="sy-code"><text class="sy-l">{{L.t(i,'同步码')}}</text><text class="mono sy-c" user-select>{{sy.shown}}</text>
        <view class="sy-ops"><text bindtap="syReveal">{{sy.rev ? L.t(i,'隐藏') : L.t(i,'显示')}}</text><text bindtap="syCopy">{{L.t(i,'复制')}}</text></view></view>
      <view class="sy-row"><view class="btn" hover-class="hv" bindtap="syNow">{{L.t(i,'立即同步')}}</view><text class="sy-stop" bindtap="syStop">{{L.t(i,'停止同步')}}</text></view>
      <view class="sy-note">{{L.t(i,'同一个微信在任何手机上打开小程序都会自动连到这份档案。网站没有微信登录：在网站「我的」页选「我已有同步码」，输入这串码即可。同步码就是钥匙，请自己保存好；知道它的人都能读写这份档案。')}}</view>
    </block>
   </block>
   <view class="care-h">{{L.t(i,'你的档案，由你保管')}}</view>

 <text class="care-p">{{L.t(i,'小程序记录保存在本机，个人排片与看过记录也会按微信用户同步。启用同步码后，姓名、照片与完整档案会另存入 Supabase，用于网站和多设备同步。')}}</text>
 <text class="care-p">{{L.t(i,'完整备份包含观影记录、评分、照片、姓名和个人排片，不包含同步码。导入会合并已有排片，同一影片以导入记录为准；备份文件请自行妥善保管。')}}</text>
 <view class="sy-row"><view class="btn ghost" bindtap="backupProfile">{{L.t(i,'下载完整备份')}}</view><view class="btn ghost" bindtap="restoreProfile">{{L.t(i,'导入备份')}}</view></view>
 <text class="care-p">{{L.t(i,'同步码丢失时可在另一台已连接设备查看。没有同步码和已连接设备时，无法凭姓名找回；备份文件仍可恢复本机档案。')}}</text>
 <text class="care-p">{{L.t(i,'停止同步只断开本设备。清空同步码对应的云端内容前，请先在其他设备停止同步；本机副本保留，微信用户下的排片与看过记录不受影响。匿名同步记录和删除标记仍保留；彻底删除请联系维护者。')}}</text>
 <view wx:if="{{sy.on}}" class="care-danger" bindtap="clearCloudProfile">{{L.t(i,'清空云端内容并断开同步')}}</view>
  </view>
  <view class="me-row" hover-class="hv" bindtap="toggleGuide"><image class="me-ic" src="/images/menu/guide.svg" mode="aspectFit" /><view class="me-copy"><text class="me-t">{{L.t(i,'观影护照使用指南')}}</text><text class="me-s">{{L.t(i,'排片、专题、片目与我的护照怎么用')}}</text></view><text class="me-go {{guideOpen?'on':''}}">›</text></view>
  <view wx:if="{{guideOpen}}" class="me-body guide">
      <view class="gi" wx:for="{{guide}}" wx:key="k"><text class="gk">{{index + 1}}</text><view><text class="gb">{{L.t(i,item.k)}}</text><text class="gs">{{L.t(i,item.s)}}</text></view></view>
  </view>
  <view class="me-row" hover-class="hv" bindtap="toggleFb"><image class="me-ic" src="/images/menu/feedback.svg" mode="aspectFit" /><view class="me-copy"><text class="me-t">{{L.t(i,'反馈与纠错')}}</text><text class="me-s">{{L.t(i,'排片问题与使用建议')}}</text></view><text class="me-go {{fbOpen?'on':''}}">›</text></view>
  <view wx:if="{{fbOpen}}" class="me-body fb">
    <view class="fb-p">{{L.t(i,'排片、片名、人名或功能有问题？欢迎告诉我们，附上截图和页面名称会更快处理。')}}</view>
    <view class="fb-row" hover-class="hv" data-v="2165.yan@gmail.com" data-n="Email" bindtap="copyContact"><text class="fb-k mono">EMAIL</text><text class="fb-v mono">2165.yan@gmail.com</text><text class="fb-go">{{L.t(i,'复制')}}</text></view>
    <view class="fb-row" hover-class="hv" data-v="BFAFILM" data-n="WeChat" bindtap="copyContact"><text class="fb-k mono">WECHAT</text><text class="fb-v mono">BFAFILM</text><text class="fb-go">{{L.t(i,'复制')}}</text></view>
  </view>
  <view class="me-row" hover-class="hv" bindtap="toggleFriend"><image class="me-ic" src="/images/menu/link.svg" mode="aspectFit" /><view class="me-copy"><text class="me-t">{{L.t(i,'友情链接')}}</text><text class="me-s">{{L.t(i,'伙伴站点 · 更多陆续加入')}}</text></view><text class="me-go {{friendOpen?'on':''}}">›</text></view>
  <view wx:if="{{friendOpen}}" class="me-body fb">
    <view class="fb-p">{{L.t(i,'点按复制链接，到浏览器打开。')}}</view>
    <view class="fr-item" hover-class="hv" wx:for="{{friends}}" wx:key="u" data-v="{{item.u}}" bindtap="copyContact"><image class="fr-mark" src="{{item.img}}" mode="aspectFill" /><view class="fl-t"><text class="fl-n">{{L.t(i,item.n)}}</text><text class="fl-g">{{L.t(i,item.g)}}</text><text class="fl-d">{{L.t(i,item.d)}}</text></view><text class="fb-go">{{L.t(i,'复制')}}</text></view>
  </view>
 </view>
</view>

<view wx:if="{{rcOpen}}" class="rc-mask" bindtap="closeRecap">
  <view class="rc-panel" catchtap="noop">
    <view class="rc-head"><text class="b">{{L.t(i,'我的影院观影结算')}}</text><text class="rc-x" bindtap="closeRecap">✕</text></view>
    <scroll-view scroll-y class="rc-scroll">
    <text class="rc-k mono">{{L.t(i,'年份 / YEAR')}}</text>
    <scroll-view scroll-x class="rc-seg-sv" enable-flex scroll-into-view="{{rcYearAnchor}}"><view class="rc-seg"><view wx:for="{{rc.years}}" wx:key="v" id="rc-year-{{item.v}}" class="rc-y {{item.on ? 'on' : ''}}" data-v="{{item.v}}" bindtap="setRcY"><text class="yb mono">{{item.n}}</text><text class="ys">{{item.c}}</text></view></view></scroll-view>
    <view wx:if="{{rc.grids.length}}" class="rc-kh"><text class="rc-k mono">{{rcY[0]}} · {{L.t(i,'月份 / MONTH')}} <text class="rc-hint">{{i.__en?'multi-select':'可多选'}}</text></text><text wx:if="{{rc.mSel}}" class="rc-clear" data-v="all" bindtap="setRcM">{{rc.mSel}} · {{L.t(i,'清除')}}</text></view>
    <block wx:for="{{rc.grids}}" wx:for-item="gd" wx:key="y"><view class="rc-cal"><view wx:for="{{gd.cells}}" wx:key="v" class="rc-d {{item.on ? 'on' : ''}} {{item.c ? '' : 'nil'}}" style="{{item.bg}}" data-v="{{item.v}}" data-c="{{item.c}}" bindtap="setRcM"><text class="db">{{item.n}}</text><text class="ds mono">{{item.cs}}</text></view></view></block>
    <text wx:if="{{!rc.grids.length}}" class="rc-year-note">{{L.t(i,'已汇总全部年份，选择年份可按月筛选。')}}</text>
    <text class="rc-k mono">{{L.t(i,'专题 / PROGRAMME')}} <text class="rc-hint">{{i.__en?'multi-select':'可多选'}}</text></text>
    <view wx:if="{{rc.progSearch}}" class="rc-prog-picker"><view class="rc-prog-summary" bindtap="toggleRcProgrammes"><text class="rc-prog-label">{{rc.progLabel}}</text><text>{{rcProgOpen?'⌃':'⌄'}}</text></view><view wx:if="{{rcProgOpen}}" class="rc-prog-body"><input class="rc-prog-search" value="{{rcProgQuery}}" placeholder="{{L.t(i,'搜索专题')}}" bindinput="searchRcProgrammes" /><scroll-view scroll-y class="rc-prog-list"><view wx:for="{{rc.progs}}" wx:key="v" class="rc-prog-option {{item.on?'on':''}}" data-v="{{item.v}}" bindtap="setRcP"><text>{{item.on?'✓':'○'}}</text><text>{{item.n}}</text></view><view wx:if="{{rc.progs.length===1}}" class="me-s">{{L.t(i,'没有匹配的专题')}}</view></scroll-view></view></view>
    <view wx:else class="rc-chips"><text wx:for="{{rc.progs}}" wx:key="v" class="chip {{item.on ? 'on' : ''}}" data-v="{{item.v}}" bindtap="setRcP">{{item.n}}</text></view>
    <text class="rc-k">{{L.t(i,'长图展示项目')}} · {{L.t(i,'可多选')}}</text>
    <checkbox-group class="rc-options" bindchange="setRcSections"><label wx:for="{{rc.sections}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.on}}" color="#2f6f6c"/><text>{{item.label}}</text></label></checkbox-group>
    <text class="rc-note">{{L.t(i,'品牌与二维码固定保留。')}} {{L.t(i,'仅影响生成的长图，不会修改观影记录。')}}</text>
    <view class="rc-sum" wx:if="{{rc.n}}">
      <view><text class="n mono">{{rc.n}}</text><text class="l">{{L.t(i,'部影片')}}</text></view>
      <view><text class="n mono">{{rc.hm}}</text><text class="l">{{L.t(i,'银幕时长')}}</text></view>
      <view><text class="n mono">{{rc.avg}}</text><text class="l">{{L.t(i,'平均评分')}}</text></view>
    </view>
    <view wx:else class="rc-sum"><text class="l">{{L.t(i,'这个范围里还没有看过的影片')}}</text></view>
    </scroll-view>
    <view class="btn rc-go {{rc.n && rc.sectionCount ? '' : 'dis'}}" bindtap="makeRecap">{{L.t(i,'生成结算长图')}}</view>
  </view>
</view>
<canvas type="2d" id="recap" class="poster-cv" />
<template name="fp-id">
          <view class="fp-page fp-id">
  <view class="fp-ph mono"><text>{{L.t(i,'FILM PASSPORT / 资料页')}}</text><text>01</text></view>
  <view class="fp-idhead">
    <view class="fp-portrait" bindtap="pickPhoto">
      <image wx:if="{{pp.photo}}" class="fp-photo" src="{{pp.photo}}" mode="aspectFill" />
      <block wx:else><view class="reel sm"><view wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this" class="hole h{{item}}" /><view class="hub" /></view><text class="fp-padd mono">{{L.t(i,'添加照片')}}</text></block>
    </view>
    <view class="fp-fields">
      <text class="fp-l mono">{{L.t(i,'类型 / TYPE · P')}}</text>
      <text class="fp-l mono">{{L.t(i,'持有人 / HOLDER')}}</text>
      <view class="fp-holder" bindtap="editHolder">{{pp.holder}} <text class="pen">✎</text></view>
      <text wx:if="{{pp.holderEn}}" class="fp-en mono">{{pp.holderEn}}</text>
      <text class="fp-l mono">{{L.t(i,'签发 / ISSUED BY')}}</text>
      <text class="fp-iss">{{L.t(i,'麻雀映画 × 麻雀部落')}}</text>
    </view>
  </view>
  <view class="fp-tally">
    <view><text class="n mono">{{pp.st.n}}</text><text class="l">{{L.t(i,'看过影片')}}</text></view>
    <view><text class="n mono">{{pp.st.progs}}</text><text class="l">{{L.t(i,'专题')}}</text></view>
    <view><text class="n mono">{{pp.st.venues}}</text><text class="l">{{L.t(i,'影院')}}</text></view>
    <view><text class="n mono">{{pp.st.avg}}</text><text class="l">{{L.t(i,'平均评分')}}</text></view>
  </view>
  <view class="fp-dl"><text class="dt mono">{{L.t(i,'册号 / VOLUME')}}</text><text class="dd mono">{{pp.volTxt}}</text></view>
            <view class="fp-dl"><text class="dt mono">{{L.t(i,'本册印章 / IN THIS VOLUME')}}</text><text class="dd mono">{{pp.vn}}</text></view>
            <view class="fp-dl"><text class="dt mono">{{L.t(i,'首枚印章 / FIRST STAMP')}}</text><text class="dd mono">{{pp.first}}</text></view>
  <view class="fp-dl"><text class="dt mono">{{L.t(i,'最近印章 / LATEST')}}</text><text class="dd mono">{{pp.last}}</text></view>
  <view class="fp-dl"><text class="dt mono">{{L.t(i,'累计时长 / SCREEN TIME')}}</text><text class="dd mono">{{pp.st.hm}}</text></view>
  <view class="fp-sign"><text class="mono">{{L.t(i,'签名 / SIGNATURE')}}</text><text class="sig">See you at the cinema.</text></view>
  <view class="fp-mrz mono"><text>{{pp.mrz1}}</text><text>{{pp.mrz2}}</text></view>
</view>
</template>
<template name="fp-visa">
          <view class="fp-page fp-visa">
  <view class="fp-ph mono"><text>{{L.t(i,'VISAS / 观影印章')}}</text><text>{{pg.no}}</text></view>
  <view class="fp-vh">{{pp.empty ? L.t(i,'这本护照还没有印章') : L.t(i,'一部电影，一枚印章。')}}</view>
  <view class="fp-sub">{{pp.empty ? L.t(i,'在影片页点「看过」，就会在这里盖章。') : L.t(i,'点印章回到影片 · 评分印在章上')}}</view>
  <view class="fp-grid">
    <view wx:for="{{pg.items}}" wx:for-item="s" wx:key="id" class="fp-cell {{pp.hit === s.id ? 'hit' : ''}}">
  <view class="st st{{s.shape}}" style="--ink:{{s.ink}};transform:translate(calc({{s.dx}} * var(--r)),calc({{s.dy}} * var(--r))) rotate({{s.tilt}}deg) scale(.5)" data-id="{{s.id}}" bindtap="openStamp">
    <view class="st-in" />
    <text class="st-top">{{s.top}}</text>
    <text class="st-title">{{s.title}}</text>
    <text class="st-date">{{s.date}}</text>
    <view wx:if="{{s.r}}" class="st-stars"><view wx:for="{{s.stars}}" wx:for-item="w" wx:key="index" class="ss"><text class="s0">☆</text><view class="s1" style="width:{{w}}%"><text>★</text></view></view></view>
    <text class="st-venue">{{s.venue}}</text>
    <text wx:if="{{s.x}}" class="st-x mono">{{s.x}}</text>
  </view>
    </view>
    <view wx:for="{{pg.slots}}" wx:key="*this" class="fp-cell"><view class="fp-slot {{index ? 'dim' : ''}}"><text wx:if="{{pp.empty && index === 0}}" class="b">{{L.t(i,'第一枚印章')}}</text><text class="mono">NEXT STAMP</text></view></view>
  </view>
  <view class="fp-pf mono"><text>{{L.t(i,'印章')}} {{pg.k}} / {{pp.pages.length}}</text><text>SPARROW FILM PASSPORT</text></view>
</view>
</template>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>
