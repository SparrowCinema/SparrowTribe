<wxs src="../../utils/l.wxs" module="L" />
<view class="wrap">
 <view class="h1">{{L.t(i,'我的')}}</view><view class="sub">{{L.t(i,'带着日程出发，带着电影回来。')}}</view>
 <view class="collection-head card" bindtap="toggleCollection"><view class="mini-passport">✦</view><view class="collection-copy"><text class="b">{{L.t(i,'我的观影护照')}}</text><text class="small">{{pp.st.n}} {{L.t(i,'部影片')}} · {{L.t(i,'展开封面与电影印章')}}</text></view><text>{{collectionOpen?'⌃':'⌄'}}</text></view>
 <block wx:if="{{collectionOpen}}">
  <view class="fp">
    <view class="k mono">YOUR LIFE IN CINEMA</view>
    <view class="h1 fp-h1">{{L.t(i,'我的观影护照')}}</view>
    <view class="sub">{{L.t(i,'把每一次银幕相遇，收进自己的电影档案。')}}</view>
    <view wx:if="{{!ppOpen}}" class="fp-stage">
      <view class="fp-cover {{i.__en?'en':''}}" hover-class="fp-press" bindtap="ppOpen">
        <view class="fp-cb" />
        <view class="fp-edition mono"><text>SPARROW CINEMA</text><text>VOL. 01</text></view>
        <text class="fp-name">{{i.__en?'PERSONAL EDITION':'观影护照'}}</text>
        <text class="fp-title-en">FILM
PASSPORT</text>
        <image class="fp-cover-art" src="/images/brand/passport-aperture.png" mode="aspectFit" />
        <view class="fp-cover-rule" />
        <view class="fp-cover-bottom mono"><text>ONE FILM
ONE STAMP</text><text class="fp-open-icon">↗</text></view>
        <text class="fp-publishers">{{L.t(i,'麻雀映画 × 麻雀部落')}}</text>
      </view>
      <text class="fp-cap">{{L.t(i,'轻触封面，翻开你的银幕旅程 ↗')}}</text>
      <view class="fp-tallies card">
        <view><text class="n mono">{{pp.st.n}}</text><text class="l">{{L.t(i,'看过影片')}}</text></view>
        <view><text class="n mono">{{pp.st.progs}}</text><text class="l">{{L.t(i,'专题')}}</text></view>
        <view><text class="n mono">{{pp.st.venues}}</text><text class="l">{{L.t(i,'影院')}}</text></view>
        <view><text class="n mono">{{pp.st.avg}}</text><text class="l">{{L.t(i,'平均评分')}}</text></view>
      </view>
    </view>
    <block wx:else>
      <swiper class="fp-book" current="{{ppPage}}" bindchange="ppChange" easing-function="easeOutCubic" duration="420">
        <swiper-item>
          <view class="fp-page fp-id">
            <view class="fp-ph mono"><text>{{L.t(i,'FILM PASSPORT / 资料页')}}</text><text>01</text></view>
            <view class="fp-idhead">
              <view class="fp-portrait" bindtap="pickPhoto">
                <image wx:if="{{pp.photo}}" class="fp-photo" src="{{pp.photo}}" mode="aspectFill" />
                <block wx:else><view class="reel sm"><view wx:for="{{[0,1,2,3,4,5]}}" wx:key="*this" class="hole h{{item}}" /><view class="hub" /></view><text class="fp-padd mono">{{L.t(i,'添加照片')}}</text></block>
              </view>
              <view class="fp-fields">
                <text class="fp-l mono">{{L.t(i,'类型 / TYPE · P')}}</text>
                <text class="fp-l mono">{{L.t(i,'持有人 / HOLDER')}}</text>
                <view class="fp-holder" bindtap="editHolder">{{pp.holder}} <text class="pen">✎</text></view>
                <text wx:if="{{pp.holderEn}}" class="fp-en mono">{{pp.holderEn}}</text>
                <text class="fp-l mono">{{L.t(i,'签发 / ISSUED BY')}}</text>
                <text class="fp-iss">{{L.t(i,'麻雀映画 × 麻雀部落')}}</text>
              </view>
            </view>
            <view class="fp-tally">
              <view><text class="n mono">{{pp.st.n}}</text><text class="l">{{L.t(i,'看过影片')}}</text></view>
              <view><text class="n mono">{{pp.st.progs}}</text><text class="l">{{L.t(i,'专题')}}</text></view>
              <view><text class="n mono">{{pp.st.venues}}</text><text class="l">{{L.t(i,'影院')}}</text></view>
              <view><text class="n mono">{{pp.st.avg}}</text><text class="l">{{L.t(i,'平均评分')}}</text></view>
            </view>
            <view class="fp-dl"><text class="dt mono">{{L.t(i,'首枚印章 / FIRST STAMP')}}</text><text class="dd mono">{{pp.first}}</text></view>
            <view class="fp-dl"><text class="dt mono">{{L.t(i,'最近印章 / LATEST')}}</text><text class="dd mono">{{pp.last}}</text></view>
            <view class="fp-dl"><text class="dt mono">{{L.t(i,'银幕时长 / SCREEN TIME')}}</text><text class="dd mono">{{pp.st.hm}}</text></view>
            <view class="fp-sign"><text class="mono">{{L.t(i,'签名 / SIGNATURE')}}</text><text class="sig">See you at the cinema.</text></view>
            <view class="fp-mrz mono"><text>{{pp.mrz1}}</text><text>{{pp.mrz2}}</text></view>
          </view>
        </swiper-item>
        <swiper-item wx:for="{{pp.pages}}" wx:for-item="pg" wx:key="no">
          <view class="fp-page fp-visa">
            <view class="fp-ph mono"><text>{{L.t(i,'VISAS / 观影印章')}}</text><text>{{pg.no}}</text></view>
            <view class="fp-vh">{{pp.empty ? L.t(i,'这本护照还没有印章') : L.t(i,'一部电影，一枚印章。')}}</view>
            <view class="fp-sub">{{pp.empty ? L.t(i,'在影片页点「看过」，就会在这里盖章。') : L.t(i,'点印章回到影片 · 评分印在章上')}}</view>
            <view class="fp-grid">
              <view wx:for="{{pg.items}}" wx:for-item="s" wx:key="id" class="fp-cell">
            <view class="st st{{s.shape}}" style="--ink:{{s.ink}};transform:translate({{s.dx}}rpx,{{s.dy}}rpx) rotate({{s.tilt}}deg) scale(.5)" data-id="{{s.id}}" bindtap="openStamp">
              <view class="st-in" />
              <text class="st-top">{{s.top}}</text>
              <text class="st-title">{{s.title}}</text>
              <text class="st-date">{{s.date}}</text>
              <view wx:if="{{s.r}}" class="st-stars"><view wx:for="{{s.stars}}" wx:for-item="w" wx:key="index" class="ss"><text class="s0">☆</text><view class="s1" style="width:{{w}}%"><text>★</text></view></view></view>
              <text class="st-venue">{{s.venue}}</text>
            </view>
              </view>
              <view wx:for="{{pg.slots}}" wx:key="*this" class="fp-cell"><view class="fp-slot {{index ? 'dim' : ''}}"><text wx:if="{{pp.empty && index === 0}}" class="b">{{L.t(i,'第一枚印章')}}</text><text class="mono">NEXT STAMP</text></view></view>
            </view>
            <view class="fp-pf mono"><text>{{L.t(i,'印章')}} {{index + 1}} / {{pp.pages.length}}</text><text>SPARROW FILM PASSPORT</text></view>
          </view>
        </swiper-item>
      </swiper>
      <view class="fp-nav">
        <view class="nb {{ppPage === 0 ? 'dis' : ''}}" bindtap="ppPrev">{{L.t(i,'← 上一页')}}</view>
        <text class="mono">{{ppPage + 1}} / {{pp.n}}</text>
        <view class="nb {{ppPage === pp.n - 1 ? 'dis' : ''}}" bindtap="ppNext">{{L.t(i,'下一页 →')}}</view>
      </view>
      <view class="fp-close"><text>{{L.t(i,'左右滑动翻页')}}</text><text class="lk" bindtap="ppClose">{{L.t(i,'合上护照')}}</text></view>
    </block>
  </view></block>
  <view class="fp-recap" hover-class="hv" bindtap="openRecap"><view class="recap-emblem">✦</view><view class="recap-copy"><text class="k">{{L.t(i,'我的银幕足迹')}}</text><text class="b">{{L.t(i,'生成我的影院观影结算')}}</text><text class="s">{{L.t(i,'按年份与专题，收藏印章与评分。')}}</text></view><text class="ar">↗</text></view>

  <view class="my-library-links"><view data-mode="planned" bindtap="openLibrary">{{L.t(i,'已加入排片')}} ↗</view><view data-mode="watched" bindtap="openLibrary">{{L.t(i,'已看过')}} ↗</view><view data-mode="qa" bindtap="openLibrary">{{L.t(i,'主创映后场')}} ↗</view></view>

  <view class="sy card" wx:if="{{sy}}">
    <view class="sy-h" bindtap="toggleSync"><text>{{L.t(i,'个人档案云端同步')}}</text><text>{{syncExpanded||sy.on?'−':'＋'}}</text></view>
    <block wx:if="{{syncExpanded||sy.on}}">
    <block wx:if="{{!sy.on}}">
      <view class="sy-lead">{{L.t(i,'用一串同步码，在手机、电脑和小程序之间同步看过记录、评分、护照照片和个人排片。不用注册账号。')}}</view>
      <view class="sy-row"><view class="btn" hover-class="hv" bindtap="syStart">{{L.t(i,'开启同步')}}</view><view class="btn ghost" hover-class="hv" bindtap="syJoin">{{L.t(i,'我已有同步码')}}</view></view>
    </block>
    <block wx:else>
      <view class="sy-st"><view class="dot {{sy.state}}" /><text>{{sy.line}}</text></view>
      <view class="sy-code"><text class="sy-l">{{L.t(i,'同步码')}}</text><text class="mono sy-c" user-select>{{sy.shown}}</text>
        <view class="sy-ops"><text bindtap="syReveal">{{sy.rev ? L.t(i,'隐藏') : L.t(i,'显示')}}</text><text bindtap="syCopy">{{L.t(i,'复制')}}</text></view></view>
      <view class="sy-row"><view class="btn" hover-class="hv" bindtap="syNow">{{L.t(i,'立即同步')}}</view><text class="sy-stop" bindtap="syStop">{{L.t(i,'停止同步')}}</text></view>
      <view class="sy-note">{{L.t(i,'在另一台设备（网站或小程序）的「我的」页选「我已有同步码」，输入这串码即可。同步码就是钥匙，请自己保存好；知道它的人都能读写这份档案。')}}</view>
    </block>
    </block>
  </view>

 <view class="card profile-care"><view class="sy-h" bindtap="toggleCare">{{L.t(i,'你的档案，由你保管')}} <text>{{careOpen?'−':'＋'}}</text></view><block wx:if="{{careOpen}}">
 <text class="care-p">{{L.t(i,'小程序记录保存在本机，个人排片与看过记录也会按微信用户同步。启用同步码后，姓名、照片与完整档案会另存入 Supabase，用于网站和多设备同步。')}}</text>
 <text class="care-p">{{L.t(i,'完整备份包含观影记录、评分、照片、姓名和个人排片，不包含同步码。导入会合并已有排片，同一影片以导入记录为准；备份文件请自行妥善保管。')}}</text>
 <view class="sy-row"><view class="btn ghost" bindtap="backupProfile">{{L.t(i,'下载完整备份')}}</view><view class="btn ghost" bindtap="restoreProfile">{{L.t(i,'导入备份')}}</view></view>
 <text class="care-p">{{L.t(i,'同步码丢失时可在另一台已连接设备查看。没有同步码和已连接设备时，无法凭姓名找回；备份文件仍可恢复本机档案。')}}</text>
 <text class="care-p">{{L.t(i,'停止同步只断开本设备。清空同步码对应的云端内容前，请先在其他设备停止同步；本机副本保留，微信用户下的排片与看过记录不受影响。匿名同步记录和删除标记仍保留；彻底删除请联系维护者。')}}</text>
 <view wx:if="{{sy.on}}" class="care-danger" bindtap="clearCloudProfile">{{L.t(i,'清空云端内容并断开同步')}}</view>
 </block></view>
 <view wx:if="{{planSelectorOpen}}" class="selector-mask" catchtouchmove="noop" catchtap="closePlanSelector"><view class="selector-panel" catchtap="noop"><view class="selector-head"><text>{{L.t(i,'选择专题')}}</text><text bindtap="closePlanSelector">×</text></view><input class="selector-search" placeholder="{{L.t(i,'搜索专题')}}" value="{{planQuery}}" bindinput="searchPlanSelector"/><scroll-view scroll-y class="selector-results"><view wx:for="{{planOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="choosePlanScope" class="selector-option"><view><text class="b">{{item.n}}</text><text class="small">{{item.lab}}</text></view><text>{{pf===item.id?'✓':''}}</text></view><view wx:if="{{!planOptions.length}}" class="small">{{L.t(i,'没有匹配的专题')}}</view></scroll-view></view></view>
  <view class="card guide">
    <view class="sy-h" bindtap="toggleGuide">{{L.t(i,'观影护照使用指南')}} <text class="gtog">{{guideOpen ? '−' : '+'}}</text></view>
    <block wx:if="{{guideOpen}}">
      <view class="gi" wx:for="{{guide}}" wx:key="k"><text class="gk">{{index + 1}}</text><view><text class="gb">{{L.t(i,item.k)}}</text><text class="gs">{{L.t(i,item.s)}}</text></view></view>
    </block>
  </view>

  <view class="card fb">
    <view class="sy-h" bindtap="toggleFb">{{L.t(i,'反馈与纠错')}} <text class="gtog">{{fbOpen ? '−' : '+'}}</text></view>
    <block wx:if="{{fbOpen}}">
    <view class="fb-p">{{L.t(i,'排片、片名、人名或功能有问题？欢迎告诉我们，附上截图和页面名称会更快处理。')}}</view>
    <view class="fb-row" hover-class="hv" data-v="2165.yan@gmail.com" data-n="Email" bindtap="copyContact"><text class="fb-k mono">EMAIL</text><text class="fb-v mono">2165.yan@gmail.com</text><text class="fb-go">{{L.t(i,'复制')}}</text></view>
    <view class="fb-row" hover-class="hv" data-v="BFAFILM" data-n="WeChat" bindtap="copyContact"><text class="fb-k mono">WECHAT</text><text class="fb-v mono">BFAFILM</text><text class="fb-go">{{L.t(i,'复制')}}</text></view>
    </block>
  </view>

  <view class="blockh">{{L.t(i,'个人排片')}} <text class="en">MY PLAN</text></view>
  <view class="stats card">
    <view><text class="n mono">{{stats.n}}</text><text class="l">{{L.t(i,'场放映')}}</text></view>
    <view><text class="n mono">{{stats.d}}</text><text class="l">{{L.t(i,'天行程')}}</text></view>
    <view><text class="n mono">{{stats.hm}}</text><text class="l">{{L.t(i,'银幕时长')}}</text></view>
    <view class="{{clash?'bad':'good'}}"><text class="n mono">{{clash}}</text><text class="l">{{L.t(i,'时间冲突')}}</text></view>
  </view>

  <view wx:if="{{empty}}" class="empty">
    <text class="plus">＋</text>
    <text class="et">{{L.t(i,'还没有加入场次')}}</text>
    <text class="es">{{L.t(i,'在排片表或影片页点「加入排片」')}}</text>
    <view class="btn" bindtap="toSchedule">{{L.t(i,'去选电影')}}</view>
  </view>

  <block wx:else>
    <view wx:if="{{progs.length}}" class="pfbox">
      <view class="pf-head"><text class="pf-t">{{L.t(i,'选择专题')}}</text><text class="pf-s">{{L.t(i,'排片与分享只含所选内容')}}</text></view>
      <view class="plan-scope" bindtap="openPlanSelector"><view><text class="small">{{L.t(i,'选择专题')}}</text><text class="b">{{planScopeName}}</text></view><text>⌄</text></view>

    </view>
    <view class="tools">
      <view class="btn" hover-class="hv" bindtap="makeImage">{{L.t(i,'生成长图')}}</view>
      <button class="btn ghost" open-type="share">{{L.t(i,'分享给朋友')}}</button>
      <view class="btn ghost" bindtap="toSchedule">{{L.t(i,'继续选片')}}</view>
      <view class="clear" bindtap="clear">{{L.t(i,'清空')}}</view>
    </view>
    <view wx:if="{{pfEmpty}}" class="pf-empty card"><text class="b">{{L.t(i,'这个专题还没有加入场次')}}</text><text class="muted small">{{L.t(i,'切换到「全部专题」，或去排片表挑选。')}}</text></view>
    <view wx:if="{{clash}}" class="conflict"><text class="b">{{clashTxt}}</text>{{L.t(i,'，已在日程中标红，移出其中一场即可。')}}</view>
    <view wx:for="{{days}}" wx:for-item="day" wx:key="d" class="day">
      <view class="dh"><text class="dd mono">{{day.d}}</text><text class="dw">{{day.wk}}</text><text class="dr">{{day.cnt}} · {{day.range}}</text></view>
      <block wx:for="{{day.items}}" wx:key="key">
        <view wx:if="{{item.gap}}" class="gap {{item.gap.cls}}"><text>{{item.gap.txt}}</text><text wx:if="{{item.gap.mapName}}" class="gap-map" data-v="{{item.gap.mapName}}" bindtap="openMap">{{L.t(i,'地图')}} ›</text></view>
        <view class="it">
          <view class="tm mono"><text class="b">{{item.t}}</text><text>{{item.end}}</text></view>
          <view class="pc card" style="--c:{{item.color}}" data-id="{{item.id}}" bindtap="open">
            <image wx:if="{{item.poster}}" class="th" src="{{item.poster}}" mode="aspectFill" />
            <view class="pi">
              <view class="pt">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></view>
              <text class="ps">{{item.dir}} · {{item.minTxt}}</text>
              <text class="pv">{{item.venue}}<text class="htag">{{item.hall}}</text></text>
            </view>
            <view class="rm" data-key="{{item.key}}" catchtap="remove">✕</view>
          </view>
        </view>
      </block>
    </view>
    <canvas type="2d" id="poster" class="poster-cv" />
    <view class="note">{{L.t(i,'散场时间按片长计算，不含映前广告与映后交流。跨影院观影请另留交通时间。')}}</view>
  </block>

  <view class="makers">
    <text class="k2">{{L.t(i, '制作设计 · PRODUCED ' + '&' + ' DESIGNED BY')}}</text>
    <view class="row">
      <image src="/images/brand/sparrow-movies-sq.png" mode="aspectFit" />
      <text class="x">×</text>
      <image src="/images/brand/sparrow-tribe-sq.png" mode="aspectFit" />
    </view>
    <text class="d">{{L.t(i,'电影放映与策展')}}</text>
  </view>
</view>

<view wx:if="{{rcOpen}}" class="rc-mask" bindtap="closeRecap">
  <view class="rc-panel" catchtap="noop">
    <view class="rc-head"><text class="b">{{L.t(i,'我的影院观影结算')}}</text><text class="rc-x" bindtap="closeRecap">✕</text></view>
    <text class="rc-k mono">{{L.t(i,'年份 / YEAR')}}</text>
    <scroll-view scroll-x class="rc-seg-sv" enable-flex><view class="rc-seg"><view wx:for="{{rc.years}}" wx:key="v" class="rc-y {{rcY === item.v ? 'on' : ''}}" data-v="{{item.v}}" bindtap="setRcY"><text class="yb mono">{{item.n}}</text><text class="ys">{{item.c}}</text></view></view></scroll-view>
    <view class="rc-kh"><text class="rc-k mono">{{L.t(i,'月份 / MONTH')}}</text><text wx:if="{{rc.mSel}}" class="rc-clear" data-v="all" bindtap="setRcM">{{rc.mSel}} · {{L.t(i,'清除')}}</text><text wx:elif="{{rc.mY}}" class="rc-kv mono">{{rc.mY}}</text></view>
    <view class="rc-cal" wx:if="{{rc.grid.length}}"><view wx:for="{{rc.grid}}" wx:key="n" class="rc-d {{item.on ? 'on' : ''}} {{item.c ? '' : 'nil'}}" style="{{item.bg}}" data-v="{{item.v}}" data-c="{{item.c}}" bindtap="setRcM"><text class="db">{{item.n}}</text><text class="ds mono">{{item.cs}}</text></view></view>
    <view wx:else class="rc-mempty">{{L.t(i,'先选一个年份，再按月份筛选')}}</view>
    <text class="rc-k mono">{{L.t(i,'专题 / PROGRAMME')}}</text>
    <view class="rc-chips"><text wx:for="{{rc.progs}}" wx:key="v" class="chip {{rcP === item.v ? 'on' : ''}}" data-v="{{item.v}}" bindtap="setRcP">{{item.n}}</text></view>
    <view class="rc-sum" wx:if="{{rc.n}}">
      <view><text class="n mono">{{rc.n}}</text><text class="l">{{L.t(i,'部影片')}}</text></view>
      <view><text class="n mono">{{rc.hm}}</text><text class="l">{{L.t(i,'银幕时长')}}</text></view>
      <view><text class="n mono">{{rc.avg}}</text><text class="l">{{L.t(i,'平均评分')}}</text></view>
    </view>
    <view wx:else class="rc-sum"><text class="l">{{L.t(i,'这个范围里还没有看过的影片')}}</text></view>
    <view class="btn rc-go {{rc.n ? '' : 'dis'}}" bindtap="makeRecap">{{L.t(i,'生成结算长图')}}</view>
  </view>
</view>
<canvas type="2d" id="recap" class="poster-cv" />
