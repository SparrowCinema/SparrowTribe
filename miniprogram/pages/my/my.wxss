.rc-year-note{display:block;font-size:calc(23.2 * var(--r));line-height:1.6;color:var(--muted);margin-top:calc(20 * var(--r))}

.appearance-body{padding:0 calc(40 * var(--r)) calc(32 * var(--r)) calc(130 * var(--r));border-bottom:calc(1 * var(--r)) solid var(--line)}.rc-prog-picker{border:calc(1 * var(--r)) solid var(--line);border-radius:calc(20 * var(--r));margin-bottom:calc(24 * var(--r));background:var(--surface)}.rc-prog-summary{display:flex;justify-content:space-between;gap:calc(20 * var(--r));padding:calc(26 * var(--r));font-size:calc(28 * var(--r));color:var(--fg)}.rc-prog-label{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rc-prog-body{padding:0 calc(20 * var(--r)) calc(20 * var(--r))}.rc-prog-search{padding:calc(20 * var(--r));border:calc(1 * var(--r)) solid var(--line);border-radius:calc(12 * var(--r));font-size:calc(26 * var(--r));color:var(--fg)}.rc-prog-list{max-height:calc(400 * var(--r));height:calc(400 * var(--r))}.rc-prog-option{display:flex;gap:calc(18 * var(--r));padding:calc(22 * var(--r));font-size:calc(26 * var(--r));color:var(--fg)}.rc-prog-option.on{color:var(--teal);background:var(--bg)}

