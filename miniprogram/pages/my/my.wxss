n{font-size:40rpx;font-weight:400}.fp-tallies .l{font-size:19rpx}.fp-recap{background:none;color:var(--fg);border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);border-radius:0;padding:30rpx 0;margin-top:38rpx}.fp-recap .b{font-size:30rpx;font-weight:600}.fp-recap .s{font-size:20rpx;color:var(--muted)}.fp-recap .ar{color:var(--teal)}.my-library-links{display:flex;margin:28rpx 0 36rpx;gap:12rpx}.my-library-links>view{flex:1;text-align:center;padding:22rpx 8rpx;border:1rpx solid var(--line);border-radius:6rpx;background:var(--surface);font-size:21rpx;color:var(--teal)}.sy{border:0;border-top:1rpx solid var(--line);border-bottom:1rpx solid var(--line);background:none;border-radius:0;box-shadow:none;padding:28rpx 0}.sy-h{display:flex;justify-content:space-between;font-size:27rpx;font-weight:600;margin-bottom:0}.sy-lead{margin-top:22rpx}.sy-st{margin-top:22rpx}
