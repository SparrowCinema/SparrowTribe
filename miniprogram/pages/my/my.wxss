.k { font-size: 18rpx; letter-spacing: 8rpx; color: var(--accent); margin-top: 40rpx; }
.h1 { font-size: 64rpx; font-weight: 900; margin: 8rpx 0 4rpx; }
.stats { display: flex; margin: 24rpx 0 32rpx; overflow: hidden; }
.stats > view { flex: 1; display: flex; flex-direction: column; padding: 20rpx; }
.stats > view + view { border-left: 2rpx solid var(--line-soft); }
.stats .n { font-size: 40rpx; font-weight: 700; }
.stats .l { font-size: 20rpx; color: var(--muted); }
.stats .good .n { color: var(--teal); }
.stats .bad { background: #f3dcd6; }
.stats .bad .n { color: #c4372d; }
.empty { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 80rpx 0; }
.plus { font-size: 80rpx; color: var(--accent); line-height: 1; }
.et { font-size: 34rpx; font-weight: 700; }
.es { font-size: 24rpx; color: var(--muted); margin-bottom: 20rpx; }
.tools { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-bottom: 28rpx; }
.clear { margin-left: auto; font-size: 24rpx; color: var(--muted); text-decoration: underline; }
