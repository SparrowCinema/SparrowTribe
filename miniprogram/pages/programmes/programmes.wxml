<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view class="brandbar">
  <image class="sq" src="{{dk ? '/images/brand/sparrow-movies-sq-dark.png' : '/images/brand/sparrow-movies-sq.png'}}" mode="aspectFit" />
  <text class="x">×</text>
  <image class="sq" src="{{dk ? '/images/brand/sparrow-tribe-sq-dark.png' : '/images/brand/sparrow-tribe-sq.png'}}" mode="aspectFit" />
  <view class="bb-sp" />
  <view class="lang" hover-class="hv" bindtap="switchLang"><text class="{{en ? '' : 'on'}}">中</text><text class="{{en ? 'on' : ''}}">EN</text></view>
  <view class="tag"><text>{{L.t(i,'观影')}}\n{{L.t(i,'护照')}}</text></view>
</view>
<template name="pc">
  <view class="prog card pc-{{status}}" data-id="{{id}}" bindtap="open">
    <image wx:if="{{cover}}" class="cover" src="{{cardCover || cover}}" mode="aspectFill" />
    <view class="pbody">
      <text class="pk mono"><text class="pst pst-{{status}}">{{statusText}}</text>{{kt}} · {{pt}}</text>
      <text class="pn">{{name}}</text>
      <text class="ps">{{stat}}</text>
    </view>
    <text class="go">{{goTxt}}</text>
  </view>
</template>

<view class="wrap">
  <view class="h2">{{L.t(i,'专题')}}</view>
  <view class="sub">{{subline}}</view>
  <view class="sub-cal" hover-class="hv" bindtap="subAll">{{L.t(i,'订阅全部专题日历')}} <text>›</text></view>

  <block wx:if="{{live.length}}">
    <view class="blockh">{{L.t(i,'进行中')}} <text class="en">{{live.length}} · NOW ON</text></view>
    <view class="pgrid"><block wx:for="{{live}}" wx:key="id"><template is="pc" data="{{...item}}" /></block></view>
  </block>
  <block wx:if="{{soon.length}}">
    <view class="blockh">{{L.t(i,'即将开始')}} <text class="en">{{soon.length}} · COMING UP</text></view>
    <view class="pgrid"><block wx:for="{{soon}}" wx:key="id"><template is="pc" data="{{...item}}" /></block></view>
  </block>
  <view wx:if="{{past.length}}" class="past-drawer {{pastOpen ? 'open' : ''}}">
    <view class="past-drawer-h" hover-class="hv" bindtap="togglePast">
      <view class="pd-copy"><text class="past-t">{{L.t(i,'往期专题')}}</text><text class="past-n">{{pastN}}</text></view>
      <view class="fp-minis"><view wx:for="{{pastMinis}}" wx:key="id" class="fp-mi" style="background:{{item.bg}}" /></view>
      <view class="past-go"><view class="past-ar {{pastOpen ? 'open' : ''}}" /></view>
    </view>
    <view wx:if="{{pastOpen}}" class="past-drawer-b">
      <scroll-view wx:if="{{pastYearPills.length}}" scroll-x enable-flex class="past-ybar">
        <view class="past-ypill {{!pastYearFilt ? 'on' : ''}}" data-year="" bindtap="setPastYear"><text>{{L.t(i,'全部年份')}}</text></view>
        <view wx:for="{{pastYearPills}}" wx:key="year" class="past-ypill {{pastYearFilt === item.year ? 'on' : ''}}" data-year="{{item.year}}" bindtap="setPastYear"><text>{{item.label}}</text><text class="yp-n mono">{{item.cnt}}</text></view>
      </scroll-view>
      <view wx:for="{{pastYears}}" wx:for-item="yg" wx:key="year" class="pyear {{yg.open ? 'open' : ''}}">
        <view wx:if="{{pastByYear}}" class="pyear-h" data-year="{{yg.year}}" bindtap="togglePastYear">
          <text class="pyear-t">{{yg.label}}</text>
          <text class="pyear-m mono">{{yg.meta}}</text>
          <text class="pyear-ar">{{yg.open ? '⌄' : '›'}}</text>
        </view>
        <scroll-view wx:if="{{yg.open}}" scroll-x enable-flex class="pshelf">
          <view wx:for="{{yg.items}}" wx:for-item="sp" wx:key="id" class="pspine" style="background:{{sp.bg}};color:{{sp.ink}}" data-id="{{sp.id}}" bindtap="open">
            <view class="ps-top"><text class="ps-date mono">{{sp.meta}}</text><text class="ps-cnt mono">({{sp.subCnt}})</text></view>
            <view class="ps-mid"><text class="ps-title {{en ? 'en' : ''}}">{{sp.spineName}}</text></view>
            <view class="ps-art">
              <view class="ps-fade" style="background:linear-gradient(to bottom,{{sp.bg}},transparent)" />
              <image wx:if="{{sp.art}}" class="ps-img" src="{{sp.art}}" mode="aspectFill" lazy-load />
              <view wx:else class="ps-ph"><text>{{sp.ch}}</text></view>
            </view>
          </view>
          <view wx:if="{{yg.rest}}" class="pspine pspine-more" data-year="{{yg.year}}" bindtap="morePastYear">
            <text class="pm-t">{{L.t(i,'展开其余')}}</text>
            <text class="pm-n mono">+{{yg.rest}}</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>
  <view wx:if="{{!total}}" class="empty card"><text class="eb">{{L.t(i,'专题整理中')}}</text><text class="es">{{L.t(i,'新的影展与放映专题会陆续上线。')}}</text></view>
</view>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>
