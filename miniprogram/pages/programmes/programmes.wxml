<wxs src="../../utils/l.wxs" module="L" />
<view class="brandbar">
  <image class="sq" src="/images/brand/sparrow-movies-sq.png" mode="aspectFit" />
  <text class="x">×</text>
  <image class="sq" src="/images/brand/sparrow-tribe-sq.png" mode="aspectFit" />
  <view class="bb-sp" />
  <view class="lang" hover-class="hv" bindtap="switchLang"><text class="{{en ? '' : 'on'}}">中</text><text class="{{en ? 'on' : ''}}">EN</text></view>
  <view class="tag"><text>{{L.t(i,'观影')}}\n{{L.t(i,'护照')}}</text></view>
</view>
<template name="pc">
  <view class="prog card" data-id="{{id}}" bindtap="open">
    <image wx:if="{{cover}}" class="cover" src="{{cardCover || cover}}" mode="aspectFill" />
    <view class="pbody">
      <text class="pk mono"><text class="pst pst-{{status}}">{{statusText}}</text>{{kt}} · {{pt}}</text>
      <text class="pn">{{name}}</text>
      <text class="ps">{{stat}}</text>
      <text wx:if="{{blurb}}" class="pb">{{blurb}}</text>
    </view>
    <text class="go">{{goTxt}}</text>
  </view>
</template>

<view class="wrap">
  <view class="h2">{{L.t(i,'专题')}}</view>
  <view class="sub">{{subline}}</view>
  <view class="sub-cal" hover-class="hv" bindtap="subAll">{{L.t(i,'订阅全部专题日历')}} <text>›</text></view>

  <block wx:if="{{live.length}}">
    <view class="blockh">{{L.t(i,'进行中')}} <text class="en">{{live.length}} · NOW ON</text></view>
    <view class="pgrid"><block wx:for="{{live}}" wx:key="id"><template is="pc" data="{{...item}}" /></block></view>
  </block>
  <block wx:if="{{soon.length}}">
    <view class="blockh">{{L.t(i,'即将开始')}} <text class="en">{{soon.length}} · COMING UP</text></view>
    <view class="pgrid"><block wx:for="{{soon}}" wx:key="id"><template is="pc" data="{{...item}}" /></block></view>
  </block>
  <block wx:if="{{past.length}}">
    <view class="past-h" hover-class="hv" bindtap="togglePast">
      <text class="past-t">{{L.t(i,'往期专题')}}</text><text class="past-n">{{pastN}}</text>
      <view class="past-go"><text>{{pastOpen ? L.t(i,'收起') : L.t(i,'展开')}}</text><view class="past-ar {{pastOpen ? 'open' : ''}}" /></view>
    </view>
    <view wx:if="{{pastOpen}}" class="pgrid"><block wx:for="{{past}}" wx:key="id"><template is="pc" data="{{...item}}" /></block></view>
  </block>
  <view wx:if="{{!total}}" class="empty card"><text class="eb">{{L.t(i,'专题整理中')}}</text><text class="es">{{L.t(i,'新的影展与放映专题会陆续上线。')}}</text></view>
</view>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>
