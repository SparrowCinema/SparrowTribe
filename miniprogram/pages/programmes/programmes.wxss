.ps-top { width: 100%; padding: calc(14 * var(--r)) calc(6 * var(--r)) calc(6 * var(--r)); display: flex; flex-direction: column; align-items: center; gap: calc(2 * var(--r)); flex: none; box-sizing: border-box; }
