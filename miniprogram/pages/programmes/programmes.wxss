.past-ypill { display: inline-flex; align-items: center; gap: calc(8 * var(--r)); height: calc(52 * var(--r)); padding: 0 calc(20 * var(--r)); margin-right: calc(12 * var(--r)); border: calc(2 * var(--r)) solid var(--line); border-radius: 999px; background: var(--bg); color: var(--fg); font-size: calc(20 * var(--fr)); box-sizing: border-box; }
