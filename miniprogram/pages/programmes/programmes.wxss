.pshelf { display: flex; align-items: stretch; white-space: nowrap; height: calc(448 * var(--r)); padding: calc(16 * var(--r)) calc(4 * var(--r)) calc(20 * var(--r)); border-bottom: calc(3 * var(--r)) solid var(--line); box-sizing: border-box; }
