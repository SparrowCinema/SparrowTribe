@import "../poster-wall/poster-wall.wxss";
/* 与「我的」成长卡片同一套卡片样式 */
.gs { padding: calc(32 * var(--r)) calc(28 * var(--r)) calc(28 * var(--r)); border-radius: calc(32 * var(--r)); background: var(--surface); border: calc(2 * var(--r)) solid var(--line-soft); }
.gs-h { display: flex; align-items: baseline; justify-content: space-between; gap: calc(16 * var(--r)); margin-bottom: calc(24 * var(--r)); }
.gs-t { font-size: calc(35 * var(--fr)); font-weight: 700; letter-spacing: calc(2 * var(--r)); }
.gs-s { font-size: calc(28 * var(--fr)); color: var(--muted); }
.gs-empty { display: block; padding: calc(28 * var(--r)) 0; text-align: center; font-size: calc(30 * var(--fr)); color: var(--muted); }
.taste-plot{height:calc(390 * var(--r));position:relative;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;border-radius:calc(16 * var(--r));border:calc(2 * var(--r)) solid var(--line);overflow:hidden;background:var(--bg)}
.taste-q{display:flex;padding:calc(10 * var(--r)) calc(16 * var(--r));pointer-events:none;font-size:calc(28 * var(--fr));color:var(--muted);border-color:var(--line-soft);box-sizing:border-box}.taste-q1,.taste-q3{border-right:calc(2 * var(--r)) dashed var(--line)}.taste-q1,.taste-q2{border-bottom:calc(2 * var(--r)) dashed var(--line)}.taste-dot{position:absolute;width:calc(13 * var(--r));height:calc(13 * var(--r));border-radius:50%;background:var(--accent);border:calc(2 * var(--r)) solid var(--surface);transform:translate(-50%,-50%);z-index:2}.taste-axis{text-align:center;font-size:calc(28 * var(--fr));color:var(--muted);padding:calc(12 * var(--r)) 0}.taste-legend{display:flex;flex-wrap:wrap;justify-content:space-between;gap:calc(12 * var(--r));font-size:calc(28 * var(--fr));color:var(--fg)}.taste-foot{display:block;font-size:calc(26 * var(--fr));color:var(--muted);margin-top:calc(14 * var(--r))}
.taste-switch{display:flex;gap:calc(14 * var(--r));margin:calc(20 * var(--r)) 0}.taste-switch button{flex:1;font-size:calc(30 * var(--fr));line-height:1.4;padding:calc(18 * var(--r));background:var(--surface);color:var(--muted);border:calc(1 * var(--r)) solid var(--line)}.taste-switch button.on{color:var(--surface);background:var(--teal)}.taste-plot .taste-dot{width:calc(36 * var(--r));height:calc(36 * var(--r));display:flex;align-items:center;justify-content:center;font-size:calc(17 * var(--r));color:var(--surface)}.taste-selected{max-height:calc(360 * var(--r));overflow-y:auto}.taste-selected button{font-size:calc(30 * var(--fr));line-height:1.5;text-align:left;background:var(--surface);color:var(--teal);padding:calc(18 * var(--r));margin:calc(8 * var(--r)) 0}
.taste-q1{align-items:flex-start;justify-content:flex-start}.taste-q2{align-items:flex-start;justify-content:flex-end}.taste-q3{align-items:flex-end;justify-content:flex-start}.taste-q4{align-items:flex-end;justify-content:flex-end}
.taste-legend>view{flex:1 1 40%}.taste-legend .tl-n{font-weight:600}
.tm-page{padding-bottom:calc(70 * var(--r))}.tm-page .taste-map{margin-top:calc(8 * var(--r))}
