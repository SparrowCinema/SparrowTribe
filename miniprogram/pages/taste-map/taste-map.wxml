<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view class="wrap tm-page">
 <view class="wall-heading">{{L.t(i,'我的趣味图谱')}}</view>
 <view class="wall-hint">{{i.__en?'Across: how interesting. Up: how boring. Rate both on a film page and it appears here.':'横轴是有趣度，纵轴是无聊度。在影片页「趣味」一栏给两项都打分，影片就会出现在图上。'}}</view>
    <view class="taste-map gs">
      <view class="gs-h"><text class="gs-t">{{i.__en?'Quadrants':'四象限'}}</text><text class="gs-s">{{tasteMap.n}} {{i.__en?'films':'部电影'}}</text></view>
      <view class="taste-switch"><button data-mode="mine" class="{{tasteMode!=='community'?'on':''}}" bindtap="setTasteMode">{{i.__en?'My quadrants':'我的四象限'}}</button><button data-mode="community" class="{{tasteMode==='community'?'on':''}}" bindtap="setTasteMode">{{i.__en?'Community quadrants':'社区四象限'}}</button></view>
      <view class="taste-plot">
        <view class="taste-q taste-q1">{{i.__en?'Enduring':'漫长难熬'}}</view><view class="taste-q taste-q2">{{i.__en?'Captivating & tiring':'迷人又折磨'}}</view>
        <view class="taste-q taste-q3">{{i.__en?'Quiet':'平静无波'}}</view><view class="taste-q taste-q4">{{i.__en?'Delightful':'趣味横生'}}</view>
        <view wx:for="{{tasteMap.points}}" wx:key="key" class="taste-dot" style="left:{{item.x}}%;top:{{item.y}}%" role="button" aria-label="{{item.fun}}/5 · {{item.bore}}/5 · {{item.n}}" data-key="{{item.key}}" bindtap="selectTastePoint">{{item.n>1?item.n:''}}</view>
      </view>
      <view class="taste-selected"><button wx:for="{{tasteSelected}}" wx:key="id" data-id="{{item.id}}" bindtap="openTasteFilm">{{item.title}} · {{i.__en?'Interesting':'有趣'}} {{item.funTxt}} · {{i.__en?'Boring':'无聊'}} {{item.boreTxt}} ›</button></view>
      <text wx:if="{{tasteMode==='community'}}" class="taste-foot">{{tasteCommunityError?(i.__en?'Community unavailable. Your personal map is unaffected.':'社区暂不可用，个人图谱不受影响。'):(i.__en?'Averages within 2.75–3.25 are hard to classify and sit on the midline. Tap a point to see the films.':'均分在 2.75–3.25 之间算难以归类，落在中线上。点击圆点查看影片。')}}<block wx:if="{{!tasteCommunityError && tasteLow}}"> {{i.__en?tasteLow+' films have fewer than 3 paired ratings and are not plotted yet.':tasteLow+' 部影片样本不足 3 人，暂不上图。'}}</block></text>
      <text wx:else class="taste-foot">{{i.__en?'A 3 is the middle value: hard to classify, plotted on the midline. Films rated on only one scale are not plotted. Tap a point to see the films.':'3 分是中间值，算难以归类，落在中线上；只评了一项的影片不上图。点击圆点查看影片。'}}</text>
      <view class="taste-axis">{{i.__en?'Interesting →':'有趣度 →'}}　　{{i.__en?'↑ Boring':'↑ 无聊度'}}</view>
      <view class="taste-legend"><view wx:for="{{tasteMap.quadrants}}" wx:key="index"><text>{{item.name}} </text><text class="mono tl-n">{{item.count}}</text></view><view><text>{{i.__en?'Hard to classify':'难以归类'}} </text><text class="mono tl-n">{{tasteMap.unsure}}</text></view></view>
      <text class="gs-empty" wx:if="{{!tasteMap.n}}">{{i.__en?'Rate both dimensions on a watched film to start your map.':'给看过的电影分别评价有趣和无聊，就能点亮图谱。'}}</text>
    </view>
</view>
