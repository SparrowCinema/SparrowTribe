<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<wxs src="./ticket-tilt.wxs" module="tilt" />
<view class="album">
  <view class="al-head"><view><text class="al-brand">SPARROW FILM PASSPORT</text><view class="al-title">{{L.t(i,'我的票根收藏册')}}</view></view>
    <button wx:if="{{mode==='wall'}}" class="al-primary" bindtap="start">{{L.t(i,'制作票根')}}</button>
    <button wx:else class="al-alt" bindtap="wall">{{L.t(i,'返回收藏册')}}</button>
  </view>
  <block wx:if="{{mode==='wall'}}">
    <view wx:if="{{pages || year || programme}}" class="al-tools">
      <picker mode="selector" range="{{years}}" value="{{year}}" data-field="year" bindchange="filter"><view class="al-alt">{{years[year]}} ›</view></picker>
      <picker mode="selector" range="{{programmes}}" value="{{programme}}" data-field="programme" bindchange="filter"><view class="al-alt">{{programmes[programme]}} ›</view></picker>
      <button class="al-alt" bindtap="flipWall">{{L.t(i,front?'正面':'背面')}} ↻</button>
      <button class="al-primary al-export" disabled="{{!count || loading}}" bindtap="exportWall">{{L.t(i,'导出本页票根墙')}}</button>
    </view>
    <view wx:if="{{rows.length}}" class="al-grid">
      <view wx:for="{{rows}}" wx:key="id" class="al-tile" data-index="{{index}}" bindtap="openTicket" aria-role="button" aria-label="{{item.title}}">
        <canvas type="2d" id="ticket-tile-{{index}}" class="al-tile-canvas" />
        <text>{{item.title}}</text>
      </view>
    </view>
    <view wx:else class="al-empty">{{L.t(i,year || programme ? '所选条件下暂无票根' : '还没有收藏票根')}}</view>
    <view wx:if="{{count}}" class="al-pager"><text>{{count}} {{L.t(i,'张票根')}} {{pages>1?' · '+(page+1)+' / '+pages:''}}</text>
      <button wx:if="{{pages>1}}" disabled="{{page<=0}}" class="al-alt" data-move="-1" bindtap="move">{{L.t(i,'上一页')}}</button>
      <button wx:if="{{pages>1}}" disabled="{{page+1>=pages}}" class="al-alt" data-move="1" bindtap="move">{{L.t(i,'下一页')}}</button>
    </view>
  </block>
  <block wx:elif="{{mode==='search'}}">
    <view class="al-empty"><text>{{L.t(i,'搜索护照片库')}}</text><input type="text" value="{{query}}" bindinput="inputSearch" placeholder="{{L.t(i,'输入电影片名开始搜索。')}}" />
      <view wx:if="{{results.length}}" class="al-results"><view wx:for="{{results}}" wx:key="id" class="al-result" bindtap="openFilm" data-id="{{item.id}}" aria-role="button">
        <image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFill" lazy-load /><text>{{item.title}}</text></view></view>
      <text wx:elif="{{query}}">{{L.t(i,'没有匹配的影片')}}</text>
    </view>
  </block>
  <block wx:else>
    <view class="al-edit">
      <view class="al-stage">
        <view class="al-flip al-shine-{{editShine}}" style="--metal-highlight:{{editHighlight}};" bindtap="flipEditor"
          aria-role="button" aria-label="{{L.t(i,'翻面')}}" tilt-bounds="{{tiltBounds}}" change:tilt-bounds="{{tilt.bounds}}"
          bindtouchstart="{{tilt.start}}" bindtouchmove="{{tilt.move}}" bindtouchend="{{tilt.end}}" bindtouchcancel="{{tilt.end}}">
          <view class="al-flip-motion">
            <view class="al-turn {{editFront?'':'al-turned'}}">
              <view class="al-face al-front"><canvas type="2d" id="ticket-editor-front" class="al-editor-canvas" /></view>
              <view class="al-face al-back"><canvas type="2d" id="ticket-editor-back" class="al-editor-canvas" /></view>
            </view>
          </view>
        </view>
        <button class="al-alt" bindtap="flipEditor">{{L.t(i,editFront?'翻到背面':'翻回正面')}}</button>
        <view class="al-blind-box">
          <text>{{L.t(i,'票根盲盒')}}</text>
          <view class="al-actions">
            <button class="al-alt" bindtap="shuffle">{{L.t(i,'随机换一款')}}</button>
            <button class="al-alt" bindtap="reset">{{L.t(i,'恢复专题默认')}}</button>
          </view>
        </view>
      </view>
      <view class="al-fields">
        <view class="al-film">{{draft.title}}</view>
        <picker wx:if="{{shows.length>1}}" mode="selector" range="{{shows}}" value="{{showIndex}}" bindchange="chooseShow" class="al-wide"><text>{{L.t(i,'护照场次')}}</text><view class="al-value">{{shows[showIndex]}} ›</view></picker>
        <picker wx:if="{{arts.length>1}}" mode="selector" range="{{arts}}" value="{{artIndex}}" bindchange="chooseArt"><text>{{L.t(i,'票面图像')}}</text><view class="al-value">{{arts[artIndex]}} ›</view></picker>
        <view wx:if="{{arts.length}}" class="al-wide"><text>{{L.t(i,'调整裁切位置')}}</text><slider min="0" max="100" value="{{draft.crop}}" bindchange="changeField" data-field="crop" /></view>
        <picker mode="date" value="{{draft.date}}" data-field="date" bindchange="changeField"><text>{{L.t(i,'日期')}}</text><view class="al-value">{{draft.date || '—'}}</view></picker>
        <picker mode="time" value="{{draft.time}}" data-field="time" bindchange="changeField"><text>{{L.t(i,'开场时间')}}</text><view class="al-value">{{draft.time || '—'}}</view></picker>
        <label><text>{{L.t(i,'影院')}}</text><input value="{{draft.venue}}" data-field="venue" bindblur="changeField" /></label>
        <label><text>{{L.t(i,'影厅')}}</text><input value="{{draft.hall}}" data-field="hall" bindblur="changeField" /></label>
        <label><text>{{L.t(i,'座位')}}</text><input value="{{draft.seat}}" data-field="seat" bindblur="changeField" /></label>
        <label><text>{{L.t(i,'放映版本')}}</text><input value="{{draft.format}}" data-field="format" bindblur="changeField" /></label>
        <view class="al-actions al-wide">
          <button class="al-primary" bindtap="store">{{L.t(i,existing?'更新票根':'加入收藏册')}}</button>
          <button class="al-alt" disabled="{{loading}}" bindtap="exportSingle">{{L.t(i,'导出这张票根')}}</button>
          <button wx:if="{{existing}}" class="al-alt" bindtap="remove">{{L.t(i,'移出票根')}}</button>
        </view>
      </view>
    </view>
  </block>
</view>
<canvas type="2d" id="ticket-export-canvas" class="al-export-canvas" />
