<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view class="wrap wall-page">
 <view class="wall-heading">{{L.t(i,'我的海报墙')}}</view>
 <view class="wall-filters" aria-label="{{L.t(i,'海报墙筛选')}}">
  <view class="wall-filter {{programme!=='all'?'active':''}}" bindtap="openSelector" role="button" aria-label="{{L.t(i,'专题')}} · {{programmeLabel}}"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'专题')}}</text><text class="wall-value">{{programmeLabel}}</text></view><text class="wall-chevron">⌄</text></view>
  <picker class="wall-picker" range="{{modes}}" value="{{modeIndex}}" bindchange="setMode"><view class="wall-filter"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'海报墙')}}</text><text class="wall-value">{{modes[modeIndex]}}</text></view><text class="wall-chevron">⌄</text></view></picker>
  <picker class="wall-picker" range="{{periods}}" value="{{periodIndex}}" bindchange="setPeriod" disabled="{{!periods.length}}"><view class="wall-filter"><view class="wall-filter-copy"><text class="wall-label">{{L.t(i,'观影时间')}}</text><text class="wall-value">{{period || '—'}}</text></view><text class="wall-chevron">⌄</text></view></picker>
 </view>
 <view class="wall-toolbar"><text>{{L.n(i,items.length,'f')}} · {{L.t(i,'按最近观影排列')}}</text><button class="wall-export" disabled="{{!items.length}}" bindtap="exportWall">{{L.t(i,'导出海报墙')}}</button></view>
 <block wx:if="{{items.length}}"><view class="wall-hint">{{L.t(i,'点击海报查看影片，向下浏览更多。')}}</view>
 <view class="wall-grid" style="--cols:{{cols}}"><view wx:for="{{items}}" wx:key="id" class="wall-film" data-id="{{item.id}}" bindtap="openFilm" role="button" aria-label="{{item.title}} · {{L.t(i,'我的评分')}} {{item.score}}"><view class="wall-poster"><view class="wall-placeholder">{{item.title}}</view><image wx:if="{{item.poster}}" class="wall-image" src="{{item.poster}}" mode="aspectFill" lazy-load data-index="{{index}}" binderror="posterError" /></view><view class="wall-stars" role="img" aria-label="{{item.score}}"><view wx:for="{{item.stars}}" wx:for-item="st" wx:key="index" class="ws"><text>★</text><view class="ws1" style="width:{{st}}%"><text>★</text></view></view></view></view></view></block>
 <view wx:else class="wall-empty"><text class="wall-heading">{{L.t(i,programme==='all'?'海报墙还没有影片':'所选条件下暂无影片')}}</text><text>{{L.t(i,programme==='all'?'在影片页标记看过，海报和评分就会收进这里。':'试试其他专题或观影时间。')}}</text><view class="btn" bindtap="toFilms">{{L.t(i,'去选电影')}}</view></view>
 <view wx:if="{{selectorType}}" class="selector-mask" catchtap="closeSelector" catchtouchmove="stopMove"><view class="selector-panel" catchtap="stopMove"><view class="selector-head"><text>{{L.t(i,'选择专题')}}</text><view class="selector-close" bindtap="closeSelector" role="button" aria-label="{{L.t(i,'关闭筛选')}}">×</view></view><input class="selector-search" placeholder="{{L.t(i,'搜索专题')}}" value="{{selectorQuery}}" bindinput="searchSelector" /><scroll-view scroll-y class="selector-results"><view wx:for="{{selectorRows}}" wx:key="id" class="selector-option {{item.selected?'selected':''}}" data-id="{{item.id}}" bindtap="chooseProgramme" role="checkbox" aria-checked="{{item.selected}}"><view class="selector-copy"><text>{{item.name}}</text><text class="small muted">{{L.n(i,item.n,'f')}}</text></view><text class="selector-check {{item.selected?'on':''}}">{{item.selected?'✓':''}}</text></view><view wx:if="{{!selectorRows.length}}" class="selector-empty">{{L.t(i,'没有匹配的结果')}}</view></scroll-view><view class="selector-foot"><text>{{L.t(i,'可多选')}}</text><view class="selector-done" bindtap="closeSelector">{{L.t(i,'完成')}}</view></view></view></view>
</view>

<canvas type="2d" id="poster-wall-canvas" class="wall-canvas" />
