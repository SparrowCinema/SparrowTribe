.cover { width: 100%; display: block; }
.k { font-size: 18rpx; letter-spacing: 8rpx; color: var(--accent); margin-top: 36rpx; }
.h1 { font-size: 64rpx; font-weight: 900; line-height: 1.2; margin: 8rpx 0 4rpx; }
.stats { display: flex; margin: 28rpx 0; overflow: hidden; }
.stats > view { flex: 1; display: flex; flex-direction: column; padding: 20rpx; }
.stats > view + view { border-left: 2rpx solid var(--line-soft); }
.stats .n { font-size: 40rpx; font-weight: 700; }
.stats .l { font-size: 20rpx; color: var(--muted); }
.blurb { font-size: 29rpx; line-height: 1.85; margin-bottom: 28rpx; }
.grid { display: flex; flex-wrap: wrap; gap: 28rpx 20rpx; }
.gf { width: calc((100% - 40rpx) / 3); display: flex; flex-direction: column; gap: 6rpx; }
.gf image, .ph { width: 100%; height: 300rpx; border-radius: 10rpx; box-shadow: 0 4rpx 14rpx rgba(0,0,0,.12); }
.ph { display: flex; align-items: center; justify-content: center; color: #fffaf0; font-size: 48rpx; font-weight: 900; }
.gt { font-size: 24rpx; font-weight: 700; line-height: 1.3; }
.gs { font-size: 18rpx; color: var(--muted); }

.empty { display: flex; flex-direction: column; gap: 8rpx; padding: 28rpx; border: 2rpx dashed var(--line); border-radius: 20rpx; margin-top: 16rpx; }
.empty .eb { font-size: 28rpx; font-weight: 700; }
.empty .es { font-size: 24rpx; color: var(--muted); }

.gone-h { display: flex; align-items: baseline; gap: 14rpx; margin: 56rpx 0 18rpx; padding-top: 24rpx; border-top: 2rpx dashed var(--line); color: var(--muted); }
.gone-t { font-size: 34rpx; font-weight: 900; }
.gone-h .en { font-size: 20rpx; letter-spacing: 4rpx; }
.gone-go { margin-left: auto; display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; font-weight: 600; }
.gone-ar { width: 12rpx; height: 12rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg) translateY(-3rpx); transition: transform .2s; }
.gone-ar.open { transform: rotate(-135deg) translateY(-3rpx); }
.gone .gf { opacity: .78; }

.jumps { display: flex; gap: 20rpx; margin-bottom: 8rpx; }
.jumps .btn { flex: 1; }
.pst { display: inline-block; margin-right: 12rpx; padding: 0 12rpx; border-radius: 8rpx; font-size: 20rpx; font-style: normal; font-weight: 700; letter-spacing: 1rpx; }
.pst-live { background: rgba(47, 111, 108, .14); color: var(--teal); }
.pst-soon { background: rgba(178, 106, 31, .16); color: var(--ochre); }
.pst-ended { background: var(--chip); color: var(--muted); }
