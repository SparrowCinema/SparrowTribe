<wxs src="../../utils/l.wxs" module="L" />
<view wx:if="{{p}}">
  <image wx:if="{{p.cover}}" class="cover" src="{{p.cover}}" mode="widthFix" />
  <view class="wrap">
    <view class="k mono">{{p.en}}</view>
    <view class="h1">{{p.name}}</view>
    <view class="sub"><text class="pst pst-{{p.status}}">{{p.statusText}}</text>{{p.sub}} · {{p.periodT}}</view>
    <view class="stats card">
      <view><text class="n mono">{{stats.f}}</text><text class="l">{{L.t(i,'部影片')}}</text></view>
      <view><text class="n mono">{{stats.s}}</text><text class="l">{{L.t(i,'场放映')}}</text></view>
      <view><text class="n mono">{{stats.d}}</text><text class="l">{{L.t(i,'个放映日')}}</text></view>
      <view><text class="n mono">{{stats.h}}</text><text class="l">{{L.t(i,'个影厅')}}</text></view>
    </view>
    <view wx:if="{{p.blurb}}" class="blurb">{{p.blurb}}</view>
    <view wx:if="{{p.ticket}}" class="jumps"><view class="btn" bindtap="previewTicket">{{L.t(i,"淘票票扫码购票")}}</view></view>
    <view wx:if="{{sections.length > 1}}" class="section-tabs"><view wx:for="{{sections}}" wx:key="value" class="btn {{section===item.value ? '' : 'ghost'}}" data-section="{{item.value}}" bindtap="selectSection">{{item.name}}</view></view>
    <view class="jumps"><view class="btn" bindtap="jump" data-to="up">{{L.t(i,'即将放映')}}</view><view class="btn ghost" bindtap="jump" data-to="gone">{{L.t(i,'已结束')}}</view></view>
    <view class="blockh" id="pg-up">{{L.t(i,'即将放映')}} <text class="en">UPCOMING · {{upN}}</text></view>
    <view wx:if="{{!films.length}}" class="empty"><text class="eb">{{gone.length ? L.t(i,'暂无待映场次') : L.t(i,'片单与场次即将公布')}}</text><text class="es">{{gone.length ? L.t(i,'新场次公布后会更新到这里。') : L.t(i,'公布后会第一时间更新到这里。')}}</text></view>
    <view wx:else class="grid">
      <view wx:for="{{films}}" wx:key="id" class="gf" data-id="{{item.id}}" bindtap="open">
        <image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFill" lazy-load />
        <view wx:else class="ph" style="background:{{item.color}}">{{item.ini}}</view>
        <text class="gt">{{item.cn}}</text>
        <text class="gs mono">{{item.version ? item.version + ' · ' : ''}}{{item.first}}</text>
      </view>
    </view>
    <block wx:if="{{gone.length}}">
      <view class="gone-h" id="pg-gone" hover-class="hv" bindtap="toggleGone">
        <text class="gone-t">{{L.t(i,'已结束')}}</text><text class="en">ENDED · {{goneN}}</text>
        <view class="gone-go"><text>{{goneOpen ? L.t(i,'收起') : L.t(i,'展开')}}</text><view class="gone-ar {{goneOpen ? 'open' : ''}}" /></view>
      </view>
      <view wx:if="{{goneOpen}}" class="grid gone">
        <view wx:for="{{gone}}" wx:key="id" class="gf" data-id="{{item.id}}" bindtap="open">
          <image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFill" lazy-load />
          <view wx:else class="ph" style="background:{{item.color}}">{{item.ini}}</view>
          <text class="gt">{{item.cn}}</text>
          <text wx:if="{{item.version}}" class="gs mono">{{item.version}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
