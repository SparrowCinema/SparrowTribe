.wrap { padding: 32rpx; }
.h1 { font-size: 56rpx; font-weight: 900; }
.sub { font-size: 26rpx; color: var(--muted); margin: 8rpx 0 20rpx; }
.tabs { white-space: nowrap; margin-bottom: 12rpx; }
.tab { display: inline-block; padding: 12rpx 26rpx; margin-right: 14rpx; border-radius: 99rpx; border: 2rpx solid var(--line-soft); font-size: 26rpx; }
.tab.on { background: var(--accent); color: #fff; border-color: var(--accent); }
.ev-h { font-size: 26rpx; color: var(--muted); margin: 20rpx 0 8rpx; }
.ev-card { border-top: 2rpx solid var(--line-soft); padding: 20rpx 0; }
.ev-done { opacity: .65; }
.ev-t { font-size: 29rpx; font-weight: 700; line-height: 1.5; }
.ev-tag { font-size: 20rpx; margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 99rpx; background: rgba(200,160,60,.2); font-weight: 400; }
.ev-end { background: rgba(120,120,120,.2); }
.ev-d { font-size: 26rpx; line-height: 1.75; margin: 8rpx 0; }
.ev-l { display: flex; gap: 16rpx; font-size: 24rpx; line-height: 1.6; margin-top: 4rpx; }
.ev-k { width: 112rpx; flex: none; color: var(--muted); }
.ev-v { flex: 1; }
.ev-slots { margin-top: 16rpx; padding-top: 12rpx; border-top: 2rpx dashed var(--line-soft); }
.ev-sl { display: block; font-size: 22rpx; color: var(--muted); margin-bottom: 8rpx; }
.ev-slot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 8rpx 0; }
.ev-sw { flex: 1; min-width: 0; }
.ev-sb { display: block; font-size: 26rpx; font-weight: 700; }
.ev-sp { display: block; font-size: 22rpx; color: var(--muted); }
.ev-sd { font-size: 22rpx; color: var(--muted); }
.ev-add { flex: none; border: 2rpx solid var(--accent); color: var(--accent); border-radius: 99rpx; padding: 10rpx 24rpx; font-size: 24rpx; font-weight: 700; }
.ev-add.on { background: var(--accent); color: #fff; }
