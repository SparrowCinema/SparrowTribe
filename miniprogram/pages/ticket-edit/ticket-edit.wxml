<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view wx:if="{{ok}}" class="wrap te-page">
  <view class="te-stage">
    <view id="te-card" class="te-card3d {{snap?'te-snap':''}}" style="transform:perspective(900px) rotateX({{rx}}deg) rotateY({{ry}}deg)"
      bindtap="flip" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"
      aria-role="button" aria-label="{{L.t(i,'翻面')}}">
      <image wx:if="{{front?frontImg:backImg}}" class="te-face" src="{{front?frontImg:backImg}}" mode="widthFix" />
      <view wx:else class="te-face te-wait"><text>{{L.t(i,'票根绘制中…')}}</text></view>
      <view wx:if="{{front?frontImg:backImg}}" class="te-glow" style="background:{{glowBg}}"></view>
    </view>
    <view wx:if="{{arts.length}}" class="te-art">
      <text class="te-art-k">{{L.t(i,'裁切')}}</text>
      <slider class="te-slider" min="0" max="100" value="{{draft.crop}}" block-size="18" activeColor="#8e2a22" backgroundColor="#e6dcc7" bindchanging="changeField" bindchange="changeField" data-field="crop" />
      <picker wx:if="{{arts.length>1}}" mode="selector" range="{{arts}}" value="{{artIndex}}" bindchange="chooseArt"><view class="te-art-pick">{{arts[artIndex]}} ›</view></picker>
      <view class="te-art-save {{artDirty?'':'off'}}" hover-class="{{artDirty?'te-hv':'none'}}" bindtap="saveHere" role="button" aria-disabled="{{!artDirty}}">{{L.t(i,'保存')}}</view>
    </view>
    <view class="te-tools">
      <view class="te-seg" role="tablist">
        <view class="{{front?'on':''}}" data-side="front" bindtap="setSide" role="tab" aria-selected="{{front}}">{{L.t(i,'正面')}}</view>
        <view class="{{front?'':'on'}}" data-side="back" bindtap="setSide" role="tab" aria-selected="{{!front}}">{{L.t(i,'背面')}}</view>
      </view>
      <view class="te-dice {{busy?'te-off':''}}" hover-class="te-hv" bindtap="shuffle" role="button">{{L.t(i,'随机换一款')}}</view>
    </view>
    <text class="te-reset" bindtap="reset" role="button">{{L.t(i,'恢复专题默认款式')}}</text>
  </view>

  <view class="te-title"><text class="te-name">{{draft.title}}</text><text wx:if="{{draft.programme}}" class="te-sub">{{draft.programme}}</text></view>

  <view class="te-sec">{{L.t(i,'放映信息')}}</view>
  <view class="te-card">
    <picker wx:if="{{shows.length}}" mode="selector" range="{{shows}}" value="{{showIdx<0?0:showIdx}}" bindchange="chooseShow"><view class="te-row te-first"><text class="te-k">{{L.t(i,'场次')}}</text><view class="te-v"><text class="{{showIdx<0?'te-ph':''}}">{{showIdx<0?L.t(i,'选择场次'):shows[showIdx]}}</text><text class="te-go">›</text></view></view></picker>
    <view wx:if="{{linked}}" class="te-row {{shows.length?'':'te-first'}}"><text class="te-k">{{L.t(i,'观影日期')}}</text><view class="te-v"><text class="te-mono">{{draft.date}}</text><text class="te-note">{{L.t(i,'来自观影记录')}}</text></view></view>
    <picker wx:else mode="date" value="{{draft.date}}" data-field="date" bindchange="changeField"><view class="te-row {{shows.length?'':'te-first'}}"><text class="te-k">{{L.t(i,'观影日期')}}</text><view class="te-v"><text class="te-mono">{{draft.date || L.t(i,'选择日期')}}</text><text class="te-go">›</text></view></view></picker>
    <picker mode="time" value="{{draft.time}}" data-field="time" bindchange="changeField"><view class="te-row"><text class="te-k">{{L.t(i,'开场时间')}}</text><view class="te-v"><text class="te-mono {{draft.time?'':'te-ph'}}">{{draft.time || L.t(i,'选择时间')}}</text><text class="te-go">›</text></view></view></picker>
    <view class="te-row"><text class="te-k">{{L.t(i,'影院')}}</text><input class="te-in" value="{{draft.venue}}" placeholder="{{L.t(i,'影院名称')}}" placeholder-class="te-ph" data-field="venue" bindinput="changeField" /></view>
    <view class="te-row"><text class="te-k">{{L.t(i,'影厅')}}</text><input class="te-in" value="{{draft.hall}}" placeholder="{{L.t(i,'如 1号厅')}}" placeholder-class="te-ph" data-field="hall" bindinput="changeField" /></view>
    <view class="te-row"><text class="te-k">{{L.t(i,'座位')}}</text><input class="te-in" value="{{draft.seat}}" placeholder="{{L.t(i,'选填，如 5排8座')}}" placeholder-class="te-ph" data-field="seat" bindinput="changeField" /></view>
    <view class="te-row"><text class="te-k">{{L.t(i,'放映版本')}}</text><input class="te-in" value="{{draft.format}}" placeholder="{{L.t(i,'如 4K修复')}}" placeholder-class="te-ph" data-field="format" bindinput="changeField" /></view>
  </view>

  <view class="te-acts">
    <view class="te-save" hover-class="te-hv" bindtap="store" role="button">{{L.t(i,existing?'保存修改':'加入收藏册')}}</view>
    <view class="te-links">
      <text class="te-link {{loading?'te-off':''}}" bindtap="exportSingle" role="button">{{L.t(i,'导出这张票根')}}</text>
      <block wx:if="{{existing}}"><text class="te-dot">·</text><text class="te-link te-danger" bindtap="remove" role="button">{{L.t(i,'移出收藏册')}}</text></block>
    </view>
  </view>
</view>
<canvas type="2d" id="te-worker" class="te-hidden" />
<canvas type="2d" id="te-export" class="te-hidden" />
