<page-meta page-style="{{ps}}" />
<wxs src="../../utils/l.wxs" module="L" />
<view class="wrap">
  <view wx:if="{{bad}}" class="empty">
    <text class="et">{{L.t(i,'这份排片已无法读取')}}</text>
    <text class="muted">{{L.t(i,'其中的场次可能已经更新。')}}</text>
    <view class="btn" bindtap="home">{{L.t(i,'进入首页看排片')}}</view>
  </view>
  <block wx:elif="{{mode === 'group' && grp}}">
    <view class="grp-members">
      <text class="grp-mlab">{{L.t(i,'已加入接龙')}} ({{grp.n}}/{{grp.max}})</text>
      <view class="grp-chips">
        <view wx:for="{{grp.members}}" wx:key="idx" class="grp-chip">
          <text class="grp-cn">{{item.n}}</text>
          <text class="grp-cs mono">{{item.sub}}</text>
          <text wx:if="{{grp.n > 1}}" class="grp-rm" data-idx="{{item.idx}}" bindtap="removeMember">×</text>
        </view>
      </view>
    </view>
    <view class="card grp-join">
      <view class="grp-jrow">
        <input class="grp-inp" maxlength="16" value="{{nick}}" placeholder="{{L.t(i,'输入你的昵称（如：阿明）')}}" bindinput="nickInput" />
        <view class="btn light grp-jbtn" bindtap="joinGroup">{{grp.alreadyIn ? L.t(i,'更新我的排片') : L.t(i,'加入接龙')}}</view>
      </view>
      <view class="grp-chk" bindtap="toggleWithWant">
        <text class="grp-box {{withWant ? 'on' : ''}}">{{withWant ? '✓' : ''}}</text>
        <text class="grp-cl">{{L.t(i,'同时带上我的想看清单（推荐共同想看的无冲突场次）')}}</text>
      </view>
      <view class="grp-share-row">
        <button class="btn light grp-sh" open-type="share">{{L.t(i,'转发接龙给下一位朋友')}}</button>
        <view class="btn ghost grp-cp" bindtap="copyWebRelay">{{L.t(i,'复制网页链接')}}</view>
      </view>
    </view>
    <view wx:if="{{grp.n < 2}}" class="ov card">
      <text class="ov-k mono">GROUP RELAY</text>
      <text class="ov-none">{{L.t(i,'把接龙转发给朋友，凑齐 2–8 人自动合并排片')}}</text>
      <text class="ov-p">{{L.t(i,'朋友点开后填昵称点「加入接龙」再转发给下一位，自动列出全员同场、一起看建议与共同想看。')}}</text>
    </view>
    <view wx:else class="ov card">
      <text class="ov-k mono">GROUP PLAN MATCH</text>
      <view class="grp-kpis">
        <view><text class="kn mono">{{grp.n}}</text><text class="kl">{{L.t(i,'位朋友')}}</text></view>
        <view><text class="kn mono">{{grp.stats.allTogetherCount}}</text><text class="kl">{{L.t(i,'全员同场')}}</text></view>
        <view><text class="kn mono">{{grp.stats.suggestCount}}</text><text class="kl">{{L.t(i,'一起看建议')}}</text></view>
        <view><text class="kn mono">{{grp.stats.sharedWantCount}}</text><text class="kl">{{L.t(i,'共同想看')}}</text></view>
      </view>
      <view wx:for="{{grp.secs}}" wx:for-item="sec" wx:key="k" class="ov-sec">
        <text class="ov-h">{{sec.title}}</text>
        <view wx:for="{{sec.rows}}" wx:key="key" class="ov-row">
          <view class="ov-t mono"><text class="ov-d">{{item.d}}</text><text class="ov-tm">{{item.t}}</text></view>
          <view class="ov-i" data-id="{{item.id}}" bindtap="open">
            <text class="ov-f">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></text>
            <text class="ov-pl">{{item.place}}</text>
            <view class="grp-tags"><text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="tx" class="grp-tag {{tg.c}}">{{tg.tx}}</text></view>
          </view>
          <view wx:if="{{item.add}}" class="ov-add {{item.on ? 'on' : ''}}" data-key="{{item.key}}" catchtap="addOne">{{item.on ? '✓' : '+'}}</view>
        </view>
      </view>
      <view wx:if="{{grp.wantRows.length}}" class="ov-sec">
        <text class="ov-h">{{L.t(i,'共同想看片单')}}</text>
        <view wx:for="{{grp.wantRows}}" wx:key="id" class="ov-row">
          <view class="ov-i" data-id="{{item.id}}" bindtap="open">
            <text class="ov-f">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></text>
            <view class="grp-tags">
              <text class="grp-tag want">{{item.who}}</text>
              <text class="grp-tag {{item.allFree ? 'all' : 'free'}}">{{item.slotTxt}}</text>
            </view>
          </view>
          <view wx:if="{{item.bestKey}}" class="ov-add {{item.on ? 'on' : ''}}" data-key="{{item.bestKey}}" catchtap="addOne">{{item.on ? '✓' : '+'}}</view>
        </view>
      </view>
      <text wx:if="{{!grp.secs.length && !grp.wantRows.length}}" class="ov-p">{{L.t(i,'大家暂时没有重叠或可凑场的待映场次，可以先在片目里多标几部「想看」再更新接龙。')}}</text>
    </view>
  </block>
  <block wx:else>
    <view class="banner">
      <text class="bt">{{cnt}}</text>
      <text class="bs">{{L.t(i,'这是朋友分享给你的观影日程，加入后会和你自己的排片合并。')}}</text>
      <view class="acts">
        <view class="btn light" bindtap="importAll">{{L.t(i,'全部加入我的排片')}}</view>
        <view class="btn outline" bindtap="home">{{L.t(i,'进入首页')}}</view>
      </view>
    </view>
    <view class="ov card">
      <text class="ov-k mono">PLAN MATCH</text>
      <block wx:if="{{ov.empty}}">
        <text class="ov-none">{{L.t(i,'和 TA 对一对排片')}}</text>
        <text class="ov-p">{{L.t(i,'先加入你自己想看的场次，这里就会显示你们哪几场在一起、哪几场时间冲突。')}}</text>
        <text class="ov-link" bindtap="pick">{{L.t(i,'去选场次 ›')}}</text>
      </block>
      <block wx:else>
        <view wx:if="{{ov.same}}" class="ov-big"><text class="ov-n mono">{{ov.same}}</text><text class="ov-u">{{L.t(i,'场同场')}}</text></view>
        <text wx:else class="ov-none">{{L.t(i,'你们还没有同一场的电影')}}</text>
        <view wx:if="{{ov.facts.length}}" class="ov-facts"><text wx:for="{{ov.facts}}" wx:key="*this" class="ov-fact">{{item}}</text></view>
        <view wx:for="{{ov.secs}}" wx:for-item="sec" wx:key="k" class="ov-sec">
          <text class="ov-h">{{sec.title}}</text>
          <view wx:for="{{sec.rows}}" wx:key="key" class="ov-row">
            <view class="ov-t mono"><text class="ov-d">{{item.d}}</text><text class="ov-tm">{{item.t}}</text></view>
            <view class="ov-i" data-id="{{item.id}}" bindtap="open">
              <text class="ov-f">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></text>
              <text class="ov-pl">{{item.place}}</text>
              <text wx:if="{{item.extra}}" class="ov-x {{sec.bad ? 'bad' : ''}}">{{item.extra}}</text>
            </view>
            <view wx:if="{{sec.add}}" class="ov-add {{item.on ? 'on' : ''}}" data-key="{{item.key}}" catchtap="addOne">{{item.on ? '✓' : '+'}}</view>
          </view>
        </view>
        <text class="ov-link" bindtap="upgradeGroup">{{L.t(i,'拉更多人一起凑场 ›')}}</text>
      </block>
      <text wx:if="{{ov.miss}}" class="ov-p">{{ov.miss}}</text>
    </view>
    <text class="ov-all">{{L.t(i,'TA 的全部场次')}}</text>
    <view wx:for="{{items}}" wx:key="key" class="row" data-id="{{item.id}}" bindtap="open">
      <view class="tm mono"><text class="d">{{item.y}}/{{item.d}} {{item.wk}}</text><text class="b">{{item.t}}</text></view>
      <image wx:if="{{item.poster}}" class="th" src="{{item.poster}}" mode="aspectFill" />
      <view class="info">
        <view class="t">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></view>
        <text class="v">{{item.venue}} · {{item.hall}} · {{i.__en ? 'ends' : '散场'}} {{item.end}}</text>
      </view>
    </view>
  </block>
</view>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>
