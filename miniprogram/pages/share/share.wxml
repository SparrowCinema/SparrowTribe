<wxs src="../../utils/l.wxs" module="L" />
<view class="wrap">
  <view wx:if="{{bad}}" class="empty">
    <text class="et">{{L.t(i,'这份排片已无法读取')}}</text>
    <text class="muted">{{L.t(i,'其中的场次可能已经更新。')}}</text>
    <view class="btn" bindtap="home">{{L.t(i,'进入首页看排片')}}</view>
  </view>
  <block wx:else>
    <view class="banner">
      <text class="bt">{{cnt}}</text>
      <text class="bs">{{L.t(i,'这是朋友分享给你的观影日程，加入后会和你自己的排片合并。')}}</text>
      <view class="acts">
        <view class="btn light" bindtap="importAll">{{L.t(i,'全部加入我的排片')}}</view>
        <view class="btn outline" bindtap="home">{{L.t(i,'进入首页')}}</view>
      </view>
    </view>
    <view wx:for="{{items}}" wx:key="key" class="row" data-id="{{item.id}}" bindtap="open">
      <view class="tm mono"><text class="d">{{item.d}} {{item.wk}}</text><text class="b">{{item.t}}</text></view>
      <image wx:if="{{item.poster}}" class="th" src="{{item.poster}}" mode="aspectFill" />
      <view class="info">
        <view class="t">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></view>
        <text class="v">{{item.venue}} · {{item.hall}} · {{i.__en ? 'ends' : '散场'}} {{item.end}}</text>
      </view>
    </view>
  </block>
</view>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>
