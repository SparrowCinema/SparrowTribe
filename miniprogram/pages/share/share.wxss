.banner { margin-top: calc(32 * var(--r)); padding: calc(32 * var(--r)); border-radius: calc(24 * var(--r)); background: var(--fg); color: var(--bg); display: flex; flex-direction: column; gap: calc(8 * var(--r)); }
.bt { font-size: calc(25.3 * var(--r)); font-weight: 900; }
.bs { font-size: calc(20.0 * var(--r)); opacity: .8; }
.acts { display: flex; gap: calc(16 * var(--r)); margin-top: calc(16 * var(--r)); }
.btn.light { background: var(--accent); color: #fffaf0; }
.btn.outline { background: transparent; color: var(--bg); border: calc(2 * var(--r)) solid rgba(239,230,212,.5); }
.row { display: flex; align-items: center; gap: calc(20 * var(--r)); padding: calc(22 * var(--r)) 0; border-bottom: calc(2 * var(--r)) solid var(--line-soft); }
.tm { flex: none; width: calc(150 * var(--r)); display: flex; flex-direction: column; }
.tm .d { font-size: calc(18 * var(--r)); color: var(--muted); }
.tm .b { font-size: calc(24.1 * var(--r)); font-weight: 700; }
.th { flex: none; width: calc(80 * var(--r)); height: calc(120 * var(--r)); border-radius: calc(8 * var(--r)); }
.info { flex: 1; min-width: 0; }
.t { font-size: calc(21.9 * var(--r)); font-weight: 700; }
.v { font-size: calc(18.7 * var(--r)); color: var(--teal); }
.empty { display: flex; flex-direction: column; align-items: center; gap: calc(16 * var(--r)); padding: calc(120 * var(--r)) 0; }
.et { font-size: calc(24.1 * var(--r)); font-weight: 700; }
