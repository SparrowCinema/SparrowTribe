.banner { margin-top: calc(32 * var(--r)); padding: calc(32 * var(--r)); border-radius: calc(24 * var(--r)); background: var(--fg); color: var(--bg); display: flex; flex-direction: column; gap: calc(8 * var(--r)); }
.bt { font-size: calc(22.3 * var(--fr)); font-weight: 900; }
.bs { font-size: calc(17.6 * var(--fr)); opacity: .8; }
.acts { display: flex; gap: calc(16 * var(--r)); margin-top: calc(16 * var(--r)); }
.btn.light { background: var(--accent); color: #fffaf0; }
.btn.outline { background: transparent; color: var(--bg); border: calc(2 * var(--r)) solid rgba(239,230,212,.5); }
.row { display: flex; align-items: center; gap: calc(20 * var(--r)); padding: calc(22 * var(--r)) 0; border-bottom: calc(2 * var(--r)) solid var(--line-soft); }
.tm { flex: none; width: calc(150 * var(--r)); display: flex; flex-direction: column; }
.tm .d { font-size: calc(16 * var(--fr)); color: var(--muted); }
.tm .b { font-size: calc(21.2 * var(--fr)); font-weight: 700; }
.th { flex: none; width: calc(80 * var(--r)); height: calc(120 * var(--r)); border-radius: calc(8 * var(--r)); }
.info { flex: 1; min-width: 0; }
.t { font-size: calc(19.3 * var(--fr)); font-weight: 700; }
.v { font-size: calc(16.5 * var(--fr)); color: var(--teal); }
.empty { display: flex; flex-direction: column; align-items: center; gap: calc(16 * var(--r)); padding: calc(120 * var(--r)) 0; }
.et { font-size: calc(21.2 * var(--fr)); font-weight: 700; }
/* 对排片 */
.ov { margin-top: calc(28 * var(--r)); padding: calc(28 * var(--r)); display: flex; flex-direction: column; gap: calc(10 * var(--r)); }
.ov-k { font-size: calc(15 * var(--fr)); letter-spacing: .18em; color: var(--accent); }
.ov-big { display: flex; align-items: baseline; gap: calc(10 * var(--r)); }
.ov-n { font-size: calc(64 * var(--fr)); line-height: 1; font-weight: 700; color: var(--accent); }
.ov-u { font-size: calc(22 * var(--fr)); font-weight: 700; }
.ov-none { font-size: calc(22 * var(--fr)); font-weight: 700; }
.ov-p { font-size: calc(17 * var(--fr)); color: var(--muted); }
.ov-link { font-size: calc(18 * var(--fr)); color: var(--accent); }
.ov-facts { display: flex; flex-wrap: wrap; gap: calc(10 * var(--r)); }
.ov-fact { font-size: calc(16.5 * var(--fr)); padding: calc(6 * var(--r)) calc(16 * var(--r)); border-radius: 999px; border: 1px solid var(--line); background: var(--bg); }
.ov-sec { margin-top: calc(14 * var(--r)); }
.ov-h { display: block; font-size: calc(19 * var(--fr)); font-weight: 700; margin-bottom: calc(4 * var(--r)); }
.ov-row { display: flex; align-items: center; gap: calc(16 * var(--r)); padding: calc(16 * var(--r)) 0; border-top: 1px dashed var(--line); }
.ov-t { flex: none; width: calc(120 * var(--r)); display: flex; flex-direction: column; }
.ov-d { font-size: calc(15.5 * var(--fr)); color: var(--muted); }
.ov-tm { font-size: calc(21 * var(--fr)); font-weight: 700; }
.ov-i { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: calc(2 * var(--r)); }
.ov-f { font-size: calc(19 * var(--fr)); font-weight: 700; }
.ov-pl { font-size: calc(16 * var(--fr)); color: var(--teal); }
.ov-x { font-size: calc(16 * var(--fr)); }
.ov-x.bad { color: var(--bad-fg); }
.ov-add { flex: none; width: calc(56 * var(--r)); height: calc(56 * var(--r)); border-radius: 50%; border: calc(2 * var(--r)) solid var(--accent); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: calc(28 * var(--fr)); }
.ov-add.on { background: var(--accent); color: #fffaf0; }
.ov-all { display: block; margin-top: calc(32 * var(--r)); font-size: calc(19 * var(--fr)); font-weight: 700; }
/* 多人接龙 */
.grp-members { margin-top: calc(24 * var(--r)); }
.grp-mlab { display: block; font-size: calc(17 * var(--fr)); font-weight: 700; color: var(--muted); margin-bottom: calc(12 * var(--r)); }
.grp-chips { display: flex; flex-wrap: wrap; gap: calc(12 * var(--r)); }
.grp-chip { display: flex; align-items: center; gap: calc(10 * var(--r)); padding: calc(8 * var(--r)) calc(18 * var(--r)); border-radius: 999px; border: calc(1 * var(--r)) solid var(--line); background: var(--surface); }
.grp-cn { font-size: calc(18 * var(--fr)); font-weight: 700; }
.grp-cs { font-size: calc(15.5 * var(--fr)); color: var(--muted); }
.grp-rm { width: calc(32 * var(--r)); height: calc(32 * var(--r)); border-radius: 50%; background: var(--chip); color: var(--muted); text-align: center; line-height: calc(32 * var(--r)); font-size: calc(20 * var(--fr)); }
.grp-join { margin-top: calc(20 * var(--r)); padding: calc(24 * var(--r)); display: flex; flex-direction: column; gap: calc(16 * var(--r)); }
.grp-jrow { display: flex; gap: calc(12 * var(--r)); align-items: center; }
.grp-inp { flex: 1; height: calc(74 * var(--r)); padding: 0 calc(20 * var(--r)); border: calc(1 * var(--r)) solid var(--line); border-radius: calc(14 * var(--r)); background: var(--bg); font-size: calc(20 * var(--fr)); }
.grp-jbtn { flex: none; padding: 0 calc(26 * var(--r)); height: calc(74 * var(--r)); line-height: calc(74 * var(--r)); font-size: calc(18.5 * var(--fr)); }
.grp-chk { display: flex; align-items: center; gap: calc(12 * var(--r)); }
.grp-box { width: calc(30 * var(--r)); height: calc(30 * var(--r)); border-radius: calc(6 * var(--r)); border: calc(2 * var(--r)) solid var(--line); text-align: center; line-height: calc(28 * var(--r)); font-size: calc(18 * var(--fr)); color: #fffaf0; }
.grp-box.on { background: var(--accent); border-color: var(--accent); }
.grp-cl { font-size: calc(16.5 * var(--fr)); color: var(--muted); flex: 1; }
.grp-share-row { display: flex; gap: calc(12 * var(--r)); }
.grp-sh, .grp-cp { flex: 1; height: calc(76 * var(--r)); line-height: calc(74 * var(--r)); font-size: calc(18 * var(--fr)); padding: 0 calc(12 * var(--r)); }
.grp-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: calc(10 * var(--r)); margin: calc(12 * var(--r)) 0; text-align: center; }
.grp-kpis .kn { display: block; font-size: calc(30 * var(--fr)); font-weight: 700; color: var(--fg); }
.grp-kpis .kl { display: block; font-size: calc(15 * var(--fr)); color: var(--muted); }
.grp-tags { display: flex; flex-wrap: wrap; gap: calc(8 * var(--r)); margin-top: calc(8 * var(--r)); }
.grp-tag { font-size: calc(15 * var(--fr)); padding: calc(3 * var(--r)) calc(12 * var(--r)); border-radius: 999px; background: var(--chip); color: var(--muted); }
.grp-tag.all { background: rgba(142, 42, 34, .14); color: var(--accent); font-weight: 700; }
.grp-tag.maj { background: rgba(47, 111, 108, .14); color: var(--teal); font-weight: 700; }
.grp-tag.pick { background: rgba(232, 217, 170, .3); color: #8a6516; }
.grp-tag.want { background: rgba(47, 111, 108, .1); color: var(--teal); }
.grp-tag.clash { background: rgba(179, 38, 30, .12); color: var(--bad-fg); }
