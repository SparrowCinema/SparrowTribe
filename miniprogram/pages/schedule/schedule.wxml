<wxs src="../../utils/l.wxs" module="L" />
<view class="brandbar">
  <image class="sq" src="/images/brand/sparrow-movies-sq.png" mode="aspectFit" />
  <text class="x">×</text>
  <image class="sq" src="/images/brand/sparrow-tribe-sq.png" mode="aspectFit" />
  <view class="sp" />
  <view class="lang" hover-class="hv" bindtap="switchLang"><text class="{{en ? '' : 'on'}}">中</text><text class="{{en ? 'on' : ''}}">EN</text></view>
  <view class="tag"><text>{{L.t(i,'观影')}}\n{{L.t(i,'护照')}}</text></view>
</view>

<view class="wrap">
  <view wx:if="{{myToday.length}}" class="today card">
    <view class="today-h"><text class="b">{{todayHead}}</text><text class="muted small">{{myTodayTitle}}</text></view>
    <view class="tp-day"><text class="tp-d mono">{{myTodayDay}}</text><text class="tp-r mono">{{myToday.length}} {{L.t(i,'场')}} · {{myTodayRange}}</text></view>
    <view wx:for="{{myToday}}" wx:key="key" wx:if="{{todayOpen || index === 0}}" class="tp-item" data-id="{{item.id}}" bindtap="openFilm">
      <view class="tp-tm mono"><text class="b">{{item.t}}</text><text>{{item.end}}</text></view>
      <view class="tp-card" style="--c:{{item.color}}">
        <image wx:if="{{item.poster}}" class="tp-th" src="{{item.poster}}" mode="aspectFill" />
        <view class="tp-info">
          <view class="tp-t">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></view>
          <text class="tp-s">{{item.dir}} · {{item.minTxt}}</text>
          <text class="tp-v">{{item.venue}}<text class="htag">{{item.hall}}</text></text>
        </view>
      </view>
    </view>
    <view wx:if="{{myToday.length > 1}}" class="today-toggle {{todayOpen ? 'open' : ''}}" hover-class="hv" bindtap="toggleToday">
      <text class="tt-txt">{{todayToggle}}</text>
      <view class="tt-ic"><view class="tt-ar" /></view>
    </view>
  </view>
  <view class="h2">{{L.t(i,'排片表')}}</view>
  <view class="sub">{{span}} · {{L.n(i,count,'sc')}} · {{L.t(i,'按日期查看，点击色块看影片')}}</view>

  <view class="schedule-filterbar">
    <view class="schedule-filter" data-type="programme" bindtap="openSelector"><text class="filter-label">{{L.t(i,'专题')}}</text><view class="filter-value"><text>{{programmeName}}</text><text class="filter-arrow">⌄</text></view></view>
    <view class="schedule-filter" data-type="city" bindtap="openSelector"><text class="filter-label">{{L.t(i,'城市')}}</text><view class="filter-value"><text>{{cityName}}</text><text class="filter-arrow">⌄</text></view></view>
    <view class="schedule-filter" data-type="venue" bindtap="openSelector"><text class="filter-label">{{L.t(i,'影院')}}</text><view class="filter-value"><text>{{venueName}}</text><text class="filter-arrow">⌄</text></view></view>
  </view>
  <view wx:if="{{pf!=='all'||city!=='all'||vf!=='all'}}" class="filter-reset" bindtap="resetFilters">{{L.t(i,'重置筛选')}} ↺</view>

  <view wx:if="{{selectorType}}" class="selector-mask" catchtap="closeSelector" catchtouchmove="stopMove">
    <view class="selector-panel" catchtap="stopMove">
      <view class="selector-head"><text>{{selectorTitle}}</text><view class="selector-close" bindtap="closeSelector">×</view></view>
      <input class="selector-search" type="text" placeholder="{{selectorPlaceholder}}" value="{{selectorQuery}}" bindinput="searchSelector" />
      <scroll-view scroll-y class="selector-results">
        <view wx:for="{{selectorRows}}" wx:key="id" class="selector-option {{item.selected?'selected':''}}" data-id="{{item.id}}" bindtap="chooseFilter"><view class="selector-copy"><text class="b">{{item.name}}</text><text wx:if="{{item.sub}}" class="small muted">{{item.sub}}</text></view><text class="selector-check box {{item.selected?'on':''}}">{{item.selected?'✓':''}}</text></view>
        <view wx:if="{{!selectorRows.length}}" class="selector-empty">{{L.t(i,'没有匹配的结果')}}</view>
      </scroll-view><view class="selector-foot"><text>{{L.t(i,'可多选')}}</text><view class="selector-done" bindtap="closeSelector">{{L.t(i,'完成')}}</view></view>
    </view>
  </view>

  <view class="sched-tools">
    <view class="mine-only"><view class="mine-chip {{onlyMine?'on':''}}" hover-class="hv" bindtap="toggleMine"><view class="mc-i"><text>✓</text></view><text class="mc-t">{{L.t(i,'只看我的排片')}}</text><text class="mc-n mono">{{mineN}}</text></view></view>
    <view class="view-switch"><view class="{{view==='gantt'?'on':''}}" data-view="gantt" bindtap="setView" aria-role="button" aria-label="{{L.t(i,'时间轴')}}"><view class="grid-icon"><view/><view/><view/><view/></view></view><view class="{{view==='list'?'on':''}}" data-view="list" bindtap="setView" aria-role="button" aria-label="{{L.t(i,'清单')}}"><view class="list-icon"><view/><view/><view/></view></view></view>
  </view>

  <view wx:if="{{empty}}" class="g-empty card"><text class="b">{{empty}}</text><text class="muted small">{{onlyMine ? L.t(i,'关掉「只看我的排片」，在排片表点色块右上角的 + 加入') : L.t(i,'排片公布后会更新到这里')}}</text></view>

  <block wx:if="{{!empty}}">
    <!-- 日期条 -->
    <scroll-view scroll-x class="dstrip" enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollInto}}" scroll-with-animation>
      <view class="drow">
        <view wx:for="{{days}}" wx:key="d" id="d{{index}}" class="dchip {{day===item.d?'on':''}}" data-d="{{item.d}}" bindtap="setDay">
          <text class="dm mono">{{item.mon || ' '}}</text>
          <text class="dd mono">{{item.dd}}</text>
          <text class="dw">{{item.wk}}</text>
          <text class="dn">{{L.n(i,item.n,'sc')}}</text>
          <view wx:if="{{item.mine}}" class="dme" />
        </view>
      </view>
    </scroll-view>

    <view class="cap"><text class="ct">{{dayTitle}}</text><text class="cs">{{L.n(i,dayList.length,'sc')}} · {{L.n(i,hallCount,'h')}}</text></view>
    <view class="legend"><text>{{L.t(i,'每部影片一种颜色 · 色块标注版本、对白语言与字幕')}}</text></view>

    <!-- 单日时刻表：纵轴时间，横向影厅 -->
    <view wx:if="{{view==='gantt'}}" class="tt card">
      <view class="axis">
        <view class="th corner">{{L.t(i,'时间')}}</view>
        <view class="ticks" style="height:calc({{H}} * var(--r))">
          <text wx:for="{{ticks}}" wx:key="t" class="tick mono" style="top:calc({{item.y}} * var(--r))">{{item.t}}</text>
          <view wx:if="{{nowLine}}" class="nowlab mono" style="top:calc({{nowLine.top}} * var(--r))">{{nowLine.label}}</view>
        </view>
      </view>
      <scroll-view scroll-x class="cols-scroll" enhanced show-scrollbar="{{false}}">
        <view class="cols">
          <view wx:if="{{nowLine}}" class="nowline" style="top:calc({{92 + nowLine.top}} * var(--r))"><view class="nowdot" /></view>
          <view wx:for="{{cols}}" wx:for-item="col" wx:key="key" class="col {{cols.length===1?'solo':''}}">
            <view class="th"><text class="tv">{{col.vn}}</text><text class="thn">{{col.hn}}</text></view>
            <view class="body" style="height:calc({{H}} * var(--r))">
              <view wx:for="{{col.blocks}}" wx:key="key" class="blk {{item.picked?'mine':''}} {{item.past?'past':''}}" style="top:calc({{item.top}} * var(--r));height:calc({{item.h}} * var(--r));background:{{item.tone.bg}};color:{{item.tone.ink}};border:calc(2 * var(--r)) solid {{item.tone.line}};{{item.picked?'box-shadow:inset 0 0 0 calc(4 * var(--r)) '+item.tone.ink:''}}" data-id="{{item.id}}" bindtap="openFilm">
                <view class="bhd"><text class="bs mono">{{item.t}}</text><text wx:if="{{item.ev}}" class="bev">{{L.t(i,'映后')}}</text></view>
                <text class="bn">{{item.cn}}</text>
                <text wx:if="{{item.version}}" class="bv mono">{{item.version}}</text>
                <text wx:if="{{item.langSub}}" class="bl">{{item.langSub}}</text>
                <text class="be mono">{{item.past ? L.t(i,'已放映') : L.t(i,'至') + ' ' + item.end + ' · ' + item.min + '′'}}</text>
                <view wx:if="{{!item.past||item.picked}}" class="badd {{item.picked?'on':''}}" style="{{item.picked?'background:'+item.tone.ink+';color:'+item.tone.bg+';border-color:'+item.tone.ink:'background:'+item.tone.bg+';color:'+item.tone.ink+';border-color:'+item.tone.ink}}" data-key="{{item.key}}" catchtap="toggle" aria-role="button" aria-label="{{item.picked ? L.t(i,'移出排片') : L.t(i,'加入排片')}}">{{item.picked?'✓':'+'}}</view>
              </view>
              <view wx:for="{{col.qas}}" wx:for-item="qa" wx:key="key" class="qa" style="top:calc({{qa.top}} * var(--r));height:calc({{qa.h}} * var(--r))" data-id="{{qa.id}}" bindtap="openFilm"><text class="qa-b">{{L.t(i,qa.nm)}}</text><text class="qa-t mono">{{qa.label}}</text></view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <block wx:if="{{view==='list'}}">
      <view class="cinema-list" wx:for="{{venueGroups}}" wx:for-item="v" wx:key="id"><view class="cl-venue">{{v.name}}</view><view wx:for="{{v.halls}}" wx:for-item="h" wx:key="id" class="hall-list"><view class="cl-hall-label">{{h.name}}</view><view wx:for="{{h.rows}}" wx:key="key" class="agenda-row"><view class="agenda-film" data-id="{{item.id}}" bindtap="openFilm"><text class="agenda-time mono">{{item.t}}</text><view class="agenda-bar" style="background:{{item.tone.bar}}"/><view class="agenda-title"><text class="b">{{item.cn}}<text wx:if="{{item.version}}" class="ed">{{item.version}}</text></text><text class="small">{{!item.mpa?item.dir+' · ':''}}{{item.minTxt}}{{item.ev?' · '+L.t(i,'主创映后'):''}}</text></view><text wx:if="{{item.mpa}}" class="mpa">{{item.mpa}}</text></view><view class="agenda-pick {{item.picked?'on':''}}" data-key="{{item.key}}" catchtap="toggle">{{item.picked?L.t(i,'✓ 已加入'):L.t(i,'+ 加入排片')}}</view></view></view></view>
    </block>
  </block>

  <view class="makers">
    <text class="k">{{L.t(i, '制作设计 · PRODUCED ' + '&' + ' DESIGNED BY')}}</text>
    <view class="row">
      <image src="/images/brand/sparrow-movies-sq.png" mode="aspectFit" />
      <text class="x">×</text>
      <image src="/images/brand/sparrow-tribe-sq.png" mode="aspectFit" />
    </view>
    <text class="d">{{L.t(i,'电影放映与策展')}}</text>
  </view>
</view>
<view class="to-top {{topOn ? 'show' : ''}}" hover-class="to-top-hv" bindtap="toTop"><view class="tt-arr" /></view>
