.brandbar { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 32rpx; background: var(--surface); border-bottom: 2rpx solid var(--line); }
.brandbar .sq { width: 76rpx; height: 76rpx; }
.brandbar .x { color: var(--muted); font-size: 24rpx; }
.brandbar .sp { flex: 1; }
.brandbar .tag { font-size: 20rpx; letter-spacing: 6rpx; color: var(--muted); text-align: right; padding-left: 20rpx; border-left: 2rpx solid var(--line); line-height: 1.3; }
.prog { position: relative; overflow: hidden; margin-bottom: 20rpx; }
.prog .cover { width: 100%; height: 250rpx; display: block; }
.pbody { display: flex; flex-direction: column; padding: 20rpx 28rpx 24rpx; }
.pk { font-size: 18rpx; letter-spacing: 3rpx; color: var(--accent); }
.pn { font-size: 40rpx; font-weight: 900; }
.ps { font-size: 22rpx; color: var(--muted); }
.go { position: absolute; right: 24rpx; bottom: 26rpx; font-size: 22rpx; font-weight: 700; color: var(--accent); }
.chips-scroll { margin-top: 12rpx; white-space: nowrap; }
.legend { display: flex; flex-wrap: wrap; gap: 8rpx 28rpx; font-size: 22rpx; color: var(--muted); margin: 8rpx 0 18rpx; }
.lg { display: flex; align-items: center; }
.dot { width: 18rpx; height: 18rpx; border-radius: 4rpx; margin-right: 8rpx; }
.gantt { display: flex; overflow: hidden; }
.labels { flex: none; width: 116rpx; border-right: 2rpx solid var(--line); background: var(--surface); z-index: 2; }
.corner { height: 56rpx; font-size: 18rpx; color: var(--muted); padding: 22rpx 0 0 16rpx; box-sizing: border-box; border-bottom: 2rpx solid var(--line); }
.lab { height: 132rpx; display: flex; flex-direction: column; justify-content: center; padding-left: 18rpx; border-bottom: 2rpx solid var(--line-soft); box-sizing: border-box; }
.ld { font-size: 28rpx; font-weight: 700; }
.lw { font-size: 20rpx; color: var(--muted); }
.lp { font-size: 16rpx; color: var(--accent); line-height: 1.2; }
.track-scroll { flex: 1; min-width: 0; white-space: nowrap; }
.ruler { position: relative; height: 56rpx; border-bottom: 2rpx solid var(--line); }
.tick { position: absolute; top: 14rpx; font-size: 20rpx; color: var(--muted); transform: translateX(-50%); }
.track { position: relative; height: 132rpx; border-bottom: 2rpx solid var(--line-soft); box-sizing: border-box;
  background-image: repeating-linear-gradient(to right, var(--line-soft) 0 2rpx, transparent 2rpx 60rpx), repeating-linear-gradient(to right, var(--line) 0 2rpx, transparent 2rpx 120rpx); }
.blk { position: absolute; top: 0; bottom: 0; box-sizing: border-box; padding: 12rpx 14rpx; display: flex; flex-direction: column; justify-content: space-between; color: #fffaf0; overflow: hidden; border-left: 2rpx solid var(--surface); border-right: 2rpx solid var(--surface); white-space: normal; }
.bt { font-size: 24rpx; font-weight: 700; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.bm { font-size: 17rpx; opacity: .9; white-space: nowrap; }
.star { position: absolute; top: 8rpx; right: 10rpx; font-size: 18rpx; background: rgba(255,250,240,.9); color: var(--accent); border-radius: 50%; width: 28rpx; height: 28rpx; line-height: 28rpx; text-align: center; font-weight: 700; }
.hint { font-size: 20rpx; color: var(--muted); text-align: center; margin-top: 12rpx; }
.day { margin-bottom: 28rpx; }
.dh { font-size: 22rpx; letter-spacing: 4rpx; color: var(--muted); margin-bottom: 4rpx; }
.ag { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--line-soft); }
.agl { flex: 1; min-width: 0; display: flex; align-items: center; gap: 18rpx; }
.at { width: 92rpx; font-weight: 700; font-size: 28rpx; }
.bar { width: 8rpx; align-self: stretch; border-radius: 4rpx; }
.an { flex: 1; min-width: 0; }
.ann { font-size: 30rpx; font-weight: 700; }
.ans { font-size: 22rpx; color: var(--muted); }
.add { flex: none; font-size: 22rpx; padding: 12rpx 18rpx; border-radius: 14rpx; border: 2rpx solid var(--line); color: var(--accent); background: var(--surface); }
.add.on { background: var(--accent); color: #fffaf0; border-color: var(--accent); }
